---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand reveal" data-i="0">
        <a href="/" class="logo">
          <img
            class="logo-mark"
            src="/brand/logo-mark.svg"
            width="50"
            height="50"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <span class="logo-text">
            <strong>Transport Carcassonne</strong>
            <small>Déménagement &amp; transport</small>
          </span>
        </a>
        <p>
          Déménagement et transport à Carcassonne et dans l'Aude. Entreprise
          identifiée sous le SIRET {SITE.siret}.
        </p>
        <p class="sister-site">
          Besoin d'un débarras ou d'un vide maison&nbsp;? Consulter le site
          <a href="https://debarras-carcassonne.fr/" rel="noopener">
            Débarras Carcassonne
          </a>
          pour étudier cette prestation séparément.
        </p>
      </div>

      <div class="reveal" data-i="1">
        <p class="footer-title">Services</p>
        <ul>
          <li><a href="/petit-demenagement/">Petit déménagement</a></li>
          <li><a href="/transport-urgent-carcassonne/">Transport express aujourd’hui / demain</a></li>
          <li><a href="/livraison-meubles-magasins-carcassonne/">Livraison de meubles depuis un magasin</a></li>
          {SERVICES.map(s => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
          <li><a href="/demenagement-entreprise-carcassonne/">Déménagement d’entreprise</a></li>
          <li><a href="/demenagement-senior-carcassonne/">Déménagement senior</a></li>
          <li><a href="/emballage-cartons-carcassonne/">Emballage et cartons</a></li>
          <li><a href="/formules/">Nos formules</a></li>
          <li><a href="/tarifs/">Nos tarifs</a></li>
        </ul>
      </div>

      <div class="reveal" data-i="2">
        <p class="footer-title">Zone</p>
        <ul>
          {CITIES.slice(0, 6).map(c => (
            <li><a href={`/demenagement-${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="reveal" data-i="3">
        <p class="footer-title">Ressources</p>
        <ul>
          <li><a href="/outils-demenagement/">Tous les outils</a></li>
          <li><a href="/calculateur-volume-demenagement/">Calculateur de volume</a></li>
          <li><a href="/calculateur-cartons-demenagement/">Calculateur de cartons</a></li>
          <li><a href="/checklist-demenagement/">Checklist interactive</a></li>
          <li><a href="/trajets-groupes/">Trajets groupés</a></li>
          <li><a href="/realisations/">Réalisations</a></li>
          <li><a href="/nos-garanties/">Nos garanties</a></li>
          <li><a href="/blog/">Conseils déménagement</a></li>
        </ul>
      </div>

      <div class="reveal" data-i="4">
        <p class="footer-title">Contact</p>
        <ul>
          <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li>
            <a
              href={`https://wa.me/${SITE.phoneWhatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
            >WhatsApp</a>
          </li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>{SITE.hours}</li>
          <li>{SITE.hq.streetAddress}, {SITE.hq.postalCode} {SITE.hq.city}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© {new Date().getFullYear()} {SITE.name} · SIRET {SITE.siret}</div>
      <div class="footer-legal">
        <a href="/paiement-securise/">Paiement sécurisé</a>
        <span>·</span>
        <a href="/mentions-legales/">Mentions légales</a>
        <span>·</span>
        <a href="/politique-confidentialite/">Politique de confidentialité</a>
        <span>·</span>
        <button type="button" class="footer-cookie" onclick="window.__ccManage&&window.__ccManage()">Gérer les cookies</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    padding: 64px 0 32px;
    border-top: 1px solid var(--line-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 42px;
    margin-bottom: 60px;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .footer-brand .logo-mark {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    display: block;
  }

  .footer-brand .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-brand .logo-text strong {
    font-weight: 500;
    font-size: 16px;
  }

  .footer-brand .logo-text small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .footer-brand p {
    color: var(--text-on-dark-muted);
    font-size: 14px;
    line-height: 1.65;
    max-width: 340px;
  }

  .footer-brand .sister-site {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
  }

  .footer-brand .sister-site a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-brand .sister-site a:hover {
    color: var(--text-on-dark);
  }

  .footer-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 22px;
    font-weight: 500;
  }

  ul {
    list-style: none;
  }

  li {
    margin-bottom: 11px;
  }

  a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--line-dark);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--text-on-dark-muted);
    font-size: 13px;
  }

  .footer-bottom a {
    color: var(--text-on-dark-muted);
  }

  .footer-legal {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-cookie {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 13px;
    color: var(--text-on-dark-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-cookie:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
