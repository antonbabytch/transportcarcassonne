---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DeliveryHero from '../components/DeliveryHero.astro';
import RoadDivider from '../components/RoadDivider.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ComboOffer from '../components/ComboOffer.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';

const title = 'Déménagement Carcassonne | Transport Carcassonne — Devis Gratuit';
const description = `Déménageur professionnel à Carcassonne et dans l'Aude. Déménagement local, longue distance, transport piano, évacuation déchets. 2 fourgons jusqu'à 20 m³. Devis gratuit sous 2h. ${SITE.phoneDisplay}`;

const stats = [
  { value: '2', sup: '', label: 'Fourgons 12 & 20 m³' },
  { value: '48', sup: 'h', label: 'Intervention possible' },
  { value: '2', sup: 'h', label: 'Réponse à votre devis' },
  { value: '6', sup: 'j/7', label: 'Lun–Sam · 8h–19h' },
];

const garanties = [
  { num: '01', title: 'Matériel professionnel', desc: 'Hayon élévateur, sangles, couvertures et housses : vos meubles protégés et calés à chaque trajet.' },
  { num: '02', title: 'Devis fixe écrit', desc: 'Le prix annoncé sur le devis est le prix final. Aucun frais le jour J, aucune mauvaise surprise.' },
  { num: '03', title: 'Facture & SIRET', desc: `Entreprise déclarée SIRET ${SITE.siret}. Facture conforme remise à chaque intervention.` },
  { num: '04', title: 'Ponctualité garantie', desc: "Nous arrivons à l'heure convenue. Plus de 30 min de retard : vous bénéficiez d'une remise." },
  { num: '05', title: 'Équipe formée', desc: 'Déménageurs expérimentés, formés à la manutention, au démontage et à la protection des meubles fragiles.' },
  { num: '06', title: 'Geste écologique', desc: 'Optimisation des trajets, mutualisation des transports, cartons réutilisables sur demande.' },
];

const fourgons = [
  { name: 'Fourgon 12 m³', desc: 'Idéal pour studios, T1, T2 et petits déménagements. Hayon élévateur.', cap: '12 m³', payload: '1 200 kg' },
  { name: 'Fourgon 20 m³', desc: 'Pour T3, T4 et maisons familiales. Hayon élévateur, sangles intégrées.', cap: '20 m³', payload: '1 800 kg' },
];

const steps = [
  { num: '01', title: 'Demandez un devis', desc: 'Remplissez le formulaire ou appelez-nous. Devis sous 2h, gratuit et sans engagement.' },
  { num: '02', title: 'Visite ou inventaire', desc: 'Nous évaluons le volume à transporter pour vous proposer le meilleur tarif.' },
  { num: '03', title: 'Jour du déménagement', desc: "Notre équipe arrive à l'heure, emballe si besoin et charge avec soin." },
  { num: '04', title: 'Livraison & installation', desc: 'Livraison à l\'adresse convenue, remontage des meubles si souhaité.' },
];

const testimonials = [
  { name: 'Marie L.', city: 'Carcassonne', text: 'Équipe professionnelle, ponctuelle et très soigneuse avec nos affaires. Je recommande sans hésiter !' },
  { name: 'Thomas R.', city: 'Limoux', text: 'Déménagement de Limoux vers Toulouse impeccable. Prix correct, aucun dommage, personnel sympathique.' },
  { name: 'Sophie M.', city: 'Narbonne', text: "Transport de piano réalisé avec expertise. L'instrument est arrivé en parfait état. Merci !" },
];

const faqs = [
  { q: 'Combien coûte un déménagement à Carcassonne ?', a: 'Un déménagement local (≤ 50 km) commence à 450 € pour un studio et 650 € pour un T2. Le prix exact dépend du volume, de l\'étage et des options choisies. Devis gratuit sous 2h.' },
  { q: 'Intervenez-vous hors de Carcassonne ?', a: `Oui, nous intervenons dans un rayon de ${SITE.serviceRadius} km autour de Carcassonne : Limoux, Castelnaudary, Lézignan-Corbières, Narbonne, Trèbes, Bram et environs. Nous réalisons aussi des déménagements longue distance vers toute la France.` },
  { q: 'Proposez-vous l\'emballage des cartons ?', a: 'Oui, nous proposons le service d\'emballage complet (matériel + main d\'œuvre) en option, à partir de 120 € pour les matériaux et 40 €/h ou 280 € au forfait pour la main d\'œuvre.' },
  { q: 'Comment protégez-vous les objets transportés ?', a: 'Vos biens sont manipulés avec le plus grand soin : démontage maîtrisé, protection des meubles fragiles (couvertures, housses), calage et sanglage dans le fourgon. Pour une couverture spécifique sur des objets de grande valeur, parlons-en lors du devis.' },
  { q: 'Faites-vous un petit déménagement (1-2 meubles) ?', a: 'Oui, nous prenons en charge les petits déménagements à partir de 150 €. Idéal pour la livraison d\'un canapé acheté sur Le Bon Coin, un mini-déménagement étudiant ou un cabinet professionnel.' },
  { q: 'Transportez-vous les pianos et objets lourds ?', a: 'Oui, nous sommes équipés pour transporter les pianos droits (350 €), pianos à queue (550 €), coffres-forts (dès 250 €) et autres objets lourds. Sangles spéciales et formation à la manutention lourde.' },
  { q: 'Comment obtenir un devis ?', a: 'Remplissez le formulaire sur cette page ou appelez-nous directement au ' + SITE.phoneDisplay + '. Vous recevrez une réponse sous 2h (Lun–Sam, 8h–19h).' },
];

const marquee = ['Déménagement local', 'Longue distance', 'International', 'Transport de meubles', 'Piano & objets lourds', 'Évacuation déchets', 'Petit déménagement'];
const priceFmt = (n: number) => new Intl.NumberFormat('fr-FR').format(n) + ' €';
---

<BaseLayout title={title} description={description}>
  <SchemaLocalBusiness slot="head" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  })} />
  <Header />

  <!-- ============ DELIVERY HERO (corner video card, scrubbed) ============ -->
  <DeliveryHero />

  <!-- ============ MARQUEE ============ -->
  <div class="marquee">
    <div class="marquee-in">
      <span>{marquee.map(m => (<>{m} <i class="dot">·</i> </>))}</span>
      <span>{marquee.map(m => (<>{m} <i class="dot">·</i> </>))}</span>
    </div>
  </div>

  <!-- ============ STATS ============ -->
  <section class="d-stats">
    <div class="container stats-row">
      {stats.map((s, i) => (
        <div class="stat reveal" data-i={i}>
          <div class="stat-num">{s.value}<sup>{s.sup}</sup></div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="d-section" id="services">
    <div class="container">
      <div class="d-head reveal">
        <h2 class="display">Nos <em>prestations.</em></h2>
        <p>Du déménagement local au transport international, nous avons la solution adaptée — particuliers comme professionnels.</p>
      </div>
      <div class="svc-grid">
        {SERVICES.map((s, i) => (
          <a href={`/services/${s.slug}`} class="svc-item reveal" data-i={i}>
            <div class="svc-num">— {String(i + 1).padStart(2, '0')}</div>
            <h3>{s.name}</h3>
            <p>{s.description}</p>
            <div class="svc-price">à partir de {priceFmt(s.priceFrom)}</div>
            <span class="svc-link">En savoir plus</span>
          </a>
        ))}
        <a href="/contact" class="svc-item svc-item--dark reveal" data-i={6}>
          <div class="svc-num">— Cas particulier ?</div>
          <h3>Décrivez votre<br/>situation.</h3>
          <p>Volume hors normes, objet fragile, longue distance : en cinq ans nous avons presque tout vu. Nous trouverons une solution.</p>
          <span class="svc-link">Nous contacter</span>
        </a>
      </div>
    </div>
  </section>

  <RoadDivider />

  <!-- ============ FLOTTE ============ -->
  <section class="d-section d-section--alt">
    <div class="container">
      <div class="fleet-grid reveal">
        <div class="fleet-left">
          <span class="mono-label">Notre matériel</span>
          <h2 class="display">Une flotte adaptée<br/>à <em>chaque volume.</em></h2>
          <p>Deux fourgons professionnels équipés de hayon élévateur, sangles et protections. Au-delà de 20 m³, nous combinons les véhicules ou effectuons plusieurs rotations — pas de limite de volume.</p>
        </div>
        <div class="fleet-cards">
          {fourgons.map(f => (
            <div class="fleet-card">
              <h3>{f.name}</h3>
              <p>{f.desc}</p>
              <div class="fleet-specs">
                <div><span class="spec-k">Capacité</span><span class="spec-v">{f.cap}</span></div>
                <div><span class="spec-k">Charge utile</span><span class="spec-v">{f.payload}</span></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GARANTIES ============ -->
  <section class="d-section d-dark">
    <div class="container">
      <div class="d-head d-head--center reveal">
        <h2 class="display">Six garanties,<br/>une <em>tranquillité.</em></h2>
        <p>Notre métier, ce n'est pas seulement transporter — c'est vous garantir une expérience sans stress.</p>
      </div>
      <div class="gar-grid">
        {garanties.map((g, i) => (
          <div class="gar reveal" data-i={i}>
            <div class="gar-num">— {g.num}</div>
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ZONE ============ -->
  <section class="d-section">
    <div class="container">
      <div class="zone-grid">
        <div class="zone-left reveal">
          <span class="mono-label">Zone d'intervention</span>
          <h2 class="display">Carcassonne<br/>et <em>environs.</em></h2>
          <p>Nous intervenons dans un rayon de {SITE.serviceRadius} km autour de Carcassonne, et bien au-delà pour la longue distance. Cliquez sur votre commune pour votre page dédiée.</p>
        </div>
        <div class="zone-cities">
          {CITIES.map((c, i) => (
            <a href={`/demenagement-${c.slug}`} class={(i < 5 ? 'zone-city main' : 'zone-city') + ' reveal'} data-i={i}>{c.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ METHODE ============ -->
  <section class="d-section d-section--alt">
    <div class="container">
      <div class="d-head reveal"><h2 class="display">Notre <em>méthode.</em></h2><p>Un processus simple et transparent en quatre étapes, du premier appel à l'installation chez vous.</p></div>
      <div class="steps-grid">
        {steps.map((s, i) => (
          <div class="step reveal" data-i={i}>
            <div class="step-num">— Étape {s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="d-section d-dark">
    <div class="container">
      <div class="d-head reveal"><h2 class="display">Ils nous font<br/><em>confiance.</em></h2><p>Particuliers et professionnels témoignent de leur déménagement avec Transport Carcassonne.</p></div>
      <div class="tst-grid">
        {testimonials.map((t, i) => (
          <div class="tst reveal" data-i={i}>
            <span class="tst-q">"</span>
            <p>{t.text}</p>
            <div class="tst-author"><div class="tst-name">{t.name}</div><div class="tst-meta">{t.city}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="d-section">
    <div class="container">
      <div class="d-head d-head--center reveal"><h2 class="display">Questions <em>fréquentes.</em></h2></div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq reveal" data-i={i}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RoadDivider />

  <ComboOffer />
  <QuoteForm title="Demandez votre devis gratuit" subtitle="Réponse sous 2h · Lun–Sam 8h–19h" />
  <Footer />
</BaseLayout>

<style>
  .display { font-family: 'Instrument Serif', serif; font-weight: 400; letter-spacing: -.02em; line-height: 1; }
  .display em, em { font-style: italic; color: var(--accent); }
  .mono-label { font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: var(--accent); font-weight: 500; display: block; margin-bottom: 22px; }

  /* HERO content (over 3D scene) */
  .hero-content { position: relative; max-width: 600px; }
  .hero-screen { position: absolute; max-width: 620px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 13px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin-bottom: 26px; }
  .hero-eyebrow span { width: 32px; height: 1px; background: var(--accent); }
  .hero-title { font-family: 'Instrument Serif', serif; font-weight: 400; color: var(--text-on-dark); font-size: clamp(52px, 7vw, 102px); line-height: .97; letter-spacing: -.02em; margin-bottom: 24px; }
  .hero-sub { font-size: 18px; color: var(--text-on-dark-muted); max-width: 460px; margin-bottom: 34px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-hero-ghost { background: transparent; color: var(--text-on-dark); border: 1px solid var(--line-dark); }
  .btn-hero-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* MARQUEE */
  .marquee { background: var(--bg-dark); border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); padding: 18px 0; overflow: hidden; }
  .marquee-in { display: flex; gap: 46px; white-space: nowrap; animation: marq 40s linear infinite; color: var(--text-on-dark-muted); font-size: 14px; }
  .marquee-in span { display: flex; align-items: center; gap: 46px; padding-right: 46px; }
  .marquee .dot { color: var(--accent); font-style: normal; }
  @keyframes marq { to { transform: translateX(-50%); } }

  /* SECTION SHELL */
  .d-section { padding: 120px 0; background: var(--bg); }
  .d-section--alt { background: var(--bg-soft); }
  .d-dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .d-head { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: end; margin-bottom: 64px; }
  .d-head h2 { font-size: clamp(38px, 5vw, 68px); line-height: 1; }
  .d-head p { color: var(--text-muted); font-size: 17px; max-width: 480px; }
  .d-dark .d-head p { color: var(--text-on-dark-muted); }
  .d-head--center { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  .d-head--center p { margin: 0 auto; }

  /* STATS */
  .d-stats { background: var(--bg-dark); color: var(--text-on-dark); }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 44px 24px; border-right: 1px solid var(--line-dark); text-align: center; }
  .stat:last-child { border-right: none; }
  .stat-num { font-family: 'Instrument Serif', serif; font-size: 60px; line-height: 1; color: var(--text-on-dark); }
  .stat-num sup { font-size: 20px; color: var(--accent); font-style: italic; margin-left: 2px; }
  .stat-label { font-size: 13px; color: var(--text-on-dark-muted); margin-top: 10px; }

  /* SERVICES */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .svc-item { position: relative; background: var(--bg); padding: 42px 34px; min-height: 300px; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: background .3s var(--ease-out), transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .svc-item:hover { background: var(--bg-card); transform: translateY(-4px); box-shadow: var(--shadow-soft-light); z-index: 1; }
  .svc-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 13px; color: var(--text-muted); margin-bottom: 32px; }
  .svc-item h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 29px; line-height: 1.08; margin-bottom: 14px; }
  .svc-item p { color: var(--text-muted); font-size: 14px; flex: 1; }
  .svc-price { font-family: 'Instrument Serif', serif; font-style: italic; color: var(--accent); font-size: 18px; margin: 18px 0; }
  .svc-link { font-size: 11px; text-transform: uppercase; letter-spacing: .18em; display: inline-flex; align-items: center; gap: 8px; }
  .svc-link::after { content: '→'; transition: transform .3s; }
  .svc-item:hover .svc-link::after { transform: translateX(4px); }
  .svc-item--dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .svc-item--dark:hover { background: var(--bg-dark-alt); box-shadow: var(--shadow-soft); }
  .svc-item--dark h3 { color: var(--text-on-dark); }
  .svc-item--dark p { color: var(--text-on-dark-muted); }
  .svc-item--dark .svc-num, .svc-item--dark .svc-link { color: var(--accent); }

  /* FLEET */
  .fleet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .fleet-left h2 { font-size: clamp(34px, 4.4vw, 56px); line-height: 1.04; margin-bottom: 26px; }
  .fleet-left p { color: var(--text-muted); font-size: 16px; line-height: 1.65; }
  .fleet-cards { display: grid; gap: 16px; }
  .fleet-card { background: var(--bg-card); border: 1px solid var(--line); padding: 30px; transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out), border-color .35s var(--ease-out); }
  .fleet-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft-light); border-color: var(--accent); }
  .fleet-card h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 26px; margin-bottom: 10px; }
  .fleet-card p { color: var(--text-muted); font-size: 14px; margin-bottom: 22px; }
  .fleet-specs { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); padding-top: 18px; }
  .fleet-specs div { display: flex; flex-direction: column; gap: 4px; }
  .spec-k { font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: var(--text-muted); }
  .spec-v { font-family: 'Instrument Serif', serif; font-size: 26px; color: var(--accent); }

  /* GARANTIES */
  .gar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); }
  .gar { position: relative; background: var(--bg-dark); padding: 38px 32px; transition: background .3s var(--ease-out), transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .gar:hover { background: var(--bg-dark-alt); transform: translateY(-4px); box-shadow: var(--shadow-soft); z-index: 1; }
  .gar-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 13px; color: var(--accent); margin-bottom: 26px; }
  .gar h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 24px; color: var(--text-on-dark); margin-bottom: 14px; }
  .gar p { font-size: 14px; color: var(--text-on-dark-muted); line-height: 1.6; }

  /* ZONE */
  .zone-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .zone-left h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1; margin-bottom: 24px; }
  .zone-left p { color: var(--text-muted); font-size: 16px; line-height: 1.65; }
  .zone-cities { display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
  .zone-city { border: 1px solid var(--line); padding: 10px 18px; border-radius: 4px; font-size: 13px; color: var(--text); text-decoration: none; transition: all .2s; }
  .zone-city:hover { background: var(--text); color: var(--bg); border-color: var(--text); }
  .zone-city.main { background: var(--bg-dark); color: var(--text-on-dark); border-color: var(--bg-dark); }
  .zone-city.main:hover { background: var(--accent); border-color: var(--accent); color: var(--bg-dark); }

  /* STEPS */
  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .step { border-top: 2px solid var(--text); padding-top: 26px; }
  .step-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 14px; color: var(--accent); margin-bottom: 70px; }
  .step h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 26px; margin-bottom: 12px; }
  .step p { color: var(--text-muted); font-size: 14px; line-height: 1.6; }

  /* TESTIMONIALS */
  .tst-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tst { background: var(--bg-dark-alt); border: 1px solid var(--line-dark); padding: 38px 34px; transition: border-color .3s var(--ease-out), transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .tst:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: var(--shadow-soft); }
  .tst-q { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 70px; line-height: .4; color: var(--accent); display: inline-block; margin-bottom: 26px; }
  .tst p { font-family: 'Instrument Serif', serif; font-size: 19px; line-height: 1.45; color: var(--text-on-dark); margin-bottom: 28px; }
  .tst-author { border-top: 1px solid var(--line-dark); padding-top: 18px; }
  .tst-name { font-size: 14px; font-weight: 500; color: var(--text-on-dark); }
  .tst-meta { font-size: 12px; color: var(--text-on-dark-muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 4px; }

  /* FAQ */
  .faq-list { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
  .faq { border: 1px solid var(--line); border-radius: 4px; background: var(--bg-card); overflow: hidden; transition: border-color .3s var(--ease-out), box-shadow .3s var(--ease-out); }
  .faq:hover { border-color: var(--accent); box-shadow: var(--shadow-soft-light); }
  .faq summary { padding: 20px 24px; font-weight: 500; font-size: 15px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 20px; color: var(--accent); flex-shrink: 0; }
