---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import Calculator from '../components/Calculator.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site.config';

const title = 'Tarifs indicatifs de déménagement à Carcassonne';
const description = `Tarifs indicatifs de déménagement à Carcassonne selon le volume, les accès, le trajet et les options. Prix confirmé uniquement sur devis. ${SITE.phoneDisplay}`;

const localPrices = [
  { label: 'Studio / T1', price: 450, note: '≤ 30 m²' },
  { label: 'T2', price: 650, note: '31–55 m²' },
  { label: 'T3', price: 950, note: '56–75 m²' },
  { label: 'T4 / T5', price: 1400, note: '76–100 m²' },
  { label: 'Maison', price: 1900, note: '> 100 m²' },
];

const longDistancePrices = [
  { label: 'Studio', price: 950, note: 'Toute la France' },
  { label: 'T2 / T3', price: 1800, note: 'Toute la France' },
  { label: 'Maison', price: 2800, note: 'Toute la France' },
];

const additionalServices = [
  { label: 'Fournitures d’emballage', price: 'Sur devis', unit: 'selon nature et quantité' },
  { label: 'Main-d’œuvre d’emballage', price: 'Sur devis', unit: 'selon volume et niveau de préparation' },
  { label: 'Démontage / remontage de meubles', price: 'Sur devis', unit: 'selon nombre et complexité' },
  { label: 'Protections des meubles', price: 'Selon devis', unit: 'matériel et périmètre précisés par écrit' },
  { label: 'Piano ou objet lourd', price: 'Sur étude', unit: 'selon poids, accès et trajet' },
  { label: 'Coffre-fort', price: 'Sur étude', unit: 'selon poids, accès et moyens nécessaires' },
];

const inclus = [
  'Adresse de départ et adresse d’arrivée',
  'Volume et mobilier déclarés',
  'Moyens humains et véhicule prévus',
  'Trajet et créneau convenus',
  'Protections et manutention prévues',
  'Options expressément retenues',
  'Prix et conditions applicables',
  'Coordonnées de l’entreprise sur les documents',
];

const nonInclus = [
  'Tout objet, volume ou adresse non déclaré',
  'Emballage, démontage ou remontage non retenu',
  'Contraintes d’accès non signalées',
  'Stationnement, péages ou formalités non prévus',
  'Prestations de stockage non mentionnées au devis',
  'Transport d’animaux',
  'Toute option qui ne figure pas sur le devis accepté',
];

const tarifFaqs = [
  { q: 'Comment calculez-vous le prix d\'un déménagement ?', a: 'Le prix dépend notamment du volume, de la distance, des accès, du stationnement, de la date et des options choisies. Ces éléments sont recueillis avant l’émission d’un devis personnalisé.' },
  { q: 'Le prix affiché sur cette page est-il définitif ?', a: 'Non. Les montants de cette page sont des repères indicatifs et non contractuels. Seul le devis écrit précise le prix, le périmètre et les conditions applicables au projet.' },
  { q: 'Y a-t-il un acompte à verser ?', a: 'Les modalités d’acompte et de règlement doivent être vérifiées sur le devis et les conditions qui vous sont remis avant acceptation.' },
  { q: 'Quel est le tarif pour un petit déménagement (1 ou 2 meubles) ?', a: 'Le repère affiché commence à 150 €, mais le montant varie selon la manutention, les accès et le trajet. Demandez un devis pour obtenir un prix adapté au projet.' },
  { q: 'Faites-vous des remises pour les étudiants ou seniors ?', a: 'Toute remise éventuellement proposée doit figurer explicitement sur le devis. Cette page ne promet aucune réduction générale ou cumul automatique.' },
  { q: 'Que se passe-t-il si le volume réel est supérieur à celui annoncé ?', a: 'Signalez toute modification avant l’intervention. Ses conséquences éventuelles sur les moyens, le planning ou le prix doivent être convenues par écrit.' },
  { q: 'Quels moyens de paiement acceptez-vous ?', a: 'Les moyens, échéances et éventuels frais de paiement applicables sont précisés dans les documents remis avant acceptation.' },
];
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': tarifFaqs.map(f => ({
      '@type': 'Question',
      'name': f.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
    })),
  })} />
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: 'Tarifs' }]} />

  <!-- Hero -->
  <section class="tarifs-hero">
    <div class="container">
      <span class="section-label">Repères tarifaires</span>
      <h1>Estimer le budget de votre déménagement</h1>
      <p class="tarifs-hero-sub">
        Nos tarifs sont basés sur le volume réel, la distance et les options choisies.
        Les montants ci-dessous sont indicatifs et non contractuels ; seul le devis écrit confirme le prix.
      </p>
    </div>
  </section>

  <Calculator />

  <main class="section">
    <div class="container">

      <!-- Local -->
      <div class="tarif-block">
        <div class="tarif-block__header">
          <div class="tarif-block__icon">🏠</div>
          <div>
            <h2>Déménagement local</h2>
            <p>Dans un rayon de 50 km autour de Carcassonne</p>
          </div>
        </div>
        <div class="tarif-table">
          <div class="tarif-table__head">
            <span>Type de logement</span>
            <span>Surface</span>
            <span>Repère indicatif</span>
            <span></span>
          </div>
          {localPrices.map((row, i) => (
            <div class:list={['tarif-table__row', i % 2 === 0 && 'tarif-table__row--alt']}>
              <span class="tarif-name">{row.label}</span>
              <span class="tarif-note">{row.note}</span>
              <span class="tarif-price">{row.price} €</span>
              <a href={`/devis/?logement=${encodeURIComponent(row.label)}&distance=local&source=tarifs`} class="tarif-cta">Devis →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- Longue distance -->
      <div class="tarif-block">
        <div class="tarif-block__header">
          <div class="tarif-block__icon">🚚</div>
          <div>
            <h2>Déménagement longue distance</h2>
            <p>Carcassonne vers toute la France métropolitaine</p>
          </div>
        </div>
        <div class="tarif-table">
          <div class="tarif-table__head">
            <span>Type de logement</span>
            <span>Zone</span>
            <span>Repère indicatif</span>
            <span></span>
          </div>
          {longDistancePrices.map((row, i) => (
            <div class:list={['tarif-table__row', i % 2 === 0 && 'tarif-table__row--alt']}>
              <span class="tarif-name">{row.label}</span>
              <span class="tarif-note">{row.note}</span>
              <span class="tarif-price">{row.price} €</span>
              <a href={`/devis/?logement=${encodeURIComponent(row.label)}&distance=longue&source=tarifs`} class="tarif-cta">Devis →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- International -->
      <div class="tarif-block tarif-block--accent">
        <div class="tarif-block__header">
          <div class="tarif-block__icon">🌍</div>
          <div>
            <h2>Déménagement international</h2>
            <p>Espagne, Italie, Belgique et Europe depuis Carcassonne</p>
          </div>
        </div>
        <div class="tarif-intl">
          <div class="tarif-intl__price">
            <span class="tarif-intl__from">Repère indicatif dès</span>
            <span class="tarif-intl__amount">2 500 €</span>
            <span class="tarif-intl__range">(exemple de fourchette non contractuelle : 2 500 € – 5 000 €)</span>
          </div>
          <p class="tarif-intl__note">
            Le tarif international dépend de la destination, du volume et des services choisis.
            Le montant et les conditions sont confirmés sur devis selon les informations du projet.
          </p>
          <a href="/devis/?service=demenagement-international&source=tarifs" class="btn btn--primary">Demander un devis international →</a>
        </div>
      </div>

      <!-- Additional services -->
      <div class="tarif-block">
        <div class="tarif-block__header">
          <div class="tarif-block__icon">➕</div>
          <div>
            <h2>Services complémentaires</h2>
            <p>Options disponibles pour tous types de déménagement</p>
          </div>
        </div>
        <div class="additional-table">
          {additionalServices.map((row, i) => (
            <div class:list={['additional-row', i % 2 === 0 && 'additional-row--alt']}>
              <span class="add-label">{row.label}</span>
              <span class="add-price">{row.price}</span>
              <span class="add-unit">{row.unit}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Inclus / Non inclus -->
      <div class="tarif-block inclus-block">
        <div class="tarif-block__header">
          <div class="tarif-block__icon">✅</div>
          <div>
            <h2>Ce que le devis doit préciser</h2>
            <p>Vérifiez le périmètre écrit avant d’accepter la proposition</p>
          </div>
        </div>
        <div class="inclus-grid">
          <div class="inclus-col inclus-col--yes">
            <h3 class="inclus-col__title">✓ À faire figurer au devis</h3>
            <ul>
              {inclus.map(item => <li>{item}</li>)}
            </ul>
          </div>
          <div class="inclus-col inclus-col--no">
            <h3 class="inclus-col__title">✗ Non inclus sauf mention écrite</h3>
            <ul>
              {nonInclus.map(item => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Notes -->
      <div class="tarif-notes">
        <h3>Conditions et précisions</h3>
        <ul>
          <li>Tous les montants affichés sont des <strong>repères indicatifs et non contractuels</strong>.</li>
          <li>Le devis doit préciser le matériel de protection, la manutention et les options effectivement retenus.</li>
          <li>Le traitement fiscal applicable et le montant total sont indiqués sur le devis.</li>
          <li>Les modalités d’acompte et de paiement sont celles indiquées dans les documents remis avant acceptation.</li>
          <li>La demande est étudiée selon les informations transmises et les disponibilités.</li>
        </ul>
      </div>

      <!-- FAQ -->
      <div class="tarif-faq">
        <div class="tarif-faq__header">
          <span class="section-label">FAQ</span>
          <h2>Questions sur nos tarifs</h2>
        </div>
        <div class="tarif-faq__list">
          {tarifFaqs.map(faq => (
            <details class="tarif-faq__item">
              <summary class="tarif-faq__q">{faq.q}</summary>
              <p class="tarif-faq__a">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <CTA
    title="Obtenez un devis adapté à votre projet"
    subtitle="Indiquez le volume, les accès, le trajet et la date souhaitée pour recevoir une proposition personnalisée."
  />

  <Footer />
</BaseLayout>

<style>
  .tarifs-hero {
    background: var(--color-navy);
    color: white;
    padding: 64px 0;
    text-align: center;
  }
  .tarifs-hero h1 { color: white; margin: 12px 0; }
  .tarifs-hero-sub { color: rgba(255,255,255,.75); font-size: 1.05rem; max-width: 540px; margin: 0 auto; }

  .tarif-block {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 32px;
  }
  .tarif-block--accent { border-color: var(--color-accent); }

  .tarif-block__header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }
  .tarif-block__icon { font-size: 2rem; }
  .tarif-block__header h2 {
    font-size: 1.25rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 4px;
  }
  .tarif-block__header p { font-size: .88rem; color: var(--color-text-light); }

  .tarif-table { padding: 0 28px 20px; }
  .tarif-table__head {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 100px;
    gap: 12px;
    padding: 14px 0 10px;
    border-bottom: 1px solid var(--color-border);
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--color-text-light);
  }
  .tarif-table__row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 100px;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }
  .tarif-table__row:last-child { border-bottom: none; }
  .tarif-table__row--alt { background: var(--color-bg); margin: 0 -28px; padding: 16px 28px; }
  .tarif-name { font-weight: 600; color: var(--color-navy); font-size: .95rem; }
  .tarif-note { font-size: .85rem; color: var(--color-text-light); }
  .tarif-price {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .tarif-cta {
    font-size: .85rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
    text-align: right;
  }
  .tarif-cta:hover { color: var(--color-accent); }

  .tarif-intl {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tarif-intl__price { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .tarif-intl__from { font-size: .9rem; color: var(--color-text-light); }
  .tarif-intl__amount {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .tarif-intl__range { font-size: .85rem; color: var(--color-text-light); }
  .tarif-intl__note { font-size: .9rem; color: var(--color-text); line-height: 1.6; max-width: 560px; }

  .additional-table { padding: 12px 28px 20px; }
  .additional-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    font-size: .9rem;
  }
  .additional-row:last-child { border-bottom: none; }
  .additional-row--alt { background: var(--color-bg); margin: 0 -28px; padding: 13px 28px; }
  .add-label { color: var(--color-text); font-weight: 500; }
  .add-price { font-weight: 700; color: var(--color-navy); }
  .add-unit { font-size: .82rem; color: var(--color-text-light); }

  .tarif-notes {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 28px 32px;
    margin-top: 8px;
  }
  .tarif-notes h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--color-navy);
  }
  .tarif-notes ul { display: flex; flex-direction: column; gap: 8px; }
  .tarif-notes li {
    font-size: .9rem;
    color: var(--color-text);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }
  .tarif-notes li::before { content: '→'; position: absolute; left: 0; color: var(--color-accent); }

  /* Inclus / Non inclus */
  .inclus-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 0;
  }
  .inclus-col { padding: 28px 32px; }
  .inclus-col + .inclus-col { border-left: 1px solid var(--color-border); }
  .inclus-col--yes { background: rgba(168, 112, 63, 0.04); }
  .inclus-col--no { background: var(--color-bg-alt); }
  .inclus-col__title {
    font-family: var(--font-sans);
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--color-accent);
    margin-bottom: 16px;
  }
  .inclus-col--no .inclus-col__title { color: var(--color-text-light); }
  .inclus-col ul { display: flex; flex-direction: column; gap: 10px; }
  .inclus-col li {
    font-size: .9rem;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: 4px;
  }

  /* Tarif FAQ */
  .tarif-faq { margin-top: 48px; }
  .tarif-faq__header {
    text-align: center;
    margin-bottom: 32px;
  }
  .tarif-faq__header h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--color-navy);
    margin-top: 8px;
  }
  .tarif-faq__list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tarif-faq__item {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tarif-faq__q {
    padding: 18px 24px;
    font-weight: 600;
    font-size: .95rem;
    color: var(--color-navy);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tarif-faq__q::-webkit-details-marker { display: none; }
  .tarif-faq__q::after {
    content: '+';
    font-size: 1.2rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  details[open] .tarif-faq__q::after { content: '−'; }
  .tarif-faq__a {
    padding: 0 24px 18px;
    font-size: .9rem;
    color: var(--color-text);
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .tarif-table__head { display: none; }
    .tarif-table__row {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }
    .tarif-note { grid-column: 1; }
    .tarif-price { grid-column: 2; text-align: right; }
    .tarif-cta { grid-column: 1 / -1; text-align: left; }
    .additional-row { grid-template-columns: 1fr; }
    .add-price { font-size: 1rem; }
    .inclus-grid { grid-template-columns: 1fr; }
    .inclus-col + .inclus-col { border-left: none; border-top: 1px solid var(--color-border); }
  }
</style>
