---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
---

<footer class="footer">
  <div class="container footer-grid">
    <!-- Col 1: About -->
    <div class="footer-col">
      <div class="footer-logo">
        <div class="footer-logo-icon">T</div>
        <div>
          <div class="footer-logo-name">{SITE.name}</div>
          <div class="footer-logo-sub">Déménageur professionnel</div>
        </div>
      </div>
      <p class="footer-about">
        Spécialiste du déménagement à Carcassonne et dans l'Aude depuis plusieurs années.
        Service local, prix transparents, équipe professionnelle.
      </p>
      <div class="footer-siret">SIRET : {SITE.siret}</div>
      <div class="footer-hours">🕐 {SITE.hours}</div>
    </div>

    <!-- Col 2: Services -->
    <div class="footer-col">
      <h4 class="footer-heading">Nos services</h4>
      <ul class="footer-links">
        {SERVICES.map(s => (
          <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
        ))}
        <li><a href="/tarifs">Nos tarifs</a></li>
      </ul>
    </div>

    <!-- Col 3: Zone -->
    <div class="footer-col">
      <h4 class="footer-heading">Zone d'intervention</h4>
      <ul class="footer-links">
        {CITIES.map(c => (
          <li><a href={`/demenagement-${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Col 4: Contact -->
    <div class="footer-col">
      <h4 class="footer-heading">Contact</h4>
      <ul class="footer-contact-list">
        <li>
          <a href={`tel:${SITE.phone}`} class="footer-contact-link">
            📞 {SITE.phoneDisplay}
          </a>
        </li>
        <li>
          <a
            href={`https://wa.me/${SITE.phoneWhatsapp}`}
            class="footer-contact-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            💬 WhatsApp
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="footer-contact-link">
            ✉️ {SITE.email}
          </a>
        </li>
        <li class="footer-address">
          📍 {SITE.hq.city} {SITE.hq.postalCode}, {SITE.hq.region}
        </li>
      </ul>
      <a href="/contact" class="footer-devis-btn">Devis gratuit →</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {new Date().getFullYear()} {SITE.name} — Tous droits réservés</span>
      <div class="footer-legal-links">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-confidentialite">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-dark, #111d33);
    color: rgba(255,255,255,.8);
    padding: 64px 0 0;
    font-size: .9rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .footer-logo-icon {
    width: 38px;
    height: 38px;
    background: var(--color-accent);
    color: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .footer-logo-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: white;
    line-height: 1.1;
  }
  .footer-logo-sub { font-size: .72rem; opacity: .6; margin-top: 2px; }

  .footer-about {
    font-size: .85rem;
    line-height: 1.6;
    opacity: .75;
    margin-bottom: 12px;
  }
  .footer-siret { font-size: .78rem; opacity: .5; margin-bottom: 6px; }
  .footer-hours { font-size: .82rem; opacity: .65; }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .footer-links { display: flex; flex-direction: column; gap: 8px; }
  .footer-links a {
    color: rgba(255,255,255,.7);
    font-size: .88rem;
    transition: color .15s;
  }
  .footer-links a:hover { color: white; }

  .footer-contact-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .footer-contact-link {
    color: rgba(255,255,255,.75);
    font-size: .88rem;
    transition: color .15s;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .footer-contact-link:hover { color: white; }
  .footer-address { font-size: .84rem; opacity: .6; }

  .footer-devis-btn {
    display: inline-block;
    padding: 10px 20px;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius);
    font-size: .88rem;
    font-weight: 600;
    transition: background .15s;
  }
  .footer-devis-btn:hover { background: var(--color-accent-dark); }

  .footer-bottom {
    padding: 20px 0;
    font-size: .78rem;
    opacity: .5;
  }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-legal-links { display: flex; gap: 20px; }
  .footer-legal-links a:hover { opacity: 1; text-decoration: underline; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
