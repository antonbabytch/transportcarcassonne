# URL publique du site
PUBLIC_SITE_URL=https://transportcarcassonne.fr

# Secret de signature de l'endpoint Stripe (commence par whsec_)
# À enregistrer uniquement dans les variables d'environnement Netlify.
STRIPE_WEBHOOK_SECRET=

# Notifications email via la boîte Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@transportcarcassonne.fr
SMTP_PASS=
PAYMENT_EMAIL_FROM=contact@transportcarcassonne.fr
PAYMENT_REPLY_TO=contact@transportcarcassonne.fr
PAYMENT_NOTIFICATION_TO=contact@transportcarcassonne.fr

# Rappels : le cron s'exécute chaque jour à 07:00 UTC
BALANCE_REMINDER_DAYS_BEFORE=3
REVIEW_REQUEST_DAYS_AFTER=1

# Laisser false jusqu'au test d'un dossier complet et à la validation de la date de prestation.
AUTO_REVIEW_REQUESTS=false

# Lien officiel « Demander des avis » copié depuis Google Business Profile.
# Sans cette valeur, l'email dirige vers https://transportcarcassonne.fr/avis/
GOOGLE_REVIEW_URL=https://g.page/r/CfkVxczuGs8VEBM/review

