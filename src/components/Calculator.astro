---
// Working moving-cost estimator. Computes an indicative price range from housing
// type, distance, floors (lift), and options — based on the published tariffs.
---
<section class="calc" id="calc">
  <div class="container">
    <div class="calc-card">
      <div class="calc-head">
        <span class="section-label">Estimation immédiate</span>
        <h2>Estimez votre déménagement en 30 secondes</h2>
        <p>Une fourchette indicative calculée à partir de repères généraux. Seul le devis écrit confirme le prix et les prestations.</p>
      </div>

      <div class="calc-grid">
        <label class="calc-field">Type de logement
          <select id="calc-type">
            <option value="studio">Studio / T1</option>
            <option value="t2" selected>T2</option>
            <option value="t3">T3</option>
            <option value="t4">T4 / T5</option>
            <option value="maison">Maison</option>
          </select>
        </label>
        <label class="calc-field">Distance
          <select id="calc-dist">
            <option value="local" selected>Local (≤ 50 km)</option>
            <option value="longue">Longue distance (France)</option>
          </select>
        </label>
        <label class="calc-field">Étage au départ
          <select id="calc-fd">
            <option value="0" selected>Rez-de-chaussée</option>
            <option value="1">1er</option>
            <option value="2">2e</option>
            <option value="3">3e</option>
            <option value="4">4e et +</option>
          </select>
        </label>
        <label class="calc-field">Étage à l'arrivée
          <select id="calc-fa">
            <option value="0" selected>Rez-de-chaussée</option>
            <option value="1">1er</option>
            <option value="2">2e</option>
            <option value="3">3e</option>
            <option value="4">4e et +</option>
          </select>
        </label>
      </div>

      <div class="calc-checks">
        <label class="calc-check"><input type="checkbox" id="calc-ed" /> Ascenseur au départ</label>
        <label class="calc-check"><input type="checkbox" id="calc-ea" /> Ascenseur à l'arrivée</label>
        <label class="calc-check"><input type="checkbox" id="opt-emb" /> Emballage des cartons <span>repère +280 €</span></label>
        <label class="calc-check"><input type="checkbox" id="opt-dem" /> Démontage / remontage <span>repère +120 €</span></label>
        <label class="calc-check"><input type="checkbox" id="opt-piano" /> Transport d'un piano <span>repère +350 €</span></label>
      </div>

      <div class="calc-result">
        <div class="calc-result-box">
          <span class="calc-result-label">Estimation indicative</span>
          <span class="calc-result-value" id="calc-out">— €</span>
        </div>
        <a href="/devis/?source=calculateur-prix" class="btn btn--primary btn--lg">Affiner mon estimation →</a>
      </div>
      <p class="calc-note">
        Estimation non contractuelle. Le montant final est confirmé sur devis après évaluation
        du volume réel, des accès, de la distance et des prestations retenues.
      </p>
    </div>
  </div>
</section>

<style>
  .calc { padding: 56px 0; background: var(--color-bg-alt); }
  .calc-card { background: var(--color-white); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); padding: 36px; max-width: 880px; margin: 0 auto; box-shadow: var(--shadow); }
  .calc-head { text-align: center; margin-bottom: 28px; }
  .calc-head h2 { margin: 8px 0 8px; }
  .calc-head p { color: var(--color-text-light); font-size: .95rem; max-width: 560px; margin: 0 auto; }
  .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .calc-field { display: flex; flex-direction: column; gap: 6px; font-size: .82rem; font-weight: 600; color: var(--color-navy); }
  .calc-field select { min-height: 46px; padding: 10px 14px; font-size: 15px; font-family: var(--font-sans); color: var(--color-text); background: var(--color-bg); border: 1.5px solid var(--color-border); border-radius: var(--radius); appearance: none; cursor: pointer; }
  .calc-field select:focus { outline: none; border-color: var(--color-accent); }
  .calc-checks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; margin-bottom: 24px; padding-top: 6px; }
  .calc-check { display: flex; align-items: center; gap: 9px; font-size: .9rem; color: var(--color-text); cursor: pointer; }
  .calc-check input { width: 18px; height: 18px; accent-color: var(--color-accent); flex-shrink: 0; }
  .calc-check span { color: var(--color-accent); font-weight: 600; margin-left: 2px; }
  .calc-result { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; background: var(--color-navy); border-radius: var(--radius-lg); padding: 22px 26px; }
  .calc-result-box { display: flex; flex-direction: column; }
  .calc-result-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,255,255,.6); }
  .calc-result-value { font-family: var(--font-display); font-size: 2rem; color: var(--color-accent); line-height: 1.1; }
  .calc-note { font-size: .78rem; color: var(--color-text-light); text-align: center; margin-top: 16px; line-height: 1.5; }
  @media (max-width: 640px) {
    .calc-card { padding: 24px 18px; }
    .calc-grid, .calc-checks { grid-template-columns: 1fr; }
    .calc-result { flex-direction: column; align-items: stretch; text-align: center; }
    .calc-result .btn { justify-content: center; }
  }
</style>

<script is:inline>
  (function () {
    var BASE = {
      local: { studio: 450, t2: 650, t3: 950, t4: 1400, maison: 1900 },
      longue: { studio: 950, t2: 1800, t3: 1800, t4: 2800, maison: 2800 }
    };
    var $ = function (id) { return document.getElementById(id); };
    var out = $('calc-out');
    if (!out) return;
    function n(v) { return new Intl.NumberFormat('fr-FR').format(v); }
    function compute() {
      var p = BASE[$('calc-dist').value][$('calc-type').value];
      if (!$('calc-ed').checked) p += parseInt($('calc-fd').value, 10) * 25;
      if (!$('calc-ea').checked) p += parseInt($('calc-fa').value, 10) * 25;
      if ($('opt-emb').checked) p += 280;
      if ($('opt-dem').checked) p += 120;
      if ($('opt-piano').checked) p += 350;
      var low = Math.round(p / 10) * 10;
      var high = Math.round(p * 1.18 / 10) * 10;
      out.textContent = n(low) + ' – ' + n(high) + ' €';
    }
    ['calc-type', 'calc-dist', 'calc-fd', 'calc-fa', 'calc-ed', 'calc-ea', 'opt-emb', 'opt-dem', 'opt-piano']
      .forEach(function (id) { var el = $(id); if (el) el.addEventListener('change', compute); });
    compute();
  })();
</script>
