---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTA from './CTA.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { HighIntentPage } from '../data/highIntentPages';
import { SITE } from '../data/site.config';

const { page } = Astro.props as { page: HighIntentPage };
const canonical = `${SITE.url}/${page.slug}/`;
const quoteHref = `/devis/?${new URLSearchParams(page.quote).toString()}`;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: page.title,
  description: page.metaDescription,
  url: canonical,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'City', name: 'Carcassonne' },
};
---

<BaseLayout title={page.metaTitle} description={page.metaDescription} canonical={canonical}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: page.title }]} />

  <main>
    <section class="intent-hero">
      <div class="container intent-hero__inner">
        <div>
          <span class="section-label">{page.eyebrow}</span>
          <h1>{page.title}</h1>
          <p>{page.intro}</p>
          <div class="intent-hero__actions">
            <a class="btn btn--primary btn--lg" href={quoteHref}>Décrire mon projet</a>
            <a class="intent-phone" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          </div>
        </div>
        <nav class="intent-summary" aria-label="Sur cette page">
          <strong>Préparer une demande utile</strong>
          <a href="#besoins">Besoins concernés</a>
          <a href="#methode">Méthode de préparation</a>
          <a href="#informations">Informations à fournir</a>
          <a href="#questions">Questions fréquentes</a>
        </nav>
      </div>
    </section>

    <section class="section" id="besoins">
      <div class="container intent-intro">
        <div>
          <span class="section-label">Le point de départ</span>
          <h2>{page.contextTitle}</h2>
        </div>
        <div class="intent-copy">
          {page.context.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="container intent-cards">
        {page.profiles.map((profile, index) => (
          <article>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{profile.title}</h3>
            <p>{profile.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section intent-method" id="methode">
      <div class="container">
        <span class="section-label">Organisation</span>
        <h2>Une préparation en quatre étapes</h2>
        <div class="intent-steps">
          {page.method.map((step, index) => (
            <article>
              <span>{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="informations">
      <div class="container intent-check-layout">
        <div>
          <span class="section-label">Avant le devis</span>
          <h2>{page.checklistTitle}</h2>
          <p>{page.checklistIntro}</p>
          <ul class="intent-checklist">
            {page.checklist.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <aside class="intent-callout">
          <span>À vérifier</span>
          <h3>{page.callout.title}</h3>
          <p>{page.callout.text}</p>
          <a href={quoteHref}>Ajouter ces informations au devis →</a>
        </aside>
      </div>
    </section>

    <section class="section intent-faq" id="questions">
      <div class="container intent-faq__layout">
        <div><span class="section-label">Questions fréquentes</span><h2>Décider avec un périmètre clair</h2></div>
        <div>
          {page.faqs.map(item => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section intent-related">
      <div class="container">
        <span class="section-label">Pour aller plus loin</span>
        <h2>Guides et services associés</h2>
        <div class="intent-related__grid">
          {page.related.map(item => (
            <a href={item.href}><strong>{item.label}</strong><span>{item.text}</span><i aria-hidden="true">→</i></a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <CTA title="Un projet à chiffrer à Carcassonne ?" subtitle="Transmettez les adresses, l’inventaire et les contraintes d’accès pour recevoir une proposition adaptée au périmètre réel." btnHref={quoteHref} />
  <Footer />
</BaseLayout>

<style>
  .intent-hero { background: var(--color-navy); color: white; padding: 76px 0; }
  .intent-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 72px; align-items: center; }
  .intent-hero h1 { color: white; margin: 14px 0 18px; max-width: 850px; }
  .intent-hero p { color: rgba(255,255,255,.78); max-width: 760px; font-size: 1.08rem; line-height: 1.72; }
  .intent-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 30px; }
  .intent-phone { color: white; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .intent-summary { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius-lg); padding: 26px; display: grid; gap: 12px; }
  .intent-summary strong { color: var(--color-accent); margin-bottom: 4px; }
  .intent-summary a { color: rgba(255,255,255,.82); font-size: .9rem; border-bottom: 1px solid rgba(255,255,255,.1); padding-bottom: 10px; }
  .intent-summary a:last-child { border-bottom: 0; padding-bottom: 0; }
  .intent-intro { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; align-items: start; }
  .intent-intro h2 { margin-top: 12px; }
  .intent-copy p { color: var(--color-text); line-height: 1.78; margin-bottom: 18px; }
  .intent-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
  .intent-cards article { background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 28px; }
  .intent-cards article > span { color: var(--color-accent-deep); font-size: .75rem; font-weight: 800; letter-spacing: .1em; }
  .intent-cards h3 { font-size: 1.25rem; margin: 14px 0 10px; }
  .intent-cards p { color: var(--color-text-light); line-height: 1.65; }
  .intent-method { background: var(--color-bg-alt); }
  .intent-method h2 { margin: 12px 0 36px; }
  .intent-steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .intent-steps article { display: flex; gap: 18px; background: white; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 24px; }
  .intent-steps article > span { display: grid; place-items: center; flex: 0 0 42px; width: 42px; height: 42px; background: var(--color-navy); color: white; border-radius: 50%; font-weight: 800; }
  .intent-steps h3 { font-size: 1.08rem; margin-bottom: 7px; }
  .intent-steps p { color: var(--color-text-light); font-size: .92rem; line-height: 1.65; }
  .intent-check-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 72px; align-items: start; }
  .intent-check-layout h2 { margin: 12px 0 14px; }
  .intent-check-layout > div > p { color: var(--color-text-light); line-height: 1.7; max-width: 720px; }
  .intent-checklist { display: grid; gap: 12px; list-style: none; margin-top: 26px; }
  .intent-checklist li { position: relative; padding: 14px 18px 14px 46px; border: 1px solid var(--color-border); border-radius: var(--radius); }
  .intent-checklist li::before { content: '✓'; position: absolute; left: 18px; color: var(--color-accent-deep); font-weight: 800; }
  .intent-callout { background: var(--color-navy); color: white; border-radius: var(--radius-lg); padding: 30px; position: sticky; top: 100px; }
  .intent-callout > span { color: var(--color-accent); text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; font-weight: 800; }
  .intent-callout h3 { color: white; margin: 12px 0; font-size: 1.4rem; }
  .intent-callout p { color: rgba(255,255,255,.75); line-height: 1.68; }
  .intent-callout a { display: inline-block; color: white; margin-top: 20px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .intent-faq { background: var(--color-bg-alt); }
  .intent-faq__layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: 72px; }
  .intent-faq h2 { margin-top: 12px; }
  .intent-faq details { background: white; border: 1px solid var(--color-border); border-radius: var(--radius); margin-bottom: 10px; }
  .intent-faq summary { cursor: pointer; padding: 18px 22px; font-weight: 700; color: var(--color-navy); }
  .intent-faq details p { color: var(--color-text-light); line-height: 1.68; padding: 0 22px 20px; }
  .intent-related h2 { margin: 12px 0 28px; }
  .intent-related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .intent-related__grid a { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 24px; transition: transform .2s, border-color .2s; }
  .intent-related__grid a:hover { transform: translateY(-3px); border-color: var(--color-accent); }
  .intent-related__grid strong { color: var(--color-navy); }
  .intent-related__grid span { color: var(--color-text-light); font-size: .9rem; line-height: 1.55; }
  .intent-related__grid i { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--color-accent-deep); font-style: normal; font-size: 1.25rem; }
  @media (max-width: 900px) {
    .intent-hero__inner, .intent-intro, .intent-check-layout, .intent-faq__layout { grid-template-columns: 1fr; gap: 36px; }
    .intent-summary { display: none; }
    .intent-cards, .intent-related__grid { grid-template-columns: 1fr; }
    .intent-callout { position: static; }
  }
  @media (max-width: 680px) { .intent-steps { grid-template-columns: 1fr; } }
</style>
