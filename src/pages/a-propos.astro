---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../data/site.config';

const title = 'À propos | TransDéménage Carcassonne — Déménageur local depuis plusieurs années';
const description = `Découvrez TransDéménage Carcassonne : équipe locale, 2 fourgons, assurance incluse. SIRET ${SITE.siret}. Déménagement professionnel dans l'Aude.`;
---

<BaseLayout title={title} description={description}>
  <Header />

  <section class="about-hero">
    <div class="container">
      <span class="section-label">À propos</span>
      <h1>Une entreprise locale à votre service</h1>
      <p class="about-hero-sub">
        Fondée à Carcassonne, TransDéménage est une entreprise audoise de proximité,
        engagée pour un service de qualité à prix transparent.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">
      <div class="about-body">
        <h2>Notre histoire</h2>
        <p>TransDéménage Carcassonne est une entreprise de déménagement et de transport basée à Carcassonne, dans l'Aude. Depuis notre création, nous accompagnons les particuliers et les professionnels dans leurs projets de déménagement local, longue distance et international.</p>
        <p>Notre ancrage local est notre force. Nous connaissons l'Aude dans ses moindres détails : les ruelles médiévales de la Cité de Carcassonne, les zones pavillonnaires des communes environnantes, les axes de circulation, les contraintes saisonnières. Cette connaissance du terrain nous permet d'organiser des déménagements efficaces et sans stress.</p>

        <h2 style="margin-top:40px">Notre flotte</h2>
        <div class="fleet-grid">
          <div class="fleet-item">
            <PhotoPlaceholder
              aspectRatio="16/9"
              label="Fourgon 12 m³"
              description="fourgon-12m3.jpg"
              variant="light"
            />
            <div class="fleet-info">
              <h3>Fourgon 12 m³</h3>
              <p>Idéal pour les studios, T1, T2 et petits T3. Parfait pour les accès difficiles et les centres-villes.</p>
              <ul class="fleet-specs">
                <li>Volume : 12 m³</li>
                <li>Charge utile : 1 200 kg</li>
                <li>Hayon élévateur disponible</li>
              </ul>
            </div>
          </div>
          <div class="fleet-item">
            <PhotoPlaceholder
              aspectRatio="16/9"
              label="Fourgon 20 m³"
              description="fourgon-20m3.jpg"
              variant="light"
            />
            <div class="fleet-info">
              <h3>Fourgon 20 m³</h3>
              <p>Conçu pour les T3, T4, maisons et déménagements longue distance. Grande capacité de chargement.</p>
              <ul class="fleet-specs">
                <li>Volume : 20 m³</li>
                <li>Charge utile : 2 000 kg</li>
                <li>Hayon élévateur</li>
              </ul>
            </div>
          </div>
        </div>

        <h2 style="margin-top:40px">Notre équipe</h2>
        <p>Notre équipe est composée de professionnels formés et expérimentés. Manutentionnaires, chauffeurs, responsables d'opérations : chaque membre connaît son rôle et applique les meilleures pratiques du secteur.</p>
        <div class="team-placeholder">
          <PhotoPlaceholder
            aspectRatio="16/9"
            label="Notre équipe"
            description="equipe-hero.jpg"
            variant="light"
          />
        </div>

        <h2 style="margin-top:40px">Nos engagements</h2>
        <div class="engagements-grid">
          <div class="engagement-item">
            <div class="engagement-icon">💶</div>
            <h3>Prix transparents</h3>
            <p>Devis détaillé par écrit avant chaque prestation. Pas de frais cachés, pas de mauvaise surprise.</p>
          </div>
          <div class="engagement-item">
            <div class="engagement-icon">🛡️</div>
            <h3>Assurance incluse</h3>
            <p>Couverture grand standing jusqu'à 50 000 € incluse dans tous nos déménagements.</p>
          </div>
          <div class="engagement-item">
            <div class="engagement-icon">📍</div>
            <h3>Ancrage local</h3>
            <p>Entreprise audoise, nous intervenons en priorité dans notre région avec des équipes locales.</p>
          </div>
          <div class="engagement-item">
            <div class="engagement-icon">♻️</div>
            <h3>Éco-responsabilité</h3>
            <p>Nous orientons les déchets métaux et ferraille vers des filières de recyclage agréées.</p>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="about-info-block">
          <h3>Informations légales</h3>
          <dl class="about-dl">
            <dt>Raison sociale</dt>
            <dd>{SITE.name}</dd>
            <dt>SIRET</dt>
            <dd>{SITE.siret}</dd>
            <dt>Siège social</dt>
            <dd>{SITE.hq.city} ({SITE.hq.postalCode})</dd>
            <dt>Région</dt>
            <dd>{SITE.hq.region}</dd>
            <dt>Activité</dt>
            <dd>Déménagement et transport</dd>
          </dl>
        </div>

        <div class="about-contact-block">
          <h3>Nous contacter</h3>
          <a href={`tel:${SITE.phone}`} class="btn btn--primary" style="width:100%;justify-content:center;margin-bottom:10px">
            📞 {SITE.phoneDisplay}
          </a>
          <a href={`mailto:${SITE.email}`} class="btn btn--outline" style="width:100%;justify-content:center">
            ✉️ Email
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CTA />

  <Footer />
</BaseLayout>

<style>
  .about-hero {
    background: var(--color-navy);
    color: white;
    padding: 64px 0;
  }
  .about-hero h1 { color: white; margin: 12px 0; }
  .about-hero-sub { color: rgba(255,255,255,.75); font-size: 1.05rem; max-width: 540px; }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 56px;
    align-items: start;
  }
  .about-body h2 { margin-top: 16px; margin-bottom: 16px; }
  .about-body p { font-size: 1rem; line-height: 1.75; color: var(--color-text); margin-bottom: 16px; }

  .fleet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 20px; }
  .fleet-item { background: var(--color-bg-alt); border-radius: var(--radius); overflow: hidden; }
  .fleet-info { padding: 16px; }
  .fleet-info h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: var(--color-navy); margin-bottom: 6px; }
  .fleet-info p { font-size: .85rem; color: var(--color-text-light); line-height: 1.5; margin-bottom: 10px; }
  .fleet-specs { display: flex; flex-direction: column; gap: 3px; }
  .fleet-specs li { font-size: .8rem; color: var(--color-text-light); padding-left: 12px; position: relative; }
  .fleet-specs li::before { content: '·'; position: absolute; left: 0; }

  .team-placeholder { margin-top: 20px; border-radius: var(--radius); overflow: hidden; }

  .engagements-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  .engagement-item {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 20px;
  }
  .engagement-icon { font-size: 1.6rem; margin-bottom: 10px; }
  .engagement-item h3 { font-family: var(--font-sans); font-size: .95rem; font-weight: 700; color: var(--color-navy); margin-bottom: 6px; }
  .engagement-item p { font-size: .85rem; color: var(--color-text-light); line-height: 1.5; }

  .about-sidebar { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; }
  .about-info-block, .about-contact-block {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .about-info-block h3, .about-contact-block h3 {
    font-family: var(--font-sans);
    font-size: .9rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 16px;
  }
  .about-dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; }
  .about-dl dt { font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-light); }
  .about-dl dd { font-size: .88rem; color: var(--color-text); font-weight: 500; }

  @media (max-width: 900px) {
    .about-layout { grid-template-columns: 1fr; }
    .about-sidebar { position: static; }
    .fleet-grid { grid-template-columns: 1fr; }
    .engagements-grid { grid-template-columns: 1fr; }
  }
</style>
