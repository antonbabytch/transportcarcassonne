---
import { SITE } from '../data/site.config';

interface Props {
  title?: string;
  subtitle?: string;
  btnLabel?: string;
  btnHref?: string;
}

const {
  title = 'Prêt à déménager ?',
  subtitle = 'Demandez votre devis gratuit en 2 minutes. Réponse sous 2h.',
  btnLabel = 'Devis gratuit →',
  btnHref = '/contact',
} = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    <div class="cta-actions">
      <a href={btnHref} class="btn btn--white btn--lg">{btnLabel}</a>
      <a href={`tel:${SITE.phone}`} class="cta-phone">
        📞 {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--color-navy);
    padding: 64px 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .cta-text h2 {
    color: white;
    margin-bottom: 8px;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .cta-text p {
    color: rgba(255,255,255,.75);
    font-size: 1.05rem;
  }
  .cta-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .cta-phone {
    color: rgba(255,255,255,.85);
    font-size: 1.05rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color .15s;
  }
  .cta-phone:hover { color: white; }

  @media (max-width: 700px) {
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
