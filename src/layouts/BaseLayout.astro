---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import UrgentTransportPrompt from '../components/UrgentTransportPrompt.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.jpg',
  ogImageAlt = 'Transport Carcassonne — déménagement et transport dans l’Aude',
  ogType = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.url).href;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MovingCompany',
      '@id': `${SITE.url}/#business`,
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/brand/logo-google-business.png`,
        width: 720,
        height: 720,
      },
      image: `${SITE.url}/images/og-default.jpg`,
      telephone: SITE.phone,
      email: SITE.email,
      foundingDate: SITE.foundingDate,
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'SIRET',
        value: SITE.siret.replaceAll(' ', ''),
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.hq.streetAddress,
        addressLocality: SITE.hq.city,
        postalCode: SITE.hq.postalCode,
        addressRegion: SITE.hq.region,
        addressCountry: SITE.hq.country,
      },
      openingHoursSpecification: [{
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '00:00',
        closes: '23:59',
      }],
      areaServed: [
        { '@type': 'City', name: 'Carcassonne' },
        { '@type': 'AdministrativeArea', name: 'Aude' },
        { '@type': 'AdministrativeArea', name: 'Occitanie' },
      ],
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: SITE.phone,
        email: SITE.email,
        contactType: 'customer service',
        areaServed: 'FR',
        availableLanguage: ['fr'],
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services de déménagement et transport',
        itemListElement: [
          ...SERVICES.map(service => ({
            '@type': 'Offer',
            url: `${SITE.url}/services/${service.slug}/`,
            itemOffered: {
              '@type': 'Service',
              name: service.name,
              description: service.description,
            },
          })),
          {
            '@type': 'Offer',
            url: `${SITE.url}/transport-urgent-carcassonne/`,
            itemOffered: {
              '@type': 'Service',
              name: 'Transport express et urgent local à Carcassonne',
              description: 'Transport express local de meubles, électroménager, cartons ou petit volume aujourd’hui ou demain, selon disponibilité et faisabilité.',
            },
          },
          {
            '@type': 'Offer',
            url: `${SITE.url}/objet-oublie-transport-urgent-carcassonne/`,
            itemOffered: {
              '@type': 'Service',
              name: 'Transport urgent d’un objet ou document oublié',
              description: 'Course exceptionnelle depuis Carcassonne vers Toulouse, Montpellier, Perpignan ou ailleurs en région, quand un document ou un objet doit rejoindre quelqu’un dans la journée.',
            },
          },
          {
            '@type': 'Offer',
            url: `${SITE.url}/prestataire-livraison-magasins-carcassonne/`,
            itemOffered: {
              '@type': 'Service',
              name: 'Prestataire de livraison pour magasins à Carcassonne',
              description: 'Livraison locale des achats clients pour le compte d’un magasin : retrait, livraison à l’étage, bon de livraison signé et facture professionnelle.',
            },
          },
          {
            '@type': 'Offer',
            url: `${SITE.url}/livraison-meubles-magasins-carcassonne/`,
            itemOffered: {
              '@type': 'Service',
              name: 'Livraison de meubles depuis un magasin à Carcassonne',
              description: 'Retrait et livraison locale de meubles, électroménager et achats volumineux.',
            },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${SITE.url}/#business` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#business` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageURL,
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="theme-color" content="#15191C" />

    <!-- Enable scroll-reveal only when JS is on and motion is allowed (no-JS = content visible) -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Entity, website and page JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Google Consent Mode v2 — all denied by default; GA loads only after consent -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('js', new Date());

      var GA_ID = 'G-L13KXVLMMY';
      window.__loadGA = function () {
        if (window.__gaLoaded) return; window.__gaLoaded = true;
        var s = document.createElement('script');
        s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        gtag('config', GA_ID, { anonymize_ip: true });
      };
      window.__ccGrant = function () {
        try { localStorage.setItem('cc-consent', 'granted'); } catch (e) {}
        gtag('consent', 'update', { analytics_storage: 'granted' });
        window.__loadGA();
      };
      window.__ccDeny = function () {
        try { localStorage.setItem('cc-consent', 'denied'); } catch (e) {}
        gtag('consent', 'update', { analytics_storage: 'denied' });
      };
      try {
        if (localStorage.getItem('cc-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
          window.__loadGA();
        }
      } catch (e) {}
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />

    <UrgentTransportPrompt />

    <!-- Floating CTA buttons (mobile) -->
    <div class="float-cta">
      <a
        href={`https://wa.me/${SITE.phoneWhatsapp}`}
        class="float-cta__btn float-cta__btn--wa"
        aria-label="WhatsApp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.556 4.121 1.523 5.851L.057 23.882a.5.5 0 0 0 .606.607l6.044-1.457A11.942 11.942 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 0 1-4.998-1.368l-.357-.213-3.709.895.928-3.595-.234-.369A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
        </svg>
      </a>
      <a href={`tel:${SITE.phone}`} class="float-cta__btn float-cta__btn--phone" aria-label="Appeler">
        <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
      </a>
    </div>

    <!-- Conversion tracking events -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Phone clicks
        document.querySelectorAll('a[href^="tel:"]').forEach(el => {
          el.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'phone_click', {
                event_category: 'engagement',
                event_label: el.dataset.source || 'page',
                phone_number: el.getAttribute('href').replace('tel:', '')
              });
            }
          });
        });

        // WhatsApp clicks
        document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp.com"]').forEach(el => {
          el.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'whatsapp_click', {
                event_category: 'engagement',
                event_label: el.dataset.source || 'page'
              });
            }
          });
        });

        // Form submits (Netlify forms)
        document.querySelectorAll('form[data-netlify="true"], form[name]').forEach(form => {
          form.addEventListener('submit', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'form_submit', {
                event_category: 'lead',
                event_label: form.getAttribute('name') || 'unknown_form'
              });
            }
          });
        });
      });
    </script>

    <!-- Scroll-reveal engine (Intersection Observer) — all pages -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        if (!root.classList.contains('anim') || !('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target;
            const i = parseInt(el.getAttribute('data-i') || '0', 10);
            el.style.transitionDelay = Math.min(i * 70, 420) + 'ms';
            el.classList.add('is-visible');
            io.unobserve(el);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      })();
    </script>

    <!-- Cookie consent banner (CNIL / Consent Mode v2) -->
    <style is:global>
      .cc-banner { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 1000; max-width: 720px; margin: 0 auto;
        background: var(--bg-dark, #15191C); color: var(--text-on-dark, #FAFAF7); border: 1px solid var(--line-dark, #2D3338);
        border-radius: 12px; padding: 18px 20px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap;
        box-shadow: 0 24px 60px -18px rgba(0,0,0,.6); }
      .cc-banner[hidden] { display: none; }
      .cc-text { font-size: 13.5px; line-height: 1.55; color: var(--text-on-dark-muted, #9CA3AC); flex: 1; min-width: 240px; margin: 0; }
      .cc-text a { color: #D09A67; text-decoration: underline; text-underline-offset: 2px; }
      .cc-actions { display: flex; gap: 10px; flex-shrink: 0; }
      .cc-btn { padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1px solid transparent; font-family: inherit; }
      .cc-btn--primary { background: var(--accent, #A8703F); color: #15100A; border-color: var(--accent, #A8703F); }
      .cc-btn--ghost { background: transparent; color: var(--text-on-dark, #FAFAF7); border-color: var(--line-dark, #2D3338); }
      .cc-btn--ghost:hover { border-color: var(--accent, #A8703F); }
      @media (max-width: 560px) { .cc-banner { flex-direction: column; align-items: stretch; } .cc-actions { justify-content: flex-end; } }
    </style>
    <div class="cc-banner" id="cc-banner" role="dialog" aria-label="Consentement aux cookies" hidden>
      <p class="cc-text">
        Nous utilisons des cookies de mesure d'audience (Google Analytics) pour améliorer le site.
        Ils ne sont déposés qu'avec votre accord. <a href="/politique-confidentialite/">En savoir plus</a>.
      </p>
      <div class="cc-actions">
        <button type="button" class="cc-btn cc-btn--ghost" id="cc-refuse">Refuser</button>
        <button type="button" class="cc-btn cc-btn--primary" id="cc-accept">Accepter</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById('cc-banner'); if (!b) return;
        var stored = null; try { stored = localStorage.getItem('cc-consent'); } catch (e) {}
        if (!stored) b.removeAttribute('hidden');
        var a = document.getElementById('cc-accept'), r = document.getElementById('cc-refuse');
        a && a.addEventListener('click', function () { window.__ccGrant && window.__ccGrant(); b.setAttribute('hidden', ''); });
        r && r.addEventListener('click', function () { window.__ccDeny && window.__ccDeny(); b.setAttribute('hidden', ''); });
        window.__ccManage = function () { b.removeAttribute('hidden'); };
      })();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  @font-face {
    font-family: 'Inter';
    src: url('/fonts/inter-latin.woff2') format('woff2');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'Instrument Serif';
    src: url('/fonts/instrument-serif-latin.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Instrument Serif';
    src: url('/fonts/instrument-serif-italic-latin.woff2') format('woff2');
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }

  :root {
    /* ─── MAISON FORTE — unified design tokens (synced with debarras-carcassonne.fr) ─── */
    --bg: #FAFAF7;
    --bg-card: #FFFFFF;
    --bg-soft: #F2F0EB;
    --bg-dark: #15191C;
    --bg-dark-alt: #1E2326;
    --text: #15191C;
    --text-muted: #5C6470;
    --text-on-dark: #FAFAF7;
    --text-on-dark-muted: #9CA3AC;
    --accent: #A8703F;
    --accent-deep: #6B4422;
    --accent-soft: rgba(168, 112, 63, 0.08);
    --line: #E5E1D8;
    --line-strong: #15191C;
    --line-dark: #2D3338;

    /* ─── Legacy aliases — keep existing components working ─── */
    --color-navy: var(--bg-dark);
    --color-navy-dark: #0c0f11;
    --color-navy-light: #2a3338;
    --color-accent: var(--accent);
    --color-accent-dark: var(--accent-deep);
    --color-bg: var(--bg);
    --color-bg-alt: var(--bg-soft);
    --color-text: var(--text);
    --color-text-light: var(--text-muted);
    --color-border: var(--line);
    --color-white: var(--bg-card);
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-display: 'Instrument Serif', Georgia, serif;
    --radius: 4px;
    --radius-lg: 12px;
    --shadow-sm: 0 1px 3px rgba(21, 25, 28, 0.06);
    --shadow: 0 4px 16px rgba(21, 25, 28, 0.08);
    --shadow-lg: 0 16px 40px rgba(21, 25, 28, 0.12);
    --max-width: 1160px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  h1, h2, h3 { font-family: var(--font-display); line-height: 1.2; color: var(--color-navy); }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); }
  h3 { font-size: clamp(1.2rem, 2.5vw, 1.6rem); }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  ul { list-style: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all .2s ease;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn--primary {
    background: var(--color-accent);
    color: #15100A;
  }
  .btn--primary:hover { background: var(--color-accent-dark); transform: translateY(-1px); box-shadow: var(--shadow); }
  .btn--outline {
    background: transparent;
    color: var(--color-navy);
    border: 2px solid var(--color-navy);
  }
  .btn--outline:hover { background: var(--color-navy); color: var(--color-white); }
  .btn--white {
    background: var(--color-white);
    color: var(--color-navy);
  }
  .btn--white:hover { background: var(--color-bg); transform: translateY(-1px); }
  .btn--lg { padding: 18px 36px; font-size: 1.1rem; }

  .section { padding: 80px 0; }
  .section--alt { background: var(--color-bg-alt); }
  .section--navy { background: var(--color-navy); color: var(--color-white); }
  .section--navy h2, .section--navy h3 { color: var(--color-white); }

  .section-label {
    display: inline-block;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 12px;
  }
  .section-title { margin-bottom: 16px; }
  .section-subtitle { font-size: 1.1rem; color: var(--color-text-light); max-width: 600px; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  @media (max-width: 900px) {
    .grid-3 { grid-template-columns: 1fr 1fr; }
    .grid-4 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    .section { padding: 56px 0; }
    .container { padding: 0 16px; }
  }

  /* Floating CTA */
  .float-cta {
    position: fixed;
    bottom: 24px;
    right: 20px;
    z-index: 900;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .float-cta__btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    transition: transform .2s ease;
  }
  .float-cta__btn:hover { transform: scale(1.1); }
  .float-cta__btn--wa { background: #25D366; color: white; }
  .float-cta__btn--phone { background: var(--color-accent); color: white; }

  @media (min-width: 1024px) { .float-cta { display: none; } }

  /* ───────────────────────── MOTION LAYER (global, all pages) ───────────────────────── */
  :root {
    --ease-out: cubic-bezier(.22, .61, .36, 1);
    --ease-soft: cubic-bezier(.4, 0, .2, 1);
    --shadow-soft: 0 18px 40px -14px rgba(0, 0, 0, .55);
    --shadow-soft-light: 0 18px 38px -16px rgba(21, 25, 28, .22);
  }

  /* Scroll-reveal — active only when <html class="anim"> (JS on, motion allowed) */
  .anim .reveal {
    opacity: 0;
    transform: translateY(22px);
