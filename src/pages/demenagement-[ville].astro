---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTA from '../components/CTA.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CITIES } from '../data/cities';
import { SERVICES } from '../data/services';
import { SITE } from '../data/site.config';

export function getStaticPaths() {
  return CITIES.map(c => ({ params: { ville: c.slug }, props: { city: c } }));
}

const { city } = Astro.props;

const isBase = city.distance === 0;
const distanceText = isBase ? 'notre ville de base' : `à ${city.distance} km de Carcassonne`;

const title = isBase
  ? 'Déménager à Carcassonne : quartiers, accès et tarifs'
  : `Déménagement à ${city.name} | Accès et devis`;
const description = isBase
  ? `Guide pratique pour déménager à Carcassonne : quartiers, accès à la Cité et à la Bastide, stationnement, prestations et tarifs. Devis gratuit au ${SITE.phoneDisplay}.`
  : `Préparer un déménagement à ${city.name} (${city.distance} km de Carcassonne) : accès, stationnement, transport de meubles et demande de devis personnalisée. ${SITE.phoneDisplay}`;
const pageHeading = isBase ? 'Déménager à Carcassonne' : `Déménagement à ${city.name}`;

const cityContent: Record<string, { intro: string; specifics: string; note?: string }> = {
  carcassonne: {
    intro: `Carcassonne, chef-lieu de l'Aude et ville de base indiquée par Transport Carcassonne, présente des configurations variées : ruelles de la Cité, immeubles du centre-ville, quartiers résidentiels et zones pavillonnaires périphériques.`,
    specifics: `Un déménagement à Carcassonne peut nécessiter d’anticiper les zones piétonnes, les règles de stationnement et les accès limités dans la Cité historique. Ces points doivent être vérifiés pour chaque adresse avant le devis.`,
  },
  trebes: {
    intro: `Trèbes est une commune de l'Aude située à environ 8 km à l'est de Carcassonne, le long du Canal du Midi. Une demande dans ce secteur peut être étudiée selon le trajet et le planning.`,
    specifics: `À Trèbes, les maisons individuelles et les lotissements peuvent offrir des accès plus directs, mais le stationnement et le portage restent à vérifier à chaque adresse.`,
  },
  limoux: {
    intro: `Limoux, sous-préfecture de l'Aude à 25 km au sud de Carcassonne dans la vallée de l'Aude, est un bassin de vie important avec ses 9 700 habitants. Connue pour la Blanquette de Limoux et son carnaval, la ville attire résidents permanents et résidences secondaires.`,
    specifics: `Le centre historique de Limoux, avec ses ruelles et son architecture traditionnelle, peut présenter des contraintes de stationnement et de portage à signaler avant l’estimation.`,
  },
  castelnaudary: {
    intro: `Castelnaudary, sous-préfecture de l'Aude, se situe à environ 38 km à l'ouest de Carcassonne sur l'axe Toulouse-Méditerranée. Une demande dans ce secteur doit être confirmée selon le trajet et les disponibilités.`,
    specifics: `Castelnaudary est desservie par l'autoroute A61 et présente un tissu mixte : maisons de ville dans le centre historique et quartiers pavillonnaires en périphérie. Le véhicule et le portage sont à adapter à l’adresse.`,
  },
  narbonne: {
    intro: `Narbonne se situe à environ 60 km de Carcassonne, au-delà du rayon de 50 km affiché comme zone principale. Toute demande vers ou depuis Narbonne doit donc faire l’objet d’une vérification de faisabilité.`,
    specifics: `Le prix éventuel dépend du volume, du trajet et des accès, notamment dans les copropriétés et les secteurs où le stationnement est contraint.`,
    note: 'Zone et disponibilité à confirmer. Le devis personnalisé précise le trajet et ses éventuels frais.',
  },
  'lezignan-corbieres': {
    intro: `Lézignan-Corbières, cœur du vignoble des Corbières avec ses 11 000 habitants, est situé à 35 km au nord-est de Carcassonne. Cette ville viticole en plein développement attire de nouveaux résidents chaque année.`,
    specifics: `Lézignan-Corbières présente un parc immobilier varié : maisons vigneronnes, pavillons récents et appartements en copropriété. Les caves, dépendances et accès doivent être décrits avant le devis.`,
  },
  bram: {
    intro: `Bram, commune audoise de 3 500 habitants à 23 km à l'ouest de Carcassonne sur la plaine lauragaise, est un village typique du Lauragais avec son plan circulaire médiéval unique.`,
    specifics: `Le centre historique circulaire de Bram peut présenter des particularités d'accès. Le point de stationnement, le portage et le véhicule doivent être étudiés selon l’adresse.`,
  },
  capendu: {
    intro: `Capendu, village de 1 500 habitants à 18 km au sud-est de Carcassonne, est idéalement situé entre Carcassonne et Narbonne. Le village offre un cadre de vie tranquille très prisé des familles.`,
    specifics: `Capendu dispose d'un tissu résidentiel principalement composé de maisons individuelles et de mas. Pour les biens isolés, l’état du chemin et l’espace de manœuvre doivent être vérifiés.`,
  },
  pezens: {
    intro: `Pezens, commune rurale de 1 700 habitants à 10 km au nord-ouest de Carcassonne, est une commune résidentielle appréciée pour sa proximité avec Carcassonne tout en offrant un cadre de vie plus calme.`,
    specifics: `Pezens est proche de Carcassonne. Le prix d’un projet dépend néanmoins du volume, des accès, du trajet complet et du créneau retenu.`,
  },
  alzonne: {
    intro: `Alzonne, village de 1 400 habitants à 15 km à l'ouest de Carcassonne sur la plaine lauragaise, est une commune résidentielle tranquille avec un tissu pavillonnaire bien développé.`,
    specifics: `Le tissu résidentiel d'Alzonne est principalement composé de maisons individuelles avec jardin. L’accès réel, le stationnement et les contraintes de manutention restent à vérifier pour chaque adresse.`,
  },
};

const content = cityContent[city.slug] ?? {
  intro: `${city.name} est une commune de l'Aude située ${distanceText}. Une demande de déménagement dans ce secteur peut être étudiée selon le trajet et les disponibilités.`,
  specifics: `Les accès, le stationnement, les étages, le volume et le créneau doivent être vérifiés pour chaque logement avant l’émission du devis.`,
};

type Extra = { quartiers: string[]; acces: string; routes: { to: string; price: string }[]; faq: { q: string; a: string }[] };
const cityExtra: Record<string, Extra> = {
  carcassonne: {
    quartiers: ['La Cité', 'Bastide Saint-Louis', 'Grazailles', 'La Conte', 'Montredon', 'Maquens', 'Le Viguier'],
    acces: "Zones piétonnes et stationnement réglementé autour de la Cité et de la Bastide : les points de chargement doivent être repérés et une autorisation de voirie peut être nécessaire.",
    routes: [{ to: 'Toulouse', price: 'dès 600 €' }, { to: 'Narbonne', price: 'dès 350 €' }, { to: 'Montpellier', price: 'dès 750 €' }],
    faq: [{ q: 'Pouvez-vous déménager dans la Cité médiévale ?', a: "La faisabilité doit être vérifiée selon l'adresse, les restrictions d'accès et les autorisations. Le portage ou un véhicule adapté sont à prévoir au devis si nécessaire." }],
  },
  trebes: {
    quartiers: ['Centre / Canal du Midi', 'Les Bordes', 'Millepetit', 'Lotissements est'],
    acces: "Urbanisme accessible : maisons individuelles avec accès direct et voiries larges dans les lotissements. Stationnement aisé au pied du logement dans la majorité des cas.",
    routes: [{ to: 'Carcassonne', price: 'dès 350 €' }, { to: 'Narbonne', price: 'dès 400 €' }, { to: 'Toulouse', price: 'dès 650 €' }],
    faq: [{ q: 'Intervenez-vous le long du Canal du Midi à Trèbes ?', a: 'Une demande peut être étudiée. Pour les habitations proches des berges, transmettez des photos et les dimensions d’accès afin de confirmer le véhicule et le portage.' }],
  },
  limoux: {
    quartiers: ['Centre / Place de la République', 'Flassian', 'Saint-Antoine', 'Pont Neuf'],
    acces: "Centre historique aux ruelles étroites : le point de stationnement et la distance de portage doivent être vérifiés. Les quartiers récents peuvent présenter des accès différents selon l’adresse.",
    routes: [{ to: 'Carcassonne', price: 'dès 380 €' }, { to: 'Toulouse', price: 'dès 700 €' }, { to: 'Perpignan', price: 'dès 650 €' }],
    faq: [{ q: 'Déménagez-vous dans le centre ancien de Limoux ?', a: 'La faisabilité dépend de l’adresse. Les ruelles autour de la Place de la République peuvent demander une organisation particulière du stationnement et du portage à préciser au devis.' }],
  },
  castelnaudary: {
    quartiers: ['Centre / Grand Bassin', 'En Tourre', 'La Capelle', 'Zones pavillonnaires'],
    acces: "Ville desservie par l'A61. Le centre historique comporte des rues plus étroites ; le véhicule et le stationnement doivent être vérifiés selon l’adresse.",
    routes: [{ to: 'Carcassonne', price: 'dès 420 €' }, { to: 'Toulouse', price: 'dès 550 €' }, { to: 'Castres', price: 'dès 600 €' }],
    faq: [{ q: 'Comment estimer le trajet Castelnaudary–Toulouse ?', a: 'Le repère affiché est indicatif. Le devis tient compte du volume, des accès, du créneau, du trajet et des éventuels frais associés.' }],
  },
  narbonne: {
    quartiers: ['Centre / Les Halles', 'Razimbaud', 'Saint-Jean Saint-Pierre', 'Bourg', 'Cité'],
    acces: "Les copropriétés avec étages et le stationnement contraint en centre peuvent nécessiter une autorisation ou une solution de levage, à étudier avant le devis.",
    routes: [{ to: 'Carcassonne', price: 'dès 400 €' }, { to: 'Montpellier', price: 'dès 600 €' }, { to: 'Perpignan', price: 'dès 550 €' }],
    faq: [{ q: 'Narbonne est à 60 km : y a-t-il un supplément ?', a: 'Un léger supplément de distance peut s\'appliquer selon le volume. Nous établissons un devis personnalisé pour Narbonne et ses quartiers.' }],
  },
  'lezignan-corbieres': {
    quartiers: ['Centre / Cours de la République', 'Avenue des Vignerons', 'Quartiers récents'],
    acces: "Parc immobilier varié (maisons vigneronnes, pavillons, copropriétés). Certaines ruelles du cœur ancien demandent une vérification préalable du stationnement et du portage.",
    routes: [{ to: 'Carcassonne', price: 'dès 420 €' }, { to: 'Narbonne', price: 'dès 350 €' }, { to: 'Béziers', price: 'dès 500 €' }],
    faq: [{ q: 'Déménagez-vous les maisons vigneronnes des Corbières ?', a: 'Une demande peut être étudiée. Les caves et dépendances doivent être signalées afin de chiffrer la manutention et les accès.' }],
  },
  bram: {
    quartiers: ['Circulade (centre médiéval)', 'Périphérie pavillonnaire', 'Route de Fanjeaux'],
    acces: "Le plan circulaire (circulade) du centre présente des ruelles concentriques étroites : stationnement et portage organisés au plus proche. Périphérie d'accès facile.",
    routes: [{ to: 'Carcassonne', price: 'dès 380 €' }, { to: 'Castelnaudary', price: 'dès 350 €' }, { to: 'Toulouse', price: 'dès 600 €' }],
    faq: [{ q: 'Comment gérez-vous l\'accès à la circulade de Bram ?', a: 'Nous repérons le point de chargement le plus proche et adaptons le véhicule ; le portage dans les ruelles concentriques est prévu au devis.' }],
  },
  capendu: {
    quartiers: ['Centre village', 'Lotissements', 'Mas et maisons isolées'],
    acces: "Maisons individuelles et mas : l’état des chemins, les dimensions d’accès et l’espace de manœuvre doivent être vérifiés pour choisir un véhicule adapté.",
    routes: [{ to: 'Carcassonne', price: 'dès 350 €' }, { to: 'Narbonne', price: 'dès 350 €' }, { to: 'Lézignan-Corbières', price: 'dès 330 €' }],
    faq: [{ q: 'Intervenez-vous pour les mas isolés autour de Capendu ?', a: 'La faisabilité est étudiée à partir de l’adresse et des accès. Les chemins et l’éloignement éventuel doivent être décrits et chiffrés au devis.' }],
  },
  pezens: {
    quartiers: ['Centre village', 'Lotissements', 'Route de Toulouse'],
    acces: "Commune proche de Carcassonne. Les accès, le stationnement et le trajet complet restent à vérifier pour chaque projet.",
    routes: [{ to: 'Carcassonne', price: 'dès 320 €' }, { to: 'Toulouse', price: 'dès 600 €' }, { to: 'Castelnaudary', price: 'dès 380 €' }],
    faq: [{ q: 'Pezens étant proche de Carcassonne, le tarif est-il réduit ?', a: 'La distance est un facteur parmi d’autres. Le prix dépend aussi du volume, des accès, du créneau et des services retenus ; seul le devis le confirme.' }],
  },
  alzonne: {
    quartiers: ['Centre village', 'Zones pavillonnaires', 'Plaine lauragaise'],
    acces: "Tissu pavillonnaire avec maisons à jardin facilitant les opérations. Accès directs et stationnement aisé dans la plupart des cas.",
    routes: [{ to: 'Carcassonne', price: 'dès 350 €' }, { to: 'Bram', price: 'dès 320 €' }, { to: 'Toulouse', price: 'dès 600 €' }],
    faq: [{ q: 'Faut-il réserver à l\'avance pour Alzonne ?', a: 'Il est conseillé de transmettre la date souhaitée le plus tôt possible, notamment en été et en fin de mois. Aucun délai n’est garanti avant confirmation du créneau.' }],
  },
};
const extra: Extra | undefined = cityExtra[city.slug];

const nearby = CITIES
  .filter(c => c.slug !== city.slug)
  .sort((a, b) => Math.abs(a.distance - city.distance) - Math.abs(b.distance - city.distance))
  .slice(0, 4);

const cityFaq = extra?.faq ?? [];
---

<BaseLayout
  title={title}
  description={description}
  preloadImage="/images/demenagement-ville.webp"
  ogImage="/images/demenagement-ville.webp"
  ogImageAlt={`Déménagement à ${city.name} avec Transport Carcassonne`}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE.url}/demenagement-${city.slug}/#service`,
    name: pageHeading,
    serviceType: 'Service de déménagement',
    url: `${SITE.url}/demenagement-${city.slug}/`,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: {
      '@type': 'City',
      name: city.name,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Aude' },
    },
  })} />
  {cityFaq.length > 0 && (
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: cityFaq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    })} />
  )}
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: `Déménagement ${city.name}` }]} />

  <!-- Hero -->
  <section class="city-hero">
    <div class="city-hero-bg"></div>
    <div class="container city-hero-inner">
      <div class="city-hero-content">
        <div class="city-badge">
          📍 {isBase ? 'Notre ville' : `${city.distance} km de Carcassonne`}
        </div>
        <h1>{pageHeading}</h1>
        <p class="city-hero-sub">
          Une demande de déménagement à {city.name} peut être étudiée depuis Carcassonne.
          Le périmètre, les moyens, le créneau et le prix sont confirmés sur devis.
        </p>
        <div class="city-hero-ctas">
          <a href={`/devis/?depart=${encodeURIComponent(city.name)}&source=ville`} class="btn btn--primary btn--lg">Devis gratuit →</a>
          <a href={`tel:${SITE.phone}`} class="btn btn--white btn--lg">📞 {SITE.phoneDisplay}</a>
        </div>
      </div>
      <div class="city-hero-media">
        <img src="/images/demenagement-ville.webp" alt={`Déménagement à ${city.name} — Transport Carcassonne`} width="1200" height="896" loading="eager" fetchpriority="high" decoding="async" style="width:100%;height:auto;display:block;border-radius:12px" />
      </div>
    </div>
  </section>

  <!-- City description -->
  <section class="section">
    <div class="container city-layout">
      <div class="city-body">
        <h2>Votre déménageur à {city.name}</h2>
        <p class="city-para">{content.intro}</p>
        <p class="city-para">{content.specifics}</p>

        {content.note && (
          <div class="city-notice">
            <strong>ℹ️ À noter :</strong> {content.note}
          </div>
        )}

        <!-- Key facts -->
        <div class="city-facts">
          <div class="city-fact">
            <strong>{city.population.toLocaleString('fr')}</strong>
            <span>habitants</span>
          </div>
          <div class="city-fact">
            <strong>{isBase ? 'Base' : `${city.distance} km`}</strong>
            <span>de Carcassonne</span>
          </div>
          <div class="city-fact">
            <strong>Aude (11)</strong>
            <span>Occitanie</span>
          </div>
          <div class="city-fact">
            <strong>En ligne</strong>
            <span>demande de devis</span>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="city-sidebar">
        <div class="city-cta-block">
          <h3>Devis pour {city.name}</h3>
          <p>Décrivez votre projet ; la demande est étudiée selon les disponibilités.</p>
          <a href={`/devis/?depart=${encodeURIComponent(city.name)}&source=ville`} class="btn btn--primary" style="width:100%;justify-content:center;margin-bottom:10px">
            Demander un devis
          </a>
          <a href={`tel:${SITE.phone}`} class="btn btn--outline" style="width:100%;justify-content:center">
            📞 {SITE.phoneDisplay}
          </a>
        </div>

        <div class="city-trust">
          <div class="city-trust-item">📍 Projet étudié depuis Carcassonne</div>
          <div class="city-trust-item">🛡️ Protections précisées au devis</div>
          <div class="city-trust-item">💶 Périmètre et prix écrits</div>
          <div class="city-trust-item">📅 Créneau confirmé selon planning</div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Unique local content -->
  {extra && (
    <section class="section section--alt city-extra">
      <div class="container">
        <div class="ce-grid">
          <div class="ce-quartiers">
            <span class="section-label">Repères locaux</span>
            <h2>Quartiers à anticiper à {city.name}</h2>
            <div class="ce-chips">
              {extra.quartiers.map(q => <span class="ce-chip">{q}</span>)}
            </div>
            <p class="ce-acces"><strong>Accès &amp; stationnement —</strong> {extra.acces}</p>
          </div>
          <div class="ce-routes">
            <h3>Repères indicatifs depuis {city.name}</h3>
            <p>Exemples non contractuels : le prix réel est confirmé sur devis.</p>
            <ul>
              {extra.routes.map(r => (
                <li><span>{city.name} → {r.to}</span><strong>{r.price}</strong></li>
              ))}
            </ul>
            <a href="/tarifs" class="ce-link">Voir tous nos tarifs →</a>
          </div>
        </div>

        {cityFaq.length > 0 && (
          <div class="ce-faq">
            <h3>Questions fréquentes — {city.name}</h3>
            {cityFaq.map(f => (
              <details class="ce-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>
            ))}
          </div>
        )}

        <div class="ce-nearby">
          <h3>Communes voisines</h3>
          <div class="ce-nearby-row">
            {nearby.map(c => (
              <a href={`/demenagement-${c.slug}`}>Déménagement {c.name}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Services available -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Nos services à {city.name}</span>
        <h2 class="section-title">Prestations à étudier selon votre projet</h2>
      </div>
      <div class="grid-3">
        {SERVICES.map(s => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <QuoteForm
    title={`Devis déménagement ${city.name}`}
    subtitle={`Décrivez votre projet à ${city.name} · réponse selon disponibilités`}
    prefilledCity={city.name}
  />

  <CTA
    title={`Déménagement à ${city.name} ?`}
    subtitle="Indiquez les adresses, le volume, les accès et la date souhaitée pour une proposition personnalisée."
  />

  <Footer />
</BaseLayout>

<style>
  .city-hero {
    background: var(--color-navy);
    color: white;
    padding: 72px 0;
    position: relative;
    overflow: hidden;
  }
  .city-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 40%, rgba(234,125,58,.12) 0%, transparent 60%);
    pointer-events: none;
  }
  .city-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .city-badge {
    display: inline-block;
    background: rgba(234,125,58,.2);
    color: var(--color-accent);
    border: 1px solid rgba(234,125,58,.3);
    font-size: .78rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 100px;
    margin-bottom: 18px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .city-hero-content h1 { color: white; margin-bottom: 16px; }
  .city-hero-sub { color: rgba(255,255,255,.8); font-size: 1.05rem; line-height: 1.6; margin-bottom: 32px; }
  .city-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .city-hero-media { border-radius: var(--radius-lg); overflow: hidden; }

  .city-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 56px;
    align-items: start;
  }
  .city-body h2 { margin-bottom: 20px; }
  .city-para {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .city-notice {
    background: rgba(234,125,58,.08);
    border-left: 3px solid var(--color-accent);
    padding: 14px 18px;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: .9rem;
    color: var(--color-text);
    margin: 20px 0;
  }
  .city-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
    padding: 24px;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
  }
  .city-fact { text-align: center; }
  .city-fact strong { display: block; font-family: var(--font-display); font-size: 1.3rem; color: var(--color-navy); }
  .city-fact span { font-size: .75rem; color: var(--color-text-light); }

  .city-sidebar { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; }
  .city-cta-block {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow);
  }
  .city-cta-block h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 6px;
  }
