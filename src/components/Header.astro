---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
---

<nav class="site-nav">
  <div class="container nav-inner">

    <a href="/" class="logo">
      <img
        class="logo-mark"
        src="/brand/logo-mark.svg"
        width="46"
        height="46"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">
        <strong>Transport Carcassonne</strong>
        <small>Déménagement &amp; transport</small>
      </span>
    </a>

    <ul class="nav-links">
      <li><a href="/services/demenagement-local">Déménagement</a></li>
      <li><a href="/petit-demenagement">Petit déménagement</a></li>
      <li><a href="/transport-urgent-carcassonne" class="nav-urgent">Express 24–48 h</a></li>
      <li><a href="/tarifs">Tarifs</a></li>
      <li><a href="/outils-demenagement">Outils</a></li>
      <li><a href="/blog">Conseils</a></li>
    </ul>

    <div class="nav-cta">
      <a href={`tel:${SITE.phone}`} class="nav-phone">{SITE.phoneDisplay}</a>
      <a href="/devis/?source=navigation" class="btn btn-primary">Devis gratuit</a>
    </div>

    <button
      class="burger"
      id="burger-btn"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner">

    <nav class="mobile-section">
      <p class="mobile-section-title">Navigation</p>
      <ul>
        <li><a href="/" class="mobile-menu-link">Accueil</a></li>
        <li><a href="/transport-urgent-carcassonne" class="mobile-menu-link">Transport express 24–48 h</a></li>
        <li><a href="/livraison-meubles-magasins-carcassonne" class="mobile-menu-link">Livraison depuis un magasin</a></li>
        <li><a href="/tarifs" class="mobile-menu-link">Tarifs</a></li>
        <li><a href="/formules" class="mobile-menu-link">Formules</a></li>
        <li><a href="/comment-ca-marche" class="mobile-menu-link">Méthode</a></li>
        <li><a href="/realisations" class="mobile-menu-link">Réalisations</a></li>
        <li><a href="/nos-garanties" class="mobile-menu-link">Nos garanties</a></li>
        <li><a href="/outils-demenagement" class="mobile-menu-link">Outils gratuits</a></li>
        <li><a href="/blog" class="mobile-menu-link">Conseils</a></li>
        <li><a href="/a-propos" class="mobile-menu-link">À propos</a></li>
        <li><a href="/contact" class="mobile-menu-link">Contact</a></li>
      </ul>
    </nav>

    <nav class="mobile-section">
      <p class="mobile-section-title">Nos services</p>
      <ul>
        <li><a href="/petit-demenagement" class="mobile-menu-link">Petit déménagement</a></li>
        {SERVICES.map(s => (
          <li><a href={`/services/${s.slug}`} class="mobile-menu-link">{s.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="mobile-section">
      <p class="mobile-section-title">Notre zone</p>
      <ul>
        {CITIES.slice(0, 5).map(c => (
          <li><a href={`/demenagement-${c.slug}`} class="mobile-menu-link">{c.name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-cta">
      <a href={`tel:${SITE.phone}`} class="btn btn-primary btn-large mobile-menu-link">
        📞 {SITE.phoneDisplay}
      </a>
      <a href="/devis/?source=menu-mobile" class="btn btn-outline-light btn-large mobile-menu-link">
        Devis gratuit
      </a>
    </div>

  </div>
</div>

<style>
  /* ── Nav base ─────────────────────────────── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border-bottom: 1px solid var(--line-dark);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    gap: 24px;
  }

  /* ── Logo ─────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--text-on-dark);
    flex-shrink: 0;
  }

  .logo-mark {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    display: block;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-text strong {
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.01em;
  }

  .logo-text small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 3px;
    font-weight: 400;
  }

  /* ── Desktop nav links ────────────────────── */
  .nav-links {
    display: flex;
    gap: 24px;
    list-style: none;
  }

  .nav-links a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent);
  }
  .nav-links .nav-urgent { color: var(--accent); font-weight: 700; }

  /* ── Desktop CTA ──────────────────────────── */
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .nav-phone {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-phone:hover {
    color: var(--accent);
  }

  /* ── Buttons (locally scoped — премиум-стиль ─ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-dark);
    border-color: var(--accent);
  }
  .btn-primary:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: var(--text-on-dark);
  }

  .btn-outline-light {
    background: transparent;
    color: var(--text-on-dark);
    border-color: var(--text-on-dark);
  }
  .btn-outline-light:hover {
    background: var(--text-on-dark);
    color: var(--bg-dark);
  }

  .btn-large {
    padding: 14px 22px;
    font-size: 15px;
  }

  /* ── Burger button ────────────────────────── */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--line-dark);
    border-radius: 4px;
    cursor: pointer;
    padding: 0;
  }

  .burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text-on-dark);
    border-radius: 2px;
    transition: transform 0.28s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .burger.is-active span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .burger.is-active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .burger.is-active span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ── Mobile menu overlay ──────────────────── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-dark);
    z-index: 99;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu-inner {
    padding-top: 32px;
    padding-bottom: 48px;
    padding-left: max(24px, env(safe-area-inset-left));
    padding-right: max(24px, env(safe-area-inset-right));
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* ── Mobile sections ──────────────────────── */
  .mobile-section-title {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 14px;
  }

  .mobile-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .mobile-section ul a {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    font-weight: 400;
    padding: 12px 0;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
    transition: color 0.2s;
  }

  .mobile-section ul a:hover,
  .mobile-section ul a:active {
    color: var(--accent);
  }

  /* ── Mobile CTA ───────────────────────────── */
  .mobile-cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding-top: 8px;
  }

  .mobile-cta .btn {
    justify-content: center;
    text-align: center;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }

    .logo-text small {
      display: none;
    }

    .burger {
      display: flex;
    }

    .mobile-menu {
      display: block;
      top: 64px;
    }

    .nav-inner {
      padding-top: 14px;
      padding-bottom: 14px;
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
      gap: 12px;
    }

    .logo-mark {
      width: 34px;
      height: 34px;
    }

    .logo-text strong {
      font-size: 14px;
    }
  }

  @media (max-width: 600px) {
    .nav-cta .btn {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-phone {
      display: none;
    }

    .nav-inner {
      padding-left: max(16px, env(safe-area-inset-left));
      padding-right: max(16px, env(safe-area-inset-right));
    }
  }
</style>

<script>
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    mobileMenu?.classList.add('is-open');
    burgerBtn?.classList.add('is-active');
    burgerBtn?.setAttribute('aria-expanded', 'true');
    burgerBtn?.setAttribute('aria-label', 'Fermer le menu');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('is-open');
    burgerBtn?.classList.remove('is-active');
    burgerBtn?.setAttribute('aria-expanded', 'false');
    burgerBtn?.setAttribute('aria-label', 'Ouvrir le menu');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  burgerBtn?.addEventListener('click', () => {
    mobileMenu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  document.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
