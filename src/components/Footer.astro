---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
import { ADDITIONAL_SERVICES } from '../data/additionalServices';
import { EN_SERVICE_NAMES, localizeNavLink } from '../data/i18n';

interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';
const navLink = (href: string, fr: string, en: string) => localizeNavLink(href, fr, en, lang);
const serviceLinks = [
  navLink('/petit-demenagement/', 'Petit déménagement', 'Small removals'),
  navLink('/transport-urgent-carcassonne/', 'Transport express aujourd’hui / demain', 'Express transport today / tomorrow'),
  navLink('/livraison-meubles-magasins-carcassonne/', 'Livraison de meubles depuis un magasin', 'Furniture delivery from shops'),
  ...SERVICES.map(service => navLink(`/services/${service.slug}/`, service.name, EN_SERVICE_NAMES[service.slug])),
  navLink('/demenagement-entreprise-carcassonne/', 'Déménagement d’entreprise', 'Office removals'),
  navLink('/monte-escalier-pianoplan-carcassonne/', 'Monte-escalier Pianoplan', 'Pianoplan stair climber'),
  navLink('/demenagement-senior-carcassonne/', 'Déménagement senior', 'Senior removals'),
  navLink('/emballage-cartons-carcassonne/', 'Emballage et cartons', 'Packing and boxes'),
  navLink('/mission-logistique-longue-distance/', 'Mission logistique sur mesure', 'Bespoke logistics assistance'),
  navLink('/formules/', 'Nos formules', 'Our service packages'),
  navLink('/tarifs/', 'Nos tarifs', 'Our prices'),
  ...ADDITIONAL_SERVICES.map(service => navLink(`/${service.slug}/`, service.title, service.englishTitle)),
];
const resourceLinks = [
  navLink('/outils-demenagement/', 'Tous les outils', 'All moving tools'),
  navLink('/calculateur-volume-demenagement/', 'Calculateur de volume', 'Volume calculator'),
  navLink('/calculateur-cartons-demenagement/', 'Calculateur de cartons', 'Box calculator'),
  navLink('/checklist-demenagement/', 'Checklist interactive', 'Interactive checklist'),
  navLink('/trajets-groupes/', 'Trajets groupés', 'Shared trips'),
  navLink('/realisations/', 'Réalisations', 'Our work'),
  navLink('/nos-garanties/', 'Nos garanties', 'Our safeguards'),
  navLink('/assurance-demenagement/', 'Assurance et protection', 'Insurance & protection'),
  navLink('/blog/', 'Blog : conseils et actualités', 'Blog: tips and news'),
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand reveal" data-i="0">
        <a href={isEnglish ? '/en/' : '/'} class="logo">
          <img
            class="logo-mark"
            src="/brand/logo-mark.svg"
            width="50"
            height="50"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <span class="logo-text">
            <strong>Transport Carcassonne</strong>
            <small>{isEnglish ? 'Removals & transport' : 'Déménagement & transport'}</small>
          </span>
        </a>
        <p>{isEnglish
          ? <>Local removals and transport in Carcassonne and across the Aude. French registered business, SIRET {SITE.siret}.</>
          : <>Déménagement et transport à Carcassonne et dans l'Aude. Entreprise identifiée sous le SIRET {SITE.siret}.</>}
        </p>
        <p class="sister-site">
          {isEnglish ? 'Need a house clearance as a separate service? Visit ' : "Besoin d'un débarras ou d'un vide maison ? Consulter le site "}
          <a href="https://debarras-carcassonne.fr/" rel="noopener">
            Débarras Carcassonne
          </a>
          {isEnglish ? ' (website in French).' : ' pour étudier cette prestation séparément.'}
        </p>
      </div>

      <div class="reveal" data-i="1">
        <p class="footer-title">Services</p>
        <ul>
          {serviceLinks.map(item => <li><a href={item.href} hreflang={item.hreflang}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="reveal" data-i="2">
        <p class="footer-title">{isEnglish ? 'Service area' : 'Zone'}</p>
        <ul>
          {CITIES.slice(0, 6).map(c => (
            <li><a href={isEnglish ? `/en/removals-${c.slug}/` : `/demenagement-${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="reveal" data-i="3">
        <p class="footer-title">{isEnglish ? 'Resources' : 'Ressources'}</p>
        <ul>
          {resourceLinks.map(item => <li><a href={item.href} hreflang={item.hreflang}>{item.label}</a></li>)}
          {isEnglish && (
            <>
              <li><a href="/en/uk-france-removals-carcassonne/">UK to Carcassonne removals</a></li>
              <li><a href="/en/moving-from-london-to-carcassonne/">Moving from London</a></li>
              <li><a href="/en/second-home-removals-carcassonne/">Second-home removals</a></li>
              <li><a href="/en/quote/">Request a quote</a></li>
            </>
          )}
        </ul>
      </div>

      <div class="reveal" data-i="4">
        <p class="footer-title">Contact</p>
        <ul>
          <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li>
            <a
              href={`https://wa.me/${SITE.phoneWhatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
            >WhatsApp</a>
          </li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>{isEnglish ? 'By appointment · 24/7 enquiries' : SITE.hours}</li>
          <li>{isEnglish ? `Service area: ${SITE.hq.city} and surrounding towns` : `Zone d’intervention : ${SITE.hq.city} et alentours`}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© 2021 {SITE.name} · SIRET {SITE.siret}</div>
      <div class="footer-legal">
        <a href="/paiement-securise/" hreflang="fr">{isEnglish ? 'Secure payment' : 'Paiement sécurisé'}</a>
        <span>·</span>
        <a href="/mentions-legales/" hreflang="fr">{isEnglish ? 'Legal notice (FR)' : 'Mentions légales'}</a>
        <span>·</span>
        <a href="/politique-confidentialite/" hreflang="fr">{isEnglish ? 'Privacy (FR)' : 'Politique de confidentialité'}</a>
        <span>·</span>
        <button type="button" class="footer-cookie" onclick="window.__ccManage&&window.__ccManage()">{isEnglish ? 'Cookie settings' : 'Gérer les cookies'}</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    padding: 64px 0 32px;
    border-top: 1px solid var(--line-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 42px;
    margin-bottom: 60px;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .footer-brand .logo-mark {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    display: block;
  }

  .footer-brand .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-brand .logo-text strong {
    font-weight: 500;
    font-size: 16px;
  }

  .footer-brand .logo-text small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .footer-brand p {
    color: var(--text-on-dark-muted);
    font-size: 14px;
    line-height: 1.65;
    max-width: 340px;
  }

  .footer-brand .sister-site {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
  }

  .footer-brand .sister-site a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-brand .sister-site a:hover {
    color: var(--text-on-dark);
  }

  .footer-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 22px;
    font-weight: 500;
  }

  ul {
    list-style: none;
  }

  li {
    margin-bottom: 11px;
  }

  a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--line-dark);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--text-on-dark-muted);
    font-size: 13px;
  }

  .footer-bottom a {
    color: var(--text-on-dark-muted);
  }

  .footer-legal {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-cookie {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 13px;
    color: var(--text-on-dark-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-cookie:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
