---
import { SITE } from '../data/site.config';
---

<section class="urgent-spotlight" aria-labelledby="urgent-spotlight-title">
  <div class="container">
    <div class="urgent-spotlight__shell reveal">
      <div class="urgent-spotlight__copy">
        <p class="urgent-spotlight__eyebrow"><span aria-hidden="true"></span>Transport local urgent · Carcassonne et environs</p>
        <h2 id="urgent-spotlight-title">Besoin de transporter <em>aujourd’hui ou demain&nbsp;?</em></h2>
        <p>
          Petit déménagement, canapé, électroménager, cartons ou achat à retirer en magasin&nbsp;:
          appelez-nous maintenant. Nous vérifions immédiatement le planning, le véhicule, les accès
          et la faisabilité d’un créneau proche.
        </p>
        <div class="urgent-spotlight__tags" aria-label="Demandes étudiées">
          <span>1 à quelques meubles</span>
          <span>Retrait en magasin</span>
          <span>Carcassonne · courte distance</span>
        </div>
      </div>
      <div class="urgent-spotlight__actions">
        <a
          class="urgent-spotlight__call"
          href={`tel:${SITE.phone}`}
          data-source="urgent-home"
        >
          <small>Vérifier la disponibilité</small>
          <strong>Appeler maintenant</strong>
          <span>{SITE.phoneDisplay}</span>
        </a>
        <a class="urgent-spotlight__link" href="/transport-urgent-carcassonne/">
          Voir le service urgent <span aria-hidden="true">→</span>
        </a>
        <p>Créneau et tarif confirmés avant intervention · selon disponibilité et faisabilité.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .urgent-spotlight { padding: 28px 0 18px; background: var(--bg); }
  .urgent-spotlight__shell {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(270px, .65fr);
    gap: 42px;
    align-items: center;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    position: relative;
  }
  .urgent-spotlight__shell::after {
    content: '';
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    right: -170px;
    top: -190px;
    background: rgba(168, 112, 63, .16);
    pointer-events: none;
  }
  .urgent-spotlight__copy, .urgent-spotlight__actions { position: relative; z-index: 1; }
  .urgent-spotlight__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin-bottom: 15px;
  }
  .urgent-spotlight__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #64d78d;
    box-shadow: 0 0 0 5px rgba(100, 215, 141, .12);
  }
  .urgent-spotlight h2 {
    color: var(--text-on-dark);
    font-size: clamp(34px, 4.2vw, 58px);
    line-height: 1.02;
    margin-bottom: 18px;
  }
  .urgent-spotlight h2 em { color: var(--accent); font-weight: 400; }
  .urgent-spotlight__copy > p:not(.urgent-spotlight__eyebrow) {
    color: var(--text-on-dark-muted);
    max-width: 720px;
    line-height: 1.72;
  }
  .urgent-spotlight__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .urgent-spotlight__tags span {
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    padding: 7px 11px;
    color: rgba(250, 250, 247, .82);
    font-size: 12px;
  }
  .urgent-spotlight__actions { display: grid; gap: 13px; }
  .urgent-spotlight__call {
    display: grid;
    gap: 2px;
    background: var(--accent);
    color: #15100a;
    border-radius: 10px;
    padding: 18px 20px;
    transition: transform .2s ease, background .2s ease;
  }
  .urgent-spotlight__call:hover { transform: translateY(-2px); background: #c08a58; }
  .urgent-spotlight__call small { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .urgent-spotlight__call strong { font-size: 18px; }
  .urgent-spotlight__call span { font-size: 15px; }
  .urgent-spotlight__link { color: var(--text-on-dark); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .urgent-spotlight__actions > p { color: var(--text-on-dark-muted); font-size: 12px; line-height: 1.5; }

  @media (max-width: 820px) {
    .urgent-spotlight__shell { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
