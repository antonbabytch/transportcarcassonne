---
import { ADDITIONAL_SERVICES } from '../data/additionalServices';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const en = lang === 'en';
---
<section class="section extra-services" aria-labelledby="extra-services-title">
  <div class="container">
    <span class="section-label">{en ? 'Everyday transport needs' : 'Les transports du quotidien'}</span>
    <h2 id="extra-services-title">{en ? 'Not every move is a whole house.' : 'Pas besoin de déménager toute une maison.'}</h2>
    <p class="extra-intro">{en ? 'A second-hand sofa, a storage transfer or a student room: start with the service that matches your situation.' : 'Un canapé d’occasion, un aller-retour au box ou une chambre étudiante : choisissez le service qui correspond à votre besoin.'}</p>
    <div class="extra-grid">
      {ADDITIONAL_SERVICES.map((service, index) => (
        <a class="extra-card" href={en ? `/en/${service.englishSlug}/` : `/${service.slug}/`}>
          <span class="extra-number" aria-hidden="true">0{index + 1}</span>
          <h3>{en ? service.englishTitle : service.title}</h3>
          <p>{en ? service.englishIntro : service.intro}</p>
          <strong>{en ? 'Plan this transport' : 'Préparer ce transport'} →</strong>
        </a>
      ))}
    </div>
    <p class="extra-partners">{en ? <>Furnishing a holiday home? <a href="/en/second-home-removals-carcassonne/">Plan your local deliveries from abroad →</a></> : <>Vous êtes commerçant ? <a href="/prestataire-livraison-magasins-carcassonne/">Étudions la livraison de vos clients →</a></>}</p>
  </div>
</section>
<style>
  .extra-services { background: var(--bg-soft); }
  .extra-services .section-label { color: var(--accent-deep); }
  .extra-intro { max-width: 680px; margin-top: 16px; color: var(--text-muted); }
  .extra-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 32px; }
  .extra-card { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; background: var(--bg-card); border: 1px solid var(--line); border-radius: 12px; transition: border-color .2s, box-shadow .2s; }
  .extra-card:hover, .extra-card:focus-visible { border-color: var(--accent); box-shadow: var(--shadow); }
  .extra-number { color: var(--accent-deep); font-size: .8rem; letter-spacing: .15em; margin-bottom: 20px; }
  .extra-card h3 { margin-bottom: 16px; }
  .extra-card p { color: var(--text-muted); font-size: .93rem; line-height: 1.75; margin-bottom: 24px; }
  .extra-card strong { color: var(--accent-deep); font-size: .9rem; margin-top: auto; }
  .extra-partners { margin-top: 28px; color: var(--text-muted); }
  .extra-partners a { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 800px) { .extra-grid { grid-template-columns: 1fr; } }
</style>
