---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site.config';

export function getStaticPaths() {
  return SERVICES.map(s => ({ params: { service: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;

type ServiceContent = {
  title: string;
  metaTitle: string;
  metaDescription: string;
  body: string[];
  included: string[];
  notIncluded: string[];
  faqs: { q: string; a: string }[];
  image: string;
};

const serviceContent: Record<string, ServiceContent> = {
  'demenagement-local': {
    title: 'Déménagement local à Carcassonne et dans l\'Aude',
    metaTitle: 'Déménagement local à Carcassonne | dès 450 €',
    metaDescription: `Déménagement local à Carcassonne et dans l'Aude (≤ 50 km). Repère indicatif dès 450 €, prix confirmé sur devis selon le projet. ${SITE.phoneDisplay}`,
    body: [
      `Vous déménagez à Carcassonne ou dans les environs ? La demande est étudiée selon le volume, les adresses, les accès, le trajet et le créneau souhaité.`,
      `Une demande locale peut concerner Carcassonne, Trèbes, Pezens, Alzonne, Capendu, Bram, Lézignan-Corbières, Limoux ou Castelnaudary. La zone, le véhicule et les moyens humains restent à confirmer sur le devis.`,
      `Le devis détaille le volume déclaré, les contraintes d'accès (étage, solution de levage éventuelle, distance de portage), les prestations retenues, le prix et les conditions applicables.`,
      `Le jour du déménagement, les moyens et protections prévus doivent correspondre au devis accepté. Signalez avant l’intervention tout bien fragile, lourd ou de valeur et toute modification d’accès.`,
      `À l'arrivée, nous déchargeons et déposons vos affaires dans les pièces indiquées. Sur demande, nous proposons également le remontage des meubles démontés. Vos meubles sont protégés (couvertures, housses) et soigneusement calés dans le fourgon, pour votre tranquillité d'esprit.`,
      `Que vous soyez locataire ou propriétaire, en appartement ou en maison, le créneau n’est confirmé qu’après vérification du planning et acceptation des conditions convenues.`,
    ],
    included: [
      'Déchargement et chargement du fourgon',
      'Protection des meubles (couvertures)',
      'Transport sécurisé jusqu\'à destination',
      'Déchargement et mise en place',
      'Meubles protégés, calés et sanglés',
      'Devis détaillé écrit',
    ],
    notIncluded: [
      'Emballage des cartons (option payante)',
      'Démontage/remontage des meubles (option payante)',
      'Monte-meuble si nécessaire (sur devis)',
      'Solution de stockage éventuelle, uniquement si elle figure au devis',
    ],
    faqs: [
      { q: 'Quel est le délai pour réserver un déménagement local ?', a: 'Le délai dépend du planning, du volume, du trajet et des accès. Aucun créneau n’est garanti avant confirmation écrite.' },
      { q: 'Proposez-vous des créneaux le week-end ?', a: 'Toute demande de week-end est étudiée selon le planning. Les horaires et conditions applicables sont confirmés sur le devis.' },
      { q: 'Comment est calculé le prix d\'un déménagement local ?', a: 'Le prix dépend du volume, de la distance, des accès, du stationnement, du créneau et des options. Le montant applicable figure sur le devis écrit.' },
      { q: 'Que se passe-t-il en cas d\'imprévu le jour J (maladie, météo) ?', a: 'Les conditions d’annulation, de report et leurs éventuels frais sont celles remises avant acceptation. Contactez l’entreprise dès que possible en cas d’imprévu.' },
      { q: 'Faut-il être présent pendant tout le déménagement ?', a: 'La présence du client ou d’un représentant autorisé est recommandée au départ et à l’arrivée. Toute organisation différente doit être convenue par écrit au préalable.' },
      { q: 'Mes meubles seront-ils protégés des chocs et rayures ?', a: 'Les protections dépendent des biens transportés. Faites préciser sur le devis le matériel prévu pour les meubles, appareils, écrans et surfaces fragiles.' },
    ],
    image: '/images/transport.webp',
  },
  'demenagement-longue-distance': {
    title: 'Déménagement longue distance depuis Carcassonne',
    metaTitle: 'Déménagement longue distance Carcassonne | dès 950 €',
    metaDescription: `Déménagement longue distance depuis Carcassonne. Repère indicatif dès 950 €, prix et trajet confirmés sur devis. ${SITE.phoneDisplay}`,
    body: [
      `Vous quittez l'Aude pour vous installer ailleurs en France ? Une demande longue distance peut être étudiée selon la destination, le volume, les accès et le planning.`,
      `Un déménagement longue distance demande une organisation rigoureuse. Le véhicule, le chargement, les étapes et le créneau de livraison sont définis selon le volume, le trajet et les accès.`,
      `Pour les grands volumes, plusieurs rotations ou un véhicule supplémentaire peuvent être nécessaires. Les moyens réellement prévus et les éventuels intervenants doivent figurer sur le devis.`,
      `Les objets précieux (œuvres d\'art, équipements hi-fi, instruments de musique) doivent être signalés avant le devis afin d’y préciser les protections et les limites applicables.`,
      `Les éventuelles options d’emballage, de démontage, de remontage ou de nettoyage ne sont incluses que si elles apparaissent explicitement sur le devis.`,
      `Le devis est établi à partir du volume déclaré, de la distance, des accès et des prestations choisies. Vérifiez qu’il mentionne les péages, le carburant, les étapes et toute option applicable.`,
    ],
    included: [
      'Chargement depuis Carcassonne',
      'Transport longue distance vers destination',
      'Déchargement et mise en place',
      'Manutention soignée et calage',
      'Suivi de votre déménagement',
      'Devis écrit détaillé',
    ],
    notIncluded: [
      'Emballage cartons (option)',
      'Démontage/remontage (option)',
      'Hébergement de nuit si nécessaire (sur devis)',
      'Péages et carburant (inclus dans le devis)',
    ],
    faqs: [
      { q: 'Combien de temps dure un déménagement Paris-Carcassonne ?', a: 'Le trajet Carcassonne-Paris prend environ 7h de route. En comptant le chargement et déchargement, comptez 1 à 2 jours selon le volume et les contraintes.' },
      { q: 'Puis-je voyager dans le véhicule de transport ?', a: 'Le transport de passagers n’est pas inclus dans la prestation. Organisez votre trajet séparément, sauf disposition écrite contraire.' },
      { q: 'Proposez-vous une solution de stockage si les dates ne coïncident pas ?', a: 'Aucune capacité de stockage propre n’est promise sur cette page. Une éventuelle solution tierce doit être confirmée et chiffrée par écrit.' },
      { q: 'Quelles destinations étudiez-vous en France ?', a: 'La faisabilité est vérifiée pour chaque destination selon le trajet et le planning. Transmettez les deux adresses pour obtenir une confirmation écrite.' },
      { q: 'Comment les protections sont-elles définies pour un long trajet ?', a: 'Signalez les biens fragiles et de valeur. Les protections, l’arrimage, le véhicule et les éventuelles limites doivent être précisés dans la proposition.' },
      { q: 'Faut-il un déménagement aller-retour si je suis seul ?', a: 'Non, nous pouvons faire un trajet aller-simple Carcassonne → destination. Le prix inclut le retour à vide du camion. Pas besoin d\'organiser quoi que ce soit côté retour.' },
    ],
    image: '/images/demenagement-longue-distance.webp',
  },
  'demenagement-international': {
    title: 'Déménagement international depuis Carcassonne',
    metaTitle: 'Déménagement international Carcassonne | Espagne, Italie',
    metaDescription: `Projet de déménagement international depuis Carcassonne vers l’Europe. Faisabilité, formalités, intervenants et prix à confirmer sur devis. ${SITE.phoneDisplay}`,
    body: [
      `Vous déménagez à l\'étranger depuis Carcassonne ? Une demande internationale peut être étudiée selon le pays, le trajet, les formalités, les intervenants nécessaires et le planning.`,
      `La proximité de l’Espagne peut faciliter certains trajets, mais chaque destination exige de vérifier les accès, les règles de transport, les formalités et les délais applicables.`,
      `Un déménagement international nécessite une préparation minutieuse. Le volume, les accès, la réglementation locale, les taxes éventuelles, les intervenants et le planning doivent être vérifiés avant acceptation.`,
      `Le devis doit identifier les moyens prévus et préciser si des transporteurs, transitaires ou autres partenaires interviennent. Demandez leurs rôles et responsabilités avant acceptation.`,
      `L\'emballage est particulièrement important sur une longue distance internationale. Le devis doit indiquer les matériaux réellement prévus et la personne chargée d’emballer chaque catégorie de biens.`,
      `Pour les déménagements hors Union européenne ou vers une destination soumise à des règles spécifiques, vérifiez les formalités auprès des autorités et professionnels compétents. Toute mise en relation éventuelle avec un transitaire doit être confirmée par écrit.`,
    ],
    included: [
      'Transport de porte à porte',
      'Manutention soignée porte à porte',
      'Formalités douanières conseillées',
      'Emballage professionnel recommandé',
      'Déchargement et mise en place',
    ],
    notIncluded: [
      'Taxes douanières éventuelles',
      'Permis de stationnement (à votre charge)',
      'Travaux d\'adaptation logement destination',
    ],
    faqs: [
      { q: 'Intervenez-vous vers toute l\'Europe ?', a: 'Nous intervenons principalement vers l\'Espagne, l\'Italie, la Belgique et le Luxembourg. Pour d\'autres destinations européennes, contactez-nous : nous étudions chaque demande.' },
      { q: 'Faut-il un inventaire douanier pour déménager en Espagne ?', a: 'Pour les ressortissants de l\'UE déménageant entre pays membres, les formalités douanières sont simplifiées. Cependant, un inventaire détaillé reste recommandé pour votre assurance.' },
      { q: 'Quel est le délai de livraison vers l\'Espagne ?', a: 'Le délai dépend de la destination, du volume, des formalités, des accès et des conditions de circulation. Il doit être confirmé dans la proposition.' },
    ],
    image: '/images/demenagement-international.webp',
  },
  'transport-meubles': {
    title: 'Transport de meubles à Carcassonne et dans l\'Aude',
    metaTitle: 'Transport de meubles à Carcassonne | dès 80 €',
    metaDescription: `Transport de meubles à Carcassonne et dans l'Aude. Un meuble ou plusieurs objets ; repère indicatif dès 80 €, montant confirmé sur devis. ${SITE.phoneDisplay}`,
    body: [
      `Vous avez besoin de transporter un ou plusieurs meubles sans pour autant faire appel à un service de déménagement complet ? Transport Carcassonne propose un service de transport de meubles à la pièce ou par lots, adapté à vos besoins précis.`,
      `Notre service de transport de meubles est idéal dans de nombreuses situations : achat d\'un meuble chez un particulier ou en magasin, livraison d\'un meuble en cadeau, transfert de quelques objets entre deux logements, récupération d\'héritage familial, vente de meubles en ligne.`,
      `Le type de véhicule et les moyens de manutention sont définis selon les dimensions, le poids, la quantité de mobilier et les accès. Ils doivent être précisés sur le devis.`,
      `Les protections nécessaires dépendent du meuble et de sa valeur. Signalez les surfaces fragiles ou anciennes afin que le matériel prévu et les limites éventuelles soient décrits avant l’intervention.`,
      `Notre service de transport de meubles couvre Carcassonne et les communes environnantes dans un rayon de 50 km. Pour les destinations plus lointaines, contactez-nous : nous étudions chaque demande selon les disponibilités.`,
      `Le tarif est établi selon le volume, la distance et les difficultés d’accès (étage, portage, stationnement). Le montant dès 80 € est un repère indicatif non contractuel ; seul le devis confirme le prix.`,
    ],
    included: [
      'Chargement et transport du meuble',
      'Protection couvertures et film',
      'Livraison à l\'étage si nécessaire',
      'Déchargement et mise en place',
      'Protection anti-rayures et sanglage',
    ],
    notIncluded: [
      'Démontage/remontage (option chiffrée sur devis)',
      'Monte-meuble (si nécessaire, sur devis)',
      'Emballage cartons (non applicable)',
    ],
    faqs: [
      { q: 'Puis-je faire transporter un seul canapé ?', a: 'Une demande pour un seul meuble peut être étudiée. Le repère dès 80 € reste indicatif et varie selon le trajet, le poids et les accès.' },
      { q: 'Proposez-vous le démontage de meubles ?', a: 'Cette option doit être confirmée selon le meuble. Son périmètre et son prix figurent sur le devis.' },
      { q: 'Intervenez-vous le même jour ?', a: 'Une demande urgente peut être étudiée, sans promesse de délai avant confirmation du planning.' },
      { q: 'Faites-vous la livraison Le Bon Coin ou Vinted ?', a: 'Une demande de retrait chez un vendeur et de livraison à domicile peut être étudiée. Les responsabilités, le créneau et le prix sont confirmés sur devis.' },
      { q: 'Mon canapé passera-t-il par mon escalier ?', a: 'Transmettez les dimensions du meuble, des portes et de l’escalier. Si une solution de levage est nécessaire, sa faisabilité et son prix doivent être confirmés séparément.' },
      { q: 'Acceptez-vous les transports inter-villes (ex: Carcassonne → Béziers) ?', a: 'La faisabilité d’un trajet inter-villes est étudiée selon la destination et le planning. Aucun supplément standard n’est annoncé ici : le devis détaille le prix.' },
    ],
    image: '/images/transport-meubles.webp',
  },
  'transport-piano': {
    title: 'Transport piano et objets lourds à Carcassonne',
    metaTitle: 'Transport piano & objets lourds Carcassonne | dès 350 €',
    metaDescription: `Projet de transport de piano ou d'objet lourd à Carcassonne. Faisabilité, moyens de levage, protections et prix confirmés après étude et devis. ${SITE.phoneDisplay}`,
    body: [
      `Le transport d’un piano est une opération délicate. Le poids réel, les dimensions, la valeur, les passages et les accès doivent être évalués avant de confirmer la faisabilité.`,
      `Les compétences, le nombre d’intervenants, les moyens de levage et les protections nécessaires doivent être confirmés sur le devis avant toute manutention.`,
      `La préparation est essentielle : le piano est d\'abord évalué (taille, poids, accès depuis le logement de départ et d\'arrivée). Certaines configurations nécessitent un démontage partiel ou l\'utilisation d\'un monte-meuble. Nous anticipons tous ces aspects dès le devis pour vous proposer la solution la plus adaptée.`,
      `Une demande peut aussi concerner un coffre-fort, une sculpture, un équipement de sport ou un objet d’art volumineux. Chaque objet exige une étude de poids, d’accès et de responsabilité.`,
      `Pour les objets d’art et les instruments de valeur, indiquez la nature et la valeur avant le devis. Les protections, les limites de manutention et les conditions d’assurance doivent être vérifiées par écrit.`,
      `Nous intervenons à Carcassonne et dans un rayon de 50 km pour le transport de pianos et objets lourds. Pour les déménagements longue distance incluant un piano, nous adaptons l\'organisation logistique en conséquence.`,
    ],
    included: [
      'Évaluation technique et devis adapté',
      'Équipement à confirmer selon l’évaluation',
      'Protection complète de l\'instrument',
      'Transport sécurisé',
      'Moyens humains et manutention précisés au devis',
    ],
    notIncluded: [
      'Monte-meuble si nécessaire (supplément)',
      'Démontage de la queue du piano à queue (si requis)',
      'Accord du piano après transport (à votre charge)',
    ],
    faqs: [
      { q: 'Faut-il faire accorder le piano après transport ?', a: 'Il est recommandé de faire accorder un piano après un déménagement, surtout si les conditions de température et d\'humidité ont changé. Nous pouvons vous recommander un accordeur à Carcassonne.' },
      { q: 'Combien de personnes sont nécessaires pour transporter un piano ?', a: 'Selon le type et la configuration (étages, accès), nous mobilisons 2 à 3 personnes. La sécurité de votre instrument et de nos équipes est notre priorité.' },
      { q: 'Transportez-vous les clavecins et orgues ?', a: 'Oui, nous sommes équipés pour transporter différents types d\'instruments à clavier. Chaque cas est étudié individuellement au moment du devis.' },
      { q: 'Mon piano peut-il passer par un escalier en colimaçon ?', a: 'Tout dépend du modèle, du poids et des dimensions des passages. Une solution de levage extérieure peut être étudiée ; sa faisabilité et son prix doivent être confirmés séparément.' },
      { q: 'Comment protéger un piano de grande valeur ?', a: 'Pour les pianos de grande valeur (Steinway, Bösendorfer, antiquités), nous vous conseillons de souscrire une assurance à valeur agréée auprès de votre assureur — précisez la valeur lors du devis, nous adaptons l\'emballage et la manutention en conséquence.' },
      { q: 'Combien coûte le transport d\'un piano sur longue distance ?', a: 'Le prix dépend du piano, du poids, des accès, des protections, des moyens humains et du trajet. Demandez une étude personnalisée ; aucun montant n’est garanti sur cette page.' },
    ],
    image: '/images/transport-piano.webp',
  },
  'evacuation-dechets-metaux': {
    title: 'Évacuation de déchets et métaux à Carcassonne',
    metaTitle: 'Évacuation déchets & ferraille Carcassonne | dès 150 €',
    metaDescription: `Demande d'évacuation de déchets encombrants, ferraille et métaux à Carcassonne. Nature des déchets, filière, délai et prix confirmés sur devis. ${SITE.phoneDisplay}`,
    body: [
      `Vous avez des encombrants à évacuer, de la ferraille à faire enlever ou des déchets à transporter vers la déchetterie ? Transport Carcassonne propose un service d\'évacuation de déchets et de métaux rapide et efficace.`,
      `Notre service d\'évacuation couvre tout type de déchets encombrants : vieux meubles, électroménager hors d\'usage, ferraille, métaux divers (aluminium, cuivre, acier), déchets de chantier non dangereux, gravats, bois et palettes.`,
      `Une demande peut concerner une cave, un grenier, un garage ou un terrain. La nature et le volume des déchets doivent être déclarés avant de confirmer la manutention, le transport et la destination.`,
      `La filière envisagée doit être adaptée à chaque type de déchet. Demandez que la destination, les exclusions et les éventuels justificatifs figurent dans la proposition.`,
      `Le prix dépend du volume, du poids, du tri nécessaire, des accès, de la distance et des frais de traitement. Tout montant affiché constitue seulement un repère indicatif confirmé sur devis.`,
      `Le délai dépend de la nature des déchets, des moyens nécessaires et du planning. Une demande urgente peut être étudiée sans garantie avant confirmation écrite.`,
    ],
    included: [
      'Chargement des déchets et ferraille',
      'Transport vers filières adaptées',
      'Évacuation meubles et électroménager',
      'Ferraille et métaux divers',
      'Déchets de chantier non dangereux',
    ],
    notIncluded: [
      'Déchets dangereux (amiante, produits chimiques)',
      'Déchets radioactifs',
      'Véhicules hors d\'usage (VHU) — filière dédiée',
    ],
    faqs: [
      { q: 'Récupérez-vous les métaux pour la revente ?', a: 'Oui, les métaux valorisables (cuivre, aluminium, acier) sont dirigés vers des centres de recyclage. Selon la quantité et la qualité des métaux, un ajustement de tarif peut être proposé.' },
      { q: 'Intervenez-vous pour les professionnels ?', a: 'Une demande professionnelle peut être étudiée selon la nature des déchets, le volume, la fréquence et la filière nécessaire.' },
      { q: 'Vous chargez-vous du nettoyage après évacuation ?', a: 'Nous évacuons les déchets mais le nettoyage de la zone n\'est pas inclus par défaut. Nous pouvons le proposer en option sur demande.' },
    ],
    image: '/images/evacuation-dechets-metaux.webp',
  },
};

const content = serviceContent[service.slug];
const pageTitle = content?.metaTitle ?? `${service.name} | Transport Carcassonne`;
const pageDescription = content?.metaDescription ?? service.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  preloadImage={content?.image}
  ogImage={content?.image}
  ogImageAlt={`${content?.title ?? service.name} à Carcassonne`}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE.url}/services/${service.slug}/#service`,
    'serviceType': service.name,
    'name': content?.title ?? service.name,
    'description': pageDescription,
    'url': `${SITE.url}/services/${service.slug}/`,
    'provider': { '@id': `${SITE.url}/#business` },
    'areaServed': [
      { '@type': 'City', 'name': SITE.hq.city },
      { '@type': 'AdministrativeArea', 'name': 'Aude' },
    ],
  })} />
  {content?.faqs && content.faqs.length > 0 && (
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': content.faqs.map(f => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    })} />
  )}
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: 'Services', href: '/#services' }, { name: content?.title ?? service.name }]} />

  <!-- Page Hero -->
  <section class="svc-hero">
    <div class="svc-hero-bg"></div>
    <div class="container svc-hero-layout">
      <div class="svc-hero-content">
        <div class="svc-hero-badge">
          <span class="svc-icon">{service.icon}</span>
          <span>Service sur devis</span>
        </div>
        <h1>{content?.title ?? service.name}</h1>
        <p class="svc-hero-desc">{service.description}</p>
        <div class="svc-hero-price">
          Repère indicatif dès <strong>{service.priceFrom} €</strong> · confirmé sur devis
        </div>
        <div class="svc-hero-ctas">
          <a href={`/devis/?service=${service.slug}&source=service`} class="btn btn--primary btn--lg">Devis gratuit →</a>
          <a href={`tel:${SITE.phone}`} class="btn btn--white btn--lg">📞 {SITE.phoneDisplay}</a>
        </div>
      </div>
      <div class="svc-hero-media">
        {content?.image?.startsWith('/')
          ? <img
              src={content.image}
              alt={`${content?.title ?? service.name} — Transport Carcassonne`}
              width="1376"
              height="768"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style="width:100%;height:auto;display:block;border-radius:12px"
            />
          : <PhotoPlaceholder
              aspectRatio="4/3"
              label={service.name}
              description={content?.image ?? 'photo.jpg'}
              variant="dark"
            />}
      </div>
    </div>
  </section>

  <!-- Body text -->
  <section class="section">
    <div class="container svc-layout">
      <div class="svc-body">
        {content?.body.map(para => <p class="svc-para">{para}</p>)}

        <!-- Scope to be confirmed in the written quote -->
        <div class="svc-lists">
          <div class="svc-list-block svc-list-block--yes">
            <h3>📋 Prestations à confirmer</h3>
            <ul>
              {content?.included.map(item => <li>{item}</li>)}
            </ul>
          </div>
          <div class="svc-list-block svc-list-block--no">
            <h3>ℹ️ Options et exclusions à vérifier</h3>
            <ul>
              {content?.notIncluded.map(item => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Sidebar price block -->
      <aside class="svc-sidebar">
        <div class="price-block">
          <div class="price-block__label">Repère indicatif</div>
          <div class="price-block__price">Dès {service.priceFrom} €</div>
          <p class="price-block__note">Montant non contractuel, confirmé sur devis</p>
          <a href={`/devis/?service=${service.slug}&source=service`} class="btn btn--primary" style="width:100%;justify-content:center;margin-bottom:12px">
            Demander un devis
          </a>
          <a href={`tel:${SITE.phone}`} class="btn btn--outline" style="width:100%;justify-content:center">
            📞 Appeler maintenant
          </a>
        </div>

