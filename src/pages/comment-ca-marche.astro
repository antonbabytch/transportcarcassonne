---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../data/site.config';

const title = 'Comment se déroule un déménagement | Carcassonne';
const description = `Découvrez comment se déroule un déménagement avec Transport Carcassonne : devis, visite, jour J, livraison. Simple, transparent, professionnel. ${SITE.phoneDisplay}`;

const steps = [
  {
    num: '01',
    icon: '📋',
    title: 'Demande de devis gratuit',
    duration: 'Selon disponibilités',
    content: `Tout commence par votre demande de devis. Vous pouvez nous contacter par téléphone au ${SITE.phoneDisplay}, via WhatsApp, par email ou en remplissant le formulaire en ligne. La demande est examinée selon les disponibilités.

Pour établir un devis précis, nous aurons besoin de quelques informations : votre ville de départ et d'arrivée, le type et la surface de votre logement, une estimation du nombre de meubles et cartons, la présence ou non d'un ascenseur, et la date souhaitée pour le déménagement.`,
    tips: ['Préparez un plan approximatif de votre logement', 'Listez les objets volumineux (piano, coffre-fort, etc.)', 'Vérifiez les conditions de stationnement à départ et arrivée'],
  },
  {
    num: '02',
    icon: '🏠',
    title: 'Évaluation du volume',
    duration: 'En visite ou à distance',
    content: `Pour les déménagements importants, une visite à domicile peut être proposée pour préciser le volume à transporter. Cette étape aide à définir le chargement, les accès et un devis adapté au projet.

Pour les petits volumes ou les déménagements simples, une estimation à distance peut être envisagée à partir de vos informations. Le devis écrit détaille le périmètre déclaré, les prestations retenues, le prix et les conditions applicables.`,
    tips: ['Vérifiez toutes les informations avant d’accepter le devis', 'Faites préciser les accès, le stationnement et le volume', 'Toute modification doit être convenue par écrit'],
  },
  {
    num: '03',
    icon: '📦',
    title: 'Préparation du déménagement',
    duration: 'Avant le jour J',
    content: `Une fois le devis accepté, la date et les détails logistiques sont planifiés selon les conditions convenues. Si vous avez retenu un service d'emballage, son horaire, son périmètre et les fournitures prévues figurent sur le devis.

Nous vous conseillons sur les précautions à prendre : déconnecter les appareils électroménagers 24h avant, préparer un carton "arrivée" avec les essentiels (vaisselle, linge de nuit, médicaments), et protéger les objets fragiles que vous souhaitez transporter vous-même.`,
    tips: ['Déconnectez réfrigérateur et congélateur 24h avant', 'Étiquetez les cartons par pièce de destination', 'Préparez les accès (codes, clés, codes parkings)'],
  },
  {
    num: '04',
    icon: '🚚',
    title: 'Jour du déménagement',
    duration: 'Au créneau convenu',
    content: `Le jour J, la prestation commence au créneau convenu, sous réserve des aléas signalés. Les moyens humains, le véhicule, les protections et le matériel prévus doivent correspondre au devis accepté.

Le chargement est organisé selon le volume et la nature des biens. Signalez les objets lourds, fragiles ou de valeur avant l’intervention afin que les précautions et éventuelles limites soient précisées.`,
    tips: ['Soyez présent au départ et à l\'arrivée', 'Faites visiter votre logement à l\'équipe en arrivant', 'Signalez immédiatement tout objet fragile ou de valeur'],
  },
  {
    num: '05',
    icon: '🏡',
    title: 'Livraison et installation',
    duration: 'À destination',
    content: `À l'arrivée dans votre nouveau logement, les biens sont déposés selon le périmètre et les pièces convenus. Il est utile d’indiquer clairement la destination de chaque meuble et carton.

Si vous avez retenu le remontage des meubles, son périmètre doit être indiqué sur le devis. Contrôlez l’état apparent des biens à la livraison et inscrivez immédiatement toute réserve sur le document prévu à cet effet.`,
    tips: ['Vérifiez l\'état de vos affaires avant de signer', 'Signalez immédiatement tout dommage éventuel', 'Conservez le bon de livraison signé'],
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <section class="ccm-hero">
    <div class="container">
      <span class="section-label">Processus</span>
      <h1>Comment se déroule votre déménagement</h1>
      <p class="ccm-hero-sub">
        De la demande de devis à la livraison, voici les 5 étapes de votre déménagement
        avec Transport Carcassonne.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="steps-list">
        {steps.map((step, i) => (
          <div class="step-detail">
            <div class="step-detail__indicator">
              <div class="step-detail__num">{step.num}</div>
              {i < steps.length - 1 && <div class="step-detail__line"></div>}
            </div>
            <div class="step-detail__body">
              <div class="step-detail__header">
                <span class="step-detail__icon">{step.icon}</span>
                <div>
                  <h2 class="step-detail__title">{step.title}</h2>
                  <span class="step-detail__duration">{step.duration}</span>
                </div>
              </div>
              <div class="step-detail__content">
                {step.content.split('\n\n').map(para => (
                  <p>{para}</p>
                ))}
              </div>
              <div class="step-detail__tips">
                <strong>Conseils pratiques :</strong>
                <ul>
                  {step.tips.map(tip => <li>{tip}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Commitments -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" style="text-align:center;margin-bottom:48px">
        <span class="section-label">Engagements de transparence</span>
        <h2>Les points à convenir avant l’intervention</h2>
      </div>
      <div class="guarantees-grid">
        <div class="guarantee-item">
          <div class="guarantee-icon">🎯</div>
          <h3>Créneau convenu</h3>
          <p>L’horaire prévu figure dans les échanges ; tout aléa connu doit vous être signalé.</p>
        </div>
        <div class="guarantee-item">
          <div class="guarantee-icon">💶</div>
          <h3>Devis détaillé</h3>
          <p>Le prix, le périmètre et les conditions sont écrits. Toute modification doit être convenue avant exécution.</p>
        </div>
        <div class="guarantee-item">
          <div class="guarantee-icon">🛡️</div>
          <h3>Protections précisées</h3>
          <p>Le matériel et les précautions prévus pour vos biens doivent être décrits dans la proposition.</p>
        </div>
        <div class="guarantee-item">
          <div class="guarantee-icon">🤝</div>
          <h3>Contrôle à la livraison</h3>
          <p>Vérifiez les biens à l’arrivée et inscrivez sans attendre toute réserve sur le document prévu.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Prêt à commencer ?"
    subtitle="Décrivez votre projet en ligne ; votre demande sera étudiée selon les disponibilités."
  />

  <Footer />
</BaseLayout>

<style>
  .ccm-hero {
    background: var(--color-navy);
    color: white;
    padding: 64px 0;
  }
  .ccm-hero h1 { color: white; margin: 12px 0; }
  .ccm-hero-sub { color: rgba(255,255,255,.75); font-size: 1.05rem; max-width: 560px; }

  .steps-list { max-width: 800px; margin: 0 auto; }

  .step-detail {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    position: relative;
  }

  .step-detail__indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step-detail__num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-navy);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
    z-index: 1;
  }
  .step-detail__line {
    width: 2px;
    flex: 1;
    background: var(--color-border);
    margin: 8px 0;
    min-height: 40px;
  }

  .step-detail__body { padding-bottom: 56px; }

  .step-detail__header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .step-detail__icon { font-size: 2rem; }
  .step-detail__title {
    font-size: 1.4rem;
    margin-bottom: 4px;
  }
  .step-detail__duration {
    display: inline-block;
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--color-accent);
    background: rgba(234,125,58,.1);
    padding: 3px 10px;
    border-radius: 100px;
  }

  .step-detail__content p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 14px;
  }

  .step-detail__tips {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-top: 16px;
  }
  .step-detail__tips strong {
    display: block;
    font-size: .82rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--color-navy);
    margin-bottom: 8px;
  }
  .step-detail__tips ul { display: flex; flex-direction: column; gap: 6px; }
  .step-detail__tips li {
    font-size: .88rem;
    color: var(--color-text-light);
    padding-left: 16px;
    position: relative;
  }
  .step-detail__tips li::before { content: '✓'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }

  .guarantees-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .guarantee-item {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    padding: 24px;
    text-align: center;
  }
  .guarantee-icon { font-size: 1.8rem; margin-bottom: 12px; }
  .guarantee-item h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: var(--color-navy); margin-bottom: 8px; }
  .guarantee-item p { font-size: .88rem; color: var(--color-text-light); line-height: 1.5; }

  @media (max-width: 900px) {
    .guarantees-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .step-detail { grid-template-columns: 48px 1fr; gap: 20px; }
    .step-detail__num { width: 44px; height: 44px; font-size: .88rem; }
    .guarantees-grid { grid-template-columns: 1fr; }
  }
</style>
