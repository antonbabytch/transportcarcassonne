---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site.config';

const title = 'Petit déménagement à Carcassonne | Estimation sur devis';
const description = `Petit déménagement à Carcassonne et dans l'Aude : studio, 1-2 meubles ou déménagement étudiant. Repères tarifaires indicatifs, montant confirmé sur devis. ${SITE.phoneDisplay}`;

const cases = [
  {
    icon: '🛏',
    title: 'Studio ou T1',
    price: 'repère dès 250 €',
    desc: 'Studio meublé ou non, déménagement étudiant, mobilier compact. Les moyens nécessaires sont précisés sur le devis.',
  },
  {
    icon: '🛋',
    title: '1 à 3 meubles',
    price: 'repère dès 150 €',
    desc: 'Canapé, lit, armoire ou table à transporter ? Idéal pour les achats Le Bon Coin, Vinted, IKEA.',
  },
  {
    icon: '🎓',
    title: 'Déménagement étudiant',
    price: 'repère dès 220 €',
    desc: 'Chambre d\'étudiant, kitchenette : la prestation est dimensionnée selon le volume, les accès et le trajet.',
  },
  {
    icon: '🏢',
    title: 'Cabinet ou bureau',
    price: 'repère dès 280 €',
    desc: 'Petit bureau ou cabinet : les créneaux et conditions d’intervention sont confirmés avant engagement.',
  },
];

const priceMatrix = [
  { type: '1 meuble (< 200 kg)', distance: '≤ 15 km', price: '150 €' },
  { type: '2-3 meubles', distance: '≤ 30 km', price: '220 €' },
  { type: 'Studio meublé', distance: '≤ 30 km', price: '280 €' },
  { type: 'Studio + cartons', distance: '≤ 50 km', price: '350 €' },
  { type: '5 m³ (chambre étudiant)', distance: '≤ 50 km', price: '320 €' },
  { type: '8 m³ (mini-T1)', distance: '≤ 50 km', price: '420 €' },
];

const faqs = [
  {
    q: 'Quel est le prix minimum d\'un petit déménagement ?',
    a: '150 € constitue uniquement un repère indicatif pour une intervention simple. Le montant réel dépend notamment du volume, des accès, de la distance, du créneau et des services retenus ; seul le devis écrit le confirme.',
  },
  {
    q: 'Faites-vous des déménagements le weekend ?',
    a: 'Les demandes du samedi ou du dimanche sont étudiées selon le planning. La disponibilité et les éventuelles conditions particulières figurent sur le devis.',
  },
  {
    q: 'Pouvez-vous déménager un seul meuble (canapé, armoire) ?',
    a: 'Oui, une demande peut concerner un seul meuble acheté auprès d’un particulier ou d’une enseigne. La faisabilité et la date d’intervention sont confirmées selon le planning.',
  },
  {
    q: 'Faut-il prévoir les cartons ?',
    a: 'Vous pouvez utiliser vos propres cartons. Si des fournitures ou protections doivent être ajoutées à la prestation, leur nature, leur quantité et leur prix sont précisés sur le devis.',
  },
  {
    q: 'Quels sont les délais d\'intervention pour un petit déménagement ?',
    a: 'Le délai dépend du planning, du trajet, du volume et des accès. Une demande urgente peut être étudiée, sans promesse de délai avant confirmation écrite du créneau.',
  },
  {
    q: 'Existe-t-il un tarif particulier pour les étudiants ?',
    a: 'Le prix est établi selon les caractéristiques du projet. Toute remise éventuelle doit apparaître explicitement sur le devis ; aucune réduction générale n’est promise sur cette page.',
  },
];
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE.url}/petit-demenagement/#service`,
    name: 'Petit déménagement à Carcassonne',
    serviceType: 'Petit déménagement',
    url: `${SITE.url}/petit-demenagement/`,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: [
      { '@type': 'City', name: SITE.hq.city },
      { '@type': 'AdministrativeArea', name: 'Aude' },
    ],
  })} />
  <Header />

  <!-- Hero -->
  <section class="petit-hero">
    <div class="container">
      <span class="section-label">Petit déménagement</span>
      <h1>Petit déménagement<br/><span class="highlight">à Carcassonne</span></h1>
      <p class="petit-hero-sub">
        Studio, étudiant, 1 ou 2 meubles, livraison Le Bon Coin : nous nous adaptons
        à votre projet. <strong>Repère indicatif dès 150 €, montant confirmé sur devis.</strong>
      </p>
      <div class="petit-hero-cta">
        <a href="/devis/?service=petit-demenagement&source=petit-demenagement" class="btn btn--primary btn--lg">Devis gratuit →</a>
        <a href={`tel:${SITE.phone}`} class="btn btn--outline btn--lg">📞 {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- Cas typiques -->
  <section class="section">
    <div class="container">
      <div class="section-header" style="text-align:center;margin-bottom:48px">
        <span class="section-label">Pour qui ?</span>
        <h2 class="section-title">4 cas typiques de petit déménagement</h2>
        <p class="section-subtitle">Chaque exemple est indicatif : le devis tient compte du volume, des accès, du trajet et du créneau.</p>
      </div>
      <div class="grid-2 cases-grid">
        {cases.map(c => (
          <div class="case-card">
            <div class="case-icon">{c.icon}</div>
            <h3 class="case-title">{c.title}</h3>
            <div class="case-price">{c.price}</div>
            <p class="case-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Matrice des prix -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" style="text-align:center;margin-bottom:32px">
        <span class="section-label">Repères tarifaires</span>
        <h2 class="section-title">Exemples de budget pour un petit déménagement</h2>
        <p class="section-subtitle">Montants indicatifs et non contractuels : seul un devis personnalisé confirme le prix et le périmètre.</p>
      </div>
      <div class="price-table">
        <div class="price-table__head">
          <span>Type d'intervention</span>
          <span>Distance</span>
          <span>Repère indicatif</span>
        </div>
        {priceMatrix.map((row, i) => (
          <div class:list={['price-table__row', i % 2 === 0 && 'price-table__row--alt']}>
            <span class="pt-type">{row.type}</span>
            <span class="pt-distance">{row.distance}</span>
            <span class="pt-price">{row.price}</span>
          </div>
        ))}
      </div>
      <p class="price-disclaimer">
        💡 Ces exemples ne constituent pas une offre. Le devis détaille les moyens humains et matériels,
        le transport, les protections, les options et les éventuels frais liés aux accès ou au trajet.
      </p>
    </div>
  </section>

  <!-- Ce qui change -->
  <section class="section">
    <div class="container">
      <div class="section-header" style="text-align:center;margin-bottom:48px">
        <span class="section-label">Notre approche</span>
        <h2 class="section-title">Petit déménagement, gros respect</h2>
      </div>
      <div class="grid-3">
        <div class="approach-card">
          <div class="approach-icon">⚡</div>
          <h3>Planning vérifié</h3>
          <p>Nous étudions votre date souhaitée et confirmons le créneau selon les disponibilités.</p>
        </div>
        <div class="approach-card">
          <div class="approach-icon">💼</div>
          <h3>Projet dimensionné</h3>
          <p>Un seul meuble peut faire l’objet d’un devis adapté au trajet, aux accès et à la manutention.</p>
        </div>
        <div class="approach-card">
          <div class="approach-icon">🛡️</div>
          <h3>Même soin</h3>
          <p>Même un petit déménagement bénéficie de notre protection et de notre calage soignés.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" style="text-align:center;margin-bottom:48px">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Petites questions, vraies réponses</h2>
      </div>
      <div class="faq-list">
        {faqs.map(f => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm title="Devis pour votre petit déménagement" subtitle="Décrivez votre projet · réponse selon nos disponibilités" />

  <CTA
    title="Un seul meuble ou un studio à déménager ?"
    subtitle="Décrivez le volume, les accès et le trajet pour recevoir une proposition personnalisée."
  />

  <Footer />
</BaseLayout>

<style>
  .petit-hero {
    background: var(--color-navy);
    color: white;
    padding: 80px 0;
    text-align: center;
  }
  .petit-hero h1 {
    color: white;
    margin: 14px 0 20px;
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
  }
  .petit-hero .highlight { color: var(--color-accent); }
  .petit-hero-sub {
    color: rgba(255,255,255,.78);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 32px;
  }
  .petit-hero-sub strong { color: var(--color-accent); }
  .petit-hero-cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Cases */
  .cases-grid { gap: 24px; }
  .case-card {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: border-color .2s, transform .2s;
  }
  .case-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .case-icon { font-size: 2.2rem; margin-bottom: 14px; }
  .case-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 8px;
  }
  .case-price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 12px;
  }
  .case-desc { color: var(--color-text-light); line-height: 1.6; }

  /* Price table */
  .price-table {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 820px;
    margin: 0 auto;
  }
  .price-table__head {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 16px;
    padding: 16px 28px;
    background: var(--color-bg-alt);
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--color-text-light);
    border-bottom: 1px solid var(--color-border);
  }
  .price-table__row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 16px;
    padding: 16px 28px;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }
  .price-table__row:last-child { border-bottom: none; }
  .price-table__row--alt { background: var(--color-bg); }
  .pt-type { font-weight: 500; color: var(--color-navy); }
  .pt-distance { color: var(--color-text-light); font-size: .9rem; }
  .pt-price {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .price-disclaimer {
    max-width: 820px;
    margin: 24px auto 0;
    padding: 14px 20px;
    background: rgba(168, 112, 63, 0.08);
    border-radius: var(--radius);
    font-size: .88rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  /* Approach */
  .approach-card {
    text-align: center;
    padding: 24px;
  }
  .approach-icon {
    font-size: 2rem;
    width: 60px;
    height: 60px;
    background: rgba(168, 112, 63, 0.1);
    border-radius: 12px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .approach-card h3 {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 8px;
  }
  .approach-card p { color: var(--color-text-light); line-height: 1.55; font-size: .92rem; }

  /* FAQ */
  .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
  .faq-item {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .faq-q {
    padding: 18px 24px;
    font-weight: 600;
    font-size: .95rem;
    color: var(--color-navy);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    font-size: 1.2rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  details[open] .faq-q::after { content: '−'; }
  .faq-a {
    padding: 0 24px 18px;
    font-size: .9rem;
    color: var(--color-text);
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .price-table__head { display: none; }
    .price-table__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .pt-price { font-size: 1.4rem; }
  }
</style>
