---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DeliveryHero from '../components/DeliveryHero.astro';
import RoadDivider from '../components/RoadDivider.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ComboOffer from '../components/ComboOffer.astro';
import TrustStrip from '../components/TrustStrip.astro';
import UrgentTransportSpotlight from '../components/UrgentTransportSpotlight.astro';
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';

const title = 'Transport & déménagement à Carcassonne | Devis local';
const description = `Transport express et déménagement à Carcassonne : meubles, petit volume, retrait magasin et demande urgente aujourd’hui ou demain selon disponibilité. ${SITE.phoneDisplay}`;

const stats = [
  { value: '50', sup: 'km', label: 'Zone locale annoncée' },
  { value: '3', sup: '', label: 'Formules à comparer' },
  { value: '4', sup: '', label: 'Outils gratuits' },
  { value: '7', sup: 'j/7', label: '24h/24 · sur rendez-vous' },
];

const garanties = [
  { num: '01', title: 'Estimation expliquée', desc: 'La fourchette en ligne reste indicative ; le montant applicable figure dans le devis accepté.' },
  { num: '02', title: 'Périmètre écrit', desc: 'Emballage, démontage, accès, stationnement et objets particuliers sont clarifiés avant engagement.' },
  { num: '03', title: 'Identité vérifiable', desc: `Entreprise déclarée sous le SIRET ${SITE.siret}, avec un contact direct affiché sur le site.` },
  { num: '04', title: 'Documents à contrôler', desc: 'Le devis et les documents utiles permettent de vérifier les informations retenues pour le projet.' },
  { num: '05', title: 'Données protégées', desc: 'Les photos sont facultatives, limitées au devis et ne doivent contenir aucun document sensible.' },
  { num: '06', title: 'Preuves réelles uniquement', desc: 'Aucun faux avis, faux label ou chantier reconstitué ne doit remplacer une preuve autorisée.' },
];

const fourgons = [
  { name: 'Gabarit autour de 12 m³', desc: 'Un repère courant pour un petit volume, à confirmer après inventaire et contrôle des accès.', cap: '≈ 12 m³', payload: 'Selon véhicule' },
  { name: 'Gabarit autour de 20 m³', desc: 'Un repère pour un logement plus fourni ; plusieurs rotations peuvent rester nécessaires.', cap: '≈ 20 m³', payload: 'Selon véhicule' },
];

const steps = [
  { num: '01', title: 'Décrivez le projet', desc: 'Utilisez le devis intelligent ou appelez-nous avec le trajet, le volume et les accès.' },
  { num: '02', title: 'Visite ou inventaire', desc: 'Le volume, les accès et les prestations utiles sont précisés avant l’établissement du devis.' },
  { num: '03', title: 'Organisation confirmée', desc: 'Le créneau, les moyens prévus et le périmètre de la prestation sont repris dans les documents acceptés.' },
  { num: '04', title: 'Livraison & réception', desc: 'La livraison et les éventuelles options de remontage suivent le périmètre écrit du devis.' },
];

const specialties = [
  { title: 'Déménagement d’entreprise', text: 'Bureaux, commerces et activités : inventaire, accès et continuité à cadrer avant intervention.', href: '/demenagement-entreprise-carcassonne/' },
  { title: 'Accompagnement senior', text: 'Une préparation progressive et un périmètre d’aide clairement défini avec la personne concernée.', href: '/demenagement-senior-carcassonne/' },
  { title: 'Emballage et cartons', text: 'Matériel, objets fragiles et responsabilités détaillés dans la formule et le devis.', href: '/emballage-cartons-carcassonne/' },
];

const faqs = [
  { q: 'Pouvez-vous intervenir aujourd’hui ou demain à Carcassonne ?', a: 'Une demande urgente locale peut être étudiée immédiatement selon le planning, le volume, les accès et les moyens nécessaires. Appelez avec les deux adresses, l’inventaire et l’heure limite ; le créneau et le tarif sont confirmés avant intervention.' },
  { q: 'Combien coûte un déménagement à Carcassonne ?', a: 'Les repères publiés commencent actuellement à 450 € pour un studio et 650 € pour un T2 local. Ils restent indicatifs : le volume, la distance, les accès, la date et les options déterminent le devis personnalisé.' },
  { q: 'Intervenez-vous hors de Carcassonne ?', a: `Oui, nous intervenons dans un rayon de ${SITE.serviceRadius} km autour de Carcassonne : Limoux, Castelnaudary, Lézignan-Corbières, Narbonne, Trèbes, Bram et environs. Nous réalisons aussi des déménagements longue distance vers toute la France.` },
  { q: 'Proposez-vous l\'emballage des cartons ?', a: 'L’emballage peut être étudié comme option. Le devis doit préciser qui fournit les cartons, quels objets sont emballés et quels matériaux sont compris.' },
  { q: 'Comment protégez-vous les objets transportés ?', a: 'Les protections et la manutention prévues dépendent de l’inventaire, des accès et de la valeur déclarée. Elles doivent être décrites dans le devis, notamment pour les objets fragiles ou de grande valeur.' },
  { q: 'Faites-vous un petit déménagement (1-2 meubles) ?', a: 'Les petits volumes et transports de quelques meubles peuvent être étudiés selon le trajet, les accès, le poids et le planning. Le prix applicable est celui du devis écrit.' },
  { q: 'Transportez-vous les pianos et objets lourds ?', a: 'La faisabilité doit être vérifiée à partir du type d’objet, de son poids, des passages, des étages et des moyens nécessaires. Décrivez précisément l’objet et joignez des photos au devis.' },
  { q: 'Comment obtenir un devis ?', a: 'Remplissez le devis intelligent ou appelez-nous directement au ' + SITE.phoneDisplay + '. Préparez le trajet, la date, le volume et les contraintes d’accès pour faciliter l’évaluation.' },
];

const marquee = ['Transport express local', 'Retrait en magasin', 'Déménagement local', 'Longue distance', 'International', 'Transport de meubles', 'Piano & objets lourds', 'Évacuation déchets', 'Petit déménagement'];
const guides = [
  {
    title: 'Autorisation de stationnement à Carcassonne',
    desc: 'Délai, demande municipale et règles particulières pour la Bastide et la Cité.',
    href: '/blog/autorisation-stationnement-demenagement-carcassonne/',
  },
  {
    title: 'Checklist des 4 semaines avant le jour J',
    desc: 'Un planning simple pour les cartons, les accès, l’inventaire et les démarches.',
    href: '/blog/checklist-demenagement-4-semaines/',
  },
];
const priceFmt = (n: number) => new Intl.NumberFormat('fr-FR').format(n) + ' €';
---

<BaseLayout
  title={title}
  description={description}
  preloadImage="/video/poster.webp"
  ogImageAlt="Fourgon de Transport Carcassonne pour un déménagement dans l’Aude"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  })} />
  <Header />

  <!-- ============ DELIVERY HERO (corner video card, scrubbed) ============ -->
  <DeliveryHero />

  <TrustStrip />

  <UrgentTransportSpotlight />

  <!-- ============ MARQUEE ============ -->
  <div class="marquee">
    <div class="marquee-in">
      <span>{marquee.map(m => (<>{m} <i class="dot">·</i> </>))}</span>
      <span>{marquee.map(m => (<>{m} <i class="dot">·</i> </>))}</span>
    </div>
  </div>

  <!-- ============ STATS ============ -->
  <section class="d-stats">
    <div class="container stats-row">
      {stats.map((s, i) => (
        <div class="stat reveal" data-i={i}>
          <div class="stat-num">{s.value}<sup>{s.sup}</sup></div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="d-section" id="services">
    <div class="container">
      <div class="d-head reveal">
        <h2 class="display">Nos <em>prestations.</em></h2>
        <p>Du déménagement local aux trajets plus longs, chaque demande est étudiée selon le volume, les accès et les moyens nécessaires.</p>
      </div>
      <div class="svc-grid">
        {SERVICES.map((s, i) => (
          <a href={`/services/${s.slug}`} class="svc-item reveal" data-i={i}>
            <div class="svc-num">— {String(i + 1).padStart(2, '0')}</div>
            <h3>{s.name}</h3>
            <p>{s.description}</p>
            <div class="svc-price">repère indicatif dès {priceFmt(s.priceFrom)}</div>
            <span class="svc-link">En savoir plus</span>
          </a>
        ))}
        <a href="/devis/?source=cas-particulier" class="svc-item svc-item--dark reveal" data-i={6}>
          <div class="svc-num">— Cas particulier ?</div>
          <h3>Décrivez votre<br/>situation.</h3>
          <p>Volume hors normes, objet fragile ou accès complexe : décrivez les faits pour que nous puissions étudier une solution adaptée.</p>
          <span class="svc-link">Nous contacter</span>
        </a>
      </div>
    </div>
  </section>

  <RoadDivider />

  <!-- ============ FLOTTE ============ -->
  <section class="d-section d-section--alt">
    <div class="container">
      <div class="fleet-grid reveal">
        <div class="fleet-left">
          <span class="mono-label">Repères de volume</span>
          <h2 class="display">Choisir le bon gabarit<br/>pour <em>le projet.</em></h2>
          <p>Le gabarit du véhicule dépend du volume, de la charge, des accès et du trajet. Les valeurs ci-contre sont des repères : le moyen réellement prévu doit apparaître dans l’organisation confirmée.</p>
        </div>
        <div class="fleet-cards">
          {fourgons.map(f => (
            <div class="fleet-card">
              <h3>{f.name}</h3>
              <p>{f.desc}</p>
              <div class="fleet-specs">
                <div><span class="spec-k">Capacité</span><span class="spec-v">{f.cap}</span></div>
                <div><span class="spec-k">Charge utile</span><span class="spec-v">{f.payload}</span></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GARANTIES ============ -->
  <section class="d-section d-dark">
    <div class="container">
      <div class="d-head d-head--center reveal">
        <h2 class="display">Six repères,<br/>une décision <em>éclairée.</em></h2>
        <p>Des informations contrôlables sont plus utiles qu’une longue liste de promesses générales.</p>
      </div>
      <div class="gar-grid">
        {garanties.map((g, i) => (
          <div class="gar reveal" data-i={i}>
            <div class="gar-num">— {g.num}</div>
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ZONE ============ -->
  <section class="d-section">
    <div class="container">
      <div class="zone-grid">
        <div class="zone-left reveal">
          <span class="mono-label">Zone d'intervention</span>
          <h2 class="display">Carcassonne<br/>et <em>environs.</em></h2>
          <p>Nous intervenons dans un rayon de {SITE.serviceRadius} km autour de Carcassonne, et bien au-delà pour la longue distance. Cliquez sur votre commune pour votre page dédiée.</p>
        </div>
        <div class="zone-cities">
          {CITIES.map((c, i) => (
            <a href={`/demenagement-${c.slug}`} class={(i < 5 ? 'zone-city main' : 'zone-city') + ' reveal'} data-i={i}>{c.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GUIDES ============ -->
  <section class="d-section d-section--alt">
    <div class="container">
      <div class="d-head reveal">
        <h2 class="display">Préparer votre<br/><em>déménagement.</em></h2>
        <p>Nos guides pratiques répondent aux questions concrètes avant le jour J, avec les règles locales vérifiées.</p>
      </div>
      <div class="guide-grid">
        {guides.map((guide, i) => (
          <article class="guide-card reveal" data-i={i}>
            <span class="guide-card__num">0{i + 1}</span>
            <h3><a href={guide.href}>{guide.title}</a></h3>
            <p>{guide.desc}</p>
            <a class="guide-card__link" href={guide.href}>Lire le guide <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <a class="all-guides reveal" href="/blog/">Voir tous les conseils <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ============ METHODE ============ -->
  <section class="d-section">
    <div class="container">
      <div class="d-head reveal"><h2 class="display">Notre <em>méthode.</em></h2><p>Un processus simple et transparent en quatre étapes, du premier appel à l'installation chez vous.</p></div>
      <div class="steps-grid">
        {steps.map((s, i) => (
          <div class="step reveal" data-i={i}>
            <div class="step-num">— Étape {s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SPECIALITES ============ -->
  <section class="d-section d-dark">
    <div class="container">
      <div class="d-head reveal"><h2 class="display">Des besoins<br/><em>différents.</em></h2><p>Chaque situation mérite une page utile et un devis qui distingue clairement les prestations incluses.</p></div>
      <div class="specialty-grid">
        {specialties.map((item, i) => (
          <a href={item.href} class="specialty-card reveal" data-i={i}>
            <span>0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <strong>Voir la prestation →</strong>
          </a>
        ))}
      </div>
      <a class="specialty-formulas reveal" href="/formules/">Comparer les trois formules →</a>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="d-section">
    <div class="container">
      <div class="d-head d-head--center reveal"><h2 class="display">Questions <em>fréquentes.</em></h2></div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq reveal" data-i={i}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RoadDivider />

  <ComboOffer />
  <QuoteForm title="Demandez votre devis gratuit" subtitle="Trajet, volume, accès et date · 24h/24, 7j/7 sur rendez-vous" />
  <Footer />
</BaseLayout>

<style>
  .display { font-family: 'Instrument Serif', serif; font-weight: 400; letter-spacing: -.02em; line-height: 1; }
  .display em, em { font-style: italic; color: var(--accent); }
  .mono-label { font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: var(--accent); font-weight: 500; display: block; margin-bottom: 22px; }

  .guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .guide-card { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 30px; }
  .guide-card__num { display: block; color: var(--accent-deep); font-size: 11px; letter-spacing: .18em; margin-bottom: 22px; }
  .guide-card h3 { font-size: 1.55rem; margin-bottom: 12px; }
  .guide-card h3 a:hover { color: var(--accent-deep); }
  .guide-card p { color: var(--text-muted); margin-bottom: 22px; }
  .guide-card__link, .all-guides { color: var(--accent-deep); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .all-guides { display: inline-block; margin-top: 24px; }

  @media (max-width: 700px) { .guide-grid { grid-template-columns: 1fr; } }

  /* HERO content (over 3D scene) */
  .hero-content { position: relative; max-width: 600px; }
  .hero-screen { position: absolute; max-width: 620px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 13px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin-bottom: 26px; }
  .hero-eyebrow span { width: 32px; height: 1px; background: var(--accent); }
  .hero-title { font-family: 'Instrument Serif', serif; font-weight: 400; color: var(--text-on-dark); font-size: clamp(52px, 7vw, 102px); line-height: .97; letter-spacing: -.02em; margin-bottom: 24px; }
  .hero-sub { font-size: 18px; color: var(--text-on-dark-muted); max-width: 460px; margin-bottom: 34px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-hero-ghost { background: transparent; color: var(--text-on-dark); border: 1px solid var(--line-dark); }
  .btn-hero-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* MARQUEE */
  .marquee { background: var(--bg-dark); border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); padding: 18px 0; overflow: hidden; }
  .marquee-in { display: flex; gap: 46px; white-space: nowrap; animation: marq 40s linear infinite; color: var(--text-on-dark-muted); font-size: 14px; }
  .marquee-in span { display: flex; align-items: center; gap: 46px; padding-right: 46px; }
  .marquee .dot { color: var(--accent); font-style: normal; }
  @keyframes marq { to { transform: translateX(-50%); } }

  /* SECTION SHELL */
  .d-section { padding: 120px 0; background: var(--bg); }
  .d-section--alt { background: var(--bg-soft); }
  .d-dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .d-head { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: end; margin-bottom: 64px; }
  .d-head h2 { font-size: clamp(38px, 5vw, 68px); line-height: 1; }
  .d-head p { color: var(--text-muted); font-size: 17px; max-width: 480px; }
  .d-dark .d-head p { color: var(--text-on-dark-muted); }
  .d-head--center { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  .d-head--center p { margin: 0 auto; }

  /* STATS */
  .d-stats { background: var(--bg-dark); color: var(--text-on-dark); }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 44px 24px; border-right: 1px solid var(--line-dark); text-align: center; }
  .stat:last-child { border-right: none; }
  .stat-num { font-family: 'Instrument Serif', serif; font-size: 60px; line-height: 1; color: var(--text-on-dark); }
  .stat-num sup { font-size: 20px; color: var(--accent); font-style: italic; margin-left: 2px; }
  .stat-label { font-size: 13px; color: var(--text-on-dark-muted); margin-top: 10px; }

  /* SERVICES */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .svc-item { position: relative; background: var(--bg); padding: 42px 34px; min-height: 300px; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: background .3s var(--ease-out), transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .svc-item:hover { background: var(--bg-card); transform: translateY(-4px); box-shadow: var(--shadow-soft-light); z-index: 1; }
  .svc-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 13px; color: var(--text-muted); margin-bottom: 32px; }
  .svc-item h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 29px; line-height: 1.08; margin-bottom: 14px; }
  .svc-item p { color: var(--text-muted); font-size: 14px; flex: 1; }
  .svc-price { font-family: 'Instrument Serif', serif; font-style: italic; color: var(--accent); font-size: 18px; margin: 18px 0; }
  .svc-link { font-size: 11px; text-transform: uppercase; letter-spacing: .18em; display: inline-flex; align-items: center; gap: 8px; }
  .svc-link::after { content: '→'; transition: transform .3s; }
  .svc-item:hover .svc-link::after { transform: translateX(4px); }
  .svc-item--dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .svc-item--dark:hover { background: var(--bg-dark-alt); box-shadow: var(--shadow-soft); }
  .svc-item--dark h3 { color: var(--text-on-dark); }
  .svc-item--dark p { color: var(--text-on-dark-muted); }
  .svc-item--dark .svc-num, .svc-item--dark .svc-link { color: var(--accent); }

  /* FLEET */
  .fleet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .fleet-left h2 { font-size: clamp(34px, 4.4vw, 56px); line-height: 1.04; margin-bottom: 26px; }
  .fleet-left p { color: var(--text-muted); font-size: 16px; line-height: 1.65; }
  .fleet-cards { display: grid; gap: 16px; }
  .fleet-card { background: var(--bg-card); border: 1px solid var(--line); padding: 30px; transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out), border-color .35s var(--ease-out); }
  .fleet-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft-light); border-color: var(--accent); }
  .fleet-card h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 26px; margin-bottom: 10px; }
  .fleet-card p { color: var(--text-muted); font-size: 14px; margin-bottom: 22px; }
  .fleet-specs { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); padding-top: 18px; }
  .fleet-specs div { display: flex; flex-direction: column; gap: 4px; }
  .spec-k { font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: var(--text-muted); }
  .spec-v { font-family: 'Instrument Serif', serif; font-size: 26px; color: var(--accent); }

  /* GARANTIES */
  .gar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); }
  .gar { position: relative; background: var(--bg-dark); padding: 38px 32px; transition: background .3s var(--ease-out), transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .gar:hover { background: var(--bg-dark-alt); transform: translateY(-4px); box-shadow: var(--shadow-soft); z-index: 1; }
  .gar-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 13px; color: var(--accent); margin-bottom: 26px; }
  .gar h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 24px; color: var(--text-on-dark); margin-bottom: 14px; }
  .gar p { font-size: 14px; color: var(--text-on-dark-muted); line-height: 1.6; }

  /* ZONE */
  .zone-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .zone-left h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1; margin-bottom: 24px; }
  .zone-left p { color: var(--text-muted); font-size: 16px; line-height: 1.65; }
