---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site.config';

const title = 'Contact | TransDéménage Carcassonne — Devis gratuit sous 2h';
const description = `Contactez TransDéménage Carcassonne pour votre déménagement. Téléphone : ${SITE.phoneDisplay}. WhatsApp, email. Réponse sous 2h. Lun-Sam 8h-19h.`;
---

<BaseLayout title={title} description={description}>
  <Header />

  <section class="contact-hero">
    <div class="container">
      <span class="section-label">Nous contacter</span>
      <h1>Demandez votre devis gratuit</h1>
      <p class="contact-hero-sub">
        Réponse sous 2h du lundi au samedi de 8h à 19h. Devis gratuit et sans engagement.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <!-- Contact infos -->
      <div class="contact-info">
        <h2>Nos coordonnées</h2>

        <div class="contact-cards">
          <a href={`tel:${SITE.phone}`} class="contact-card contact-card--primary">
            <div class="contact-card__icon">📞</div>
            <div class="contact-card__content">
              <div class="contact-card__label">Téléphone</div>
              <div class="contact-card__value">{SITE.phoneDisplay}</div>
              <div class="contact-card__sub">Appel direct</div>
            </div>
          </a>

          <a
            href={`https://wa.me/${SITE.phoneWhatsapp}`}
            class="contact-card contact-card--wa"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="contact-card__icon">💬</div>
            <div class="contact-card__content">
              <div class="contact-card__label">WhatsApp</div>
              <div class="contact-card__value">{SITE.phoneDisplay}</div>
              <div class="contact-card__sub">Message instantané</div>
            </div>
          </a>

          <a href={`mailto:${SITE.email}`} class="contact-card">
            <div class="contact-card__icon">✉️</div>
            <div class="contact-card__content">
              <div class="contact-card__label">Email</div>
              <div class="contact-card__value">{SITE.email}</div>
              <div class="contact-card__sub">Réponse sous 4h</div>
            </div>
          </a>

          <div class="contact-card">
            <div class="contact-card__icon">📍</div>
            <div class="contact-card__content">
              <div class="contact-card__label">Adresse</div>
              <div class="contact-card__value">{SITE.hq.city} {SITE.hq.postalCode}</div>
              <div class="contact-card__sub">{SITE.hq.region}</div>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">🕐</div>
            <div class="contact-card__content">
              <div class="contact-card__label">Horaires</div>
              <div class="contact-card__value">Lun–Sam 8h–19h</div>
              <div class="contact-card__sub">Urgences sur appel</div>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">🏢</div>
            <div class="contact-card__content">
              <div class="contact-card__label">SIRET</div>
              <div class="contact-card__value">{SITE.siret}</div>
              <div class="contact-card__sub">Entreprise déclarée</div>
            </div>
          </div>
        </div>

        <div class="contact-zone">
          <h3>Zone d'intervention</h3>
          <p>
            Carcassonne et environs dans un rayon de {SITE.serviceRadius} km.
            Déménagements longue distance vers toute la France.
            International : Espagne, Italie, Belgique.
          </p>
        </div>
      </div>

      <!-- Placeholder for map -->
      <div class="contact-map">
        <div class="map-placeholder">
          <span class="map-icon">🗺️</span>
          <span class="map-label">Carcassonne, Aude (11000)</span>
          <span class="map-sub">Zone d'intervention : rayon 50 km</span>
        </div>
      </div>
    </div>
  </section>

  <QuoteForm />

  <Footer />
</BaseLayout>

<style>
  .contact-hero {
    background: var(--color-navy);
    color: white;
    padding: 64px 0;
  }
  .contact-hero h1 { color: white; margin: 12px 0; }
  .contact-hero-sub { color: rgba(255,255,255,.75); font-size: 1.05rem; max-width: 480px; }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-info h2 { margin-bottom: 28px; }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 32px;
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .contact-card:hover { border-color: var(--color-navy); box-shadow: var(--shadow-sm); }
  .contact-card--primary { border-color: var(--color-accent); }
  .contact-card--wa { border-color: #25D366; }

  .contact-card__icon { font-size: 1.5rem; flex-shrink: 0; }
  .contact-card__label { font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; color: var(--color-text-light); margin-bottom: 2px; }
  .contact-card__value { font-size: .95rem; font-weight: 700; color: var(--color-navy); margin-bottom: 2px; }
  .contact-card__sub { font-size: .78rem; color: var(--color-text-light); }

  .contact-zone {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 20px;
  }
  .contact-zone h3 {
    font-family: var(--font-sans);
    font-size: .9rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 8px;
  }
  .contact-zone p { font-size: .88rem; color: var(--color-text-light); line-height: 1.6; }

  .contact-map { position: sticky; top: 80px; }
  .map-placeholder {
    background: var(--color-bg-alt);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 32px;
  }
  .map-icon { font-size: 3rem; }
  .map-label { font-weight: 700; color: var(--color-navy); font-size: 1.1rem; }
  .map-sub { font-size: .85rem; color: var(--color-text-light); }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-map { display: none; }
  }
  @media (max-width: 500px) {
    .contact-cards { grid-template-columns: 1fr; }
  }
</style>
