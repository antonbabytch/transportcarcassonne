---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import { GROUPED_TRIPS } from '../data/groupedTrips';

const now = new Date();
now.setHours(0, 0, 0, 0);
const activeTrips = GROUPED_TRIPS
  .filter((trip) => new Date(`${trip.date}T00:00:00`) >= now && trip.availableVolumeM3 > 0)
  .sort((a, b) => a.date.localeCompare(b.date));
const formatDate = (date: string) => new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
}).format(new Date(`${date}T12:00:00Z`));
const title = 'Trajets groupés et retours à vide depuis Carcassonne';
const description = 'Consultez les places disponibles sur nos trajets groupés depuis ou vers Carcassonne. Une solution à étudier pour les petits volumes et dates flexibles.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: 'Trajets groupés' }]} />

  <main>
    <section class="trips-hero">
      <div class="container">
        <span class="section-label">Petits volumes · dates flexibles</span>
        <h1>Trajets groupés depuis et vers Carcassonne</h1>
        <p>Lorsqu’un véhicule dispose encore de place sur un trajet confirmé, plusieurs petits volumes peuvent partager une partie du transport. La faisabilité et le tarif sont toujours validés par écrit avant réservation.</p>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="availability-head">
          <div>
            <span class="section-label">Disponibilités réelles</span>
            <h2>Prochains trajets publiés</h2>
          </div>
          <a class="btn btn--outline" href="/devis/?service=trajet-groupe&source=trajets-groupes">Proposer mon trajet</a>
        </div>

          <div class="trips-grid" data-trip-list hidden={activeTrips.length === 0}>
            {activeTrips.map((trip) => (
              <article class="trip-card" data-trip-date={trip.date}>
                <time datetime={trip.date}>{formatDate(trip.date)}</time>
                <h3>{trip.departure} <span aria-hidden="true">→</span> {trip.arrival}</h3>
                <p><strong>{trip.availableVolumeM3} m³</strong> encore disponibles</p>
                {trip.note && <small>{trip.note}</small>}
                <a href={`/devis/?service=trajet-groupe&depart=${encodeURIComponent(trip.departure)}&arrivee=${encodeURIComponent(trip.arrival)}&date=${trip.date}&volume_max=${trip.availableVolumeM3}&source=trajets-groupes`}>
                  Vérifier la compatibilité →
                </a>
              </article>
            ))}
          </div>
          <div class="empty-state" data-trip-empty hidden={activeTrips.length > 0}>
            <span aria-hidden="true">↗</span>
            <div>
              <h3>Aucune place n’est publiée pour le moment</h3>
              <p>Indiquez votre trajet, votre volume et la flexibilité de vos dates. Nous vous répondrons uniquement si une solution compatible peut être proposée.</p>
            </div>
            <a class="btn btn--primary" href="/devis/?service=trajet-groupe&source=trajets-groupes">Décrire mon trajet →</a>
          </div>
      </div>
    </section>

    <section class="section">
      <div class="container process-grid">
        <div>
          <span class="section-label">Fonctionnement</span>
          <h2>Une option, pas une promesse automatique</h2>
          <p>Le groupage dépend de la place disponible, de la compatibilité des biens, des accès et de la souplesse des dates. Une demande n’engage ni le client ni l’entreprise tant qu’un devis détaillé n’a pas été accepté.</p>
        </div>
        <ol>
          <li><strong>Décrivez le besoin</strong><span>Route, volume, dates possibles et objets particuliers.</span></li>
          <li><strong>Nous vérifions la compatibilité</strong><span>Place, organisation, protection et délais.</span></li>
          <li><strong>Vous recevez une proposition écrite</strong><span>Prix, date, prestations et conditions clairement indiqués.</span></li>
        </ol>
      </div>
    </section>

    <CTA
      title="Votre date est flexible ?"
      subtitle="Décrivez votre trajet : nous vérifierons les possibilités de groupage ou de retour."
      btnLabel="Proposer mon trajet →"
      btnHref="/devis/?service=trajet-groupe&source=trajets-groupes"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .trips-hero { padding: 78px 0; background: var(--bg-dark); color: var(--text-on-dark); text-align: center; }
  .trips-hero h1 { color: var(--text-on-dark); max-width: 820px; margin: 0 auto 18px; }
  .trips-hero p { color: var(--text-on-dark-muted); max-width: 760px; margin: 0 auto; font-size: 1.04rem; }
  .availability-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .trips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .trip-card { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; }
  .trip-card time { display: block; color: var(--accent-deep); text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 700; }
  .trip-card h3 { margin: 10px 0; font-size: 1.35rem; }
  .trip-card p { color: var(--text-muted); }
  .trip-card small { display: block; color: var(--text-muted); margin-top: 8px; }
  .trip-card a { display: inline-block; margin-top: 18px; color: var(--accent-deep); font-weight: 700; }
  .empty-state { display: grid; grid-template-columns: auto 1fr auto; gap: 22px; align-items: center; background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px; }
  .empty-state > span { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-deep); font-size: 1.5rem; }
  .empty-state h3 { margin-bottom: 5px; }
  .empty-state p { color: var(--text-muted); max-width: 640px; }
  .process-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: start; }
  .process-grid > div p { color: var(--text-muted); margin-top: 16px; }
  .process-grid ol { list-style: none; counter-reset: step; display: grid; gap: 12px; }
  .process-grid li { counter-increment: step; display: grid; grid-template-columns: 40px 1fr; column-gap: 14px; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-card); }
  .process-grid li::before { content: counter(step, decimal-leading-zero); grid-row: 1 / 3; color: var(--accent); font-family: var(--font-display); font-size: 1.3rem; }
  .process-grid li span { color: var(--text-muted); font-size: .88rem; }
  @media (max-width: 850px) { .trips-grid { grid-template-columns: 1fr; } .process-grid { grid-template-columns: 1fr; gap: 30px; } }
  @media (max-width: 680px) { .availability-head { align-items: stretch; flex-direction: column; } .empty-state { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var cards = Array.from(document.querySelectorAll('[data-trip-date]'));
    var list = document.querySelector('[data-trip-list]');
    var empty = document.querySelector('[data-trip-empty]');
    var now = new Date();
    cards.forEach(function (card) {
      var date = card.getAttribute('data-trip-date');
      var endOfDay = date ? new Date(date + 'T23:59:59') : null;
      if (!endOfDay || Number.isNaN(endOfDay.getTime()) || endOfDay < now) card.setAttribute('hidden', '');
    });
    var visibleCount = cards.filter(function (card) { return !card.hasAttribute('hidden'); }).length;
    if (list) list.toggleAttribute('hidden', visibleCount === 0);
    if (empty) empty.toggleAttribute('hidden', visibleCount > 0);
  })();
</script>
