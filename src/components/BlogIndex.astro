---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTA from './CTA.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { SITE } from '../data/site.config';
import { BLOG_EN } from '../data/blogEnglish';

interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const en = lang === 'en';
const locale = en ? 'en-GB' : 'fr-FR';
const title = en ? 'Carcassonne Moving Blog: Advice & News' : 'Blog déménagement Carcassonne : conseils et actualités';
const description = en
  ? `Moving advice, equipment and news from ${SITE.name}. See our Pianoplan stair climber and photos of our work in Carcassonne.`
  : `Conseils de déménagement, équipement et actualités de ${SITE.name}. Découvrez notre Pianoplan et nos photos de réalisations à Carcassonne.`;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const formatDate = (date: Date) => new Intl.DateTimeFormat(locale, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
}).format(date);
---

<BaseLayout title={title} description={description} lang={locale}>
  <Header lang={lang} />
  <Breadcrumbs lang={lang} items={[{ name: en ? 'Home' : 'Accueil', href: en ? '/en/' : '/' }, { name: 'Blog' }]} />

  <main>
    <section class="blog-hero">
      <div class="container">
        <span class="section-label">{en ? 'The Transport Carcassonne blog' : 'Le blog de Transport Carcassonne'}</span>
        <h1>{en ? 'Moving advice, equipment and company news' : 'Conseils, équipement et vie de l’entreprise'}</h1>
        <p class="blog-hero-sub">
          {en
            ? 'Practical moving tips, equipment updates and photos of our work in Carcassonne and the Aude.'
            : 'Nos conseils pratiques pour déménager, les nouveautés de notre matériel et des images de notre travail à Carcassonne et dans l’Aude.'}
        </p>
        <div class="blog-links">
          <a href={en ? '/en/our-work/' : '/realisations/'}>{en ? 'Our work in photos' : 'Nos réalisations en photos'}</a>
          <a href={en ? '/en/pianoplan-stair-climber-carcassonne/' : '/monte-escalier-pianoplan-carcassonne/'}>{en ? 'Our Pianoplan stair climber' : 'Notre équipement Pianoplan'}</a>
          {en && <a href="/en/moving-to-carcassonne/">Moving to Carcassonne guide</a>}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="article-grid">
          {posts.map((post, index) => {
            const slug = postSlug(post.id);
            const href = `/blog/${slug}/`;
            const translated = en ? BLOG_EN[slug] : undefined;
            const cardTitle = translated?.title ?? post.data.title;
            const cardLang = en && !translated ? 'fr' : undefined;
            return (
              <article class:list={['article-card', index === 0 && 'article-card--featured']}>
                {post.data.image && <a href={href} tabindex="-1" aria-hidden="true"><img class="article-card__image" src={post.data.image} alt="" width="1024" height="683" loading="lazy" decoding="async" /></a>}
                <div class="article-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>·</span>
                  <span lang={cardLang}>{translated?.category ?? post.data.tags[0] ?? 'Conseils'}</span>
                </div>
                <h2 lang={cardLang}><a href={href} hreflang="fr">{cardTitle}</a></h2>
                <p lang={cardLang}>{translated?.description ?? post.data.description}</p>
                <a class="article-card__link" href={href} hreflang="fr" aria-label={en ? `Read ${cardTitle} (in French)` : `Lire : ${cardTitle}`}>
                  {en ? 'Read article (in French)' : 'Lire l’article'}
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <CTA
    title={en ? 'Planning a move in the Aude?' : "Un projet de déménagement dans l'Aude ?"}
    subtitle={en ? 'Tell us about your route, load and access for a personalised reply.' : 'Décrivez-nous votre trajet, votre volume et les accès pour recevoir une réponse personnalisée.'}
    btnLabel={en ? 'Request a free quote' : undefined}
    btnHref={en ? '/en/quote/?source=cta' : undefined}
  />
  <Footer lang={lang} />
</BaseLayout>

<style>
  .blog-hero {
    background: var(--color-navy);
    color: white;
    padding: 72px 0;
  }
  .blog-hero h1 { color: white; margin: 12px 0 16px; max-width: 760px; }
  .blog-hero-sub { color: rgba(255,255,255,.78); font-size: 1.08rem; max-width: 680px; }
  .blog-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 24px; }
  .blog-links a { color: #e5b789; text-decoration: underline; text-underline-offset: 4px; }
  .article-card__image { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 10px; margin-bottom: 24px; }
  .article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .article-card {
    background: var(--color-white);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    min-height: 310px;
  }
  .article-card--featured { border-color: var(--color-accent); }
  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--color-text-light);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 18px;
  }
  .article-card h2 { font-size: 1.65rem; margin-bottom: 14px; }
  .article-card h2 a:hover { color: var(--color-accent-deep); }
  .article-card p { color: var(--color-text-light); line-height: 1.7; margin-bottom: 24px; }
  .article-card__link {
    margin-top: auto;
    color: var(--color-accent-deep);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 720px) {
    .article-grid { grid-template-columns: 1fr; }
    .article-card { min-height: 0; padding: 26px 22px; }
  }
</style>
