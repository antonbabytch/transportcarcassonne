---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTA from './CTA.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { MovingRoute } from '../data/movingRoutes';
import { MOVING_ROUTES } from '../data/movingRoutes';
import { SITE } from '../data/site.config';

const { route } = Astro.props as { route: MovingRoute };
const canonical = `${SITE.url}/demenagement-carcassonne-${route.slug}/`;
const quoteHref = `/devis/?${new URLSearchParams({
  source: `route-${route.slug}`,
  service: 'demenagement-longue-distance',
  depart: 'Carcassonne',
  arrivee: route.destination,
}).toString()}`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: `Déménagement Carcassonne–${route.destination}`,
  serviceType: 'Déménagement longue distance',
  description: route.metaDescription,
  url: canonical,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: [
    { '@type': 'City', name: 'Carcassonne' },
    { '@type': 'City', name: route.destination },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: route.faqs.map(item => ({
    '@type': 'Question', name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={route.metaTitle} description={route.metaDescription} canonical={canonical}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />
  <Breadcrumbs items={[{ name: 'Accueil', href: '/' }, { name: 'Longue distance', href: '/services/demenagement-longue-distance/' }, { name: `Carcassonne–${route.destination}` }]} />

  <main>
    <section class="route-hero">
      <div class="container">
        <span class="section-label">Carcassonne → {route.destination}</span>
        <h1>Déménagement de Carcassonne à {route.destination}</h1>
        <p>{route.intro}</p>
        <div class="route-facts" aria-label="Repères routiers indicatifs">
          <div><span>Distance indicative</span><strong>{route.distance}</strong></div>
          <div><span>Conduite indicative</span><strong>{route.drivingTime}</strong></div>
          <div><span>Axe courant</span><strong>{route.corridor}</strong></div>
        </div>
        <p class="route-disclaimer">Repères non contractuels : l’itinéraire et les temps dépendent des adresses, de la circulation, des pauses et des conditions du jour.</p>
        <div class="route-actions">
          <a href={quoteHref} class="btn btn--primary btn--lg">Demander un devis pour ce trajet</a>
          <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container route-overview">
        <div><span class="section-label">Profil du trajet</span><h2>Ce qu’il faut intégrer au planning</h2></div>
        <div class="route-copy">{route.routeContext.map(paragraph => <p>{paragraph}</p>)}</div>
      </div>
    </section>

    <section class="section route-access">
      <div class="container route-access__layout">
        <div>
          <span class="section-label">Adresse d’arrivée</span>
          <h2>{route.accessTitle}</h2>
          <ul>{route.accessNotes.map(note => <li>{note}</li>)}</ul>
        </div>
        <aside>
          <span>Source municipale</span>
          <h3>{route.officialParkingLabel}</h3>
          <p>{route.officialParkingSummary}</p>
          <a href={route.officialParkingUrl} target="_blank" rel="noopener noreferrer">Consulter la démarche officielle ↗</a>
          {route.secondarySourceUrl && route.secondarySourceLabel && (
            <a href={route.secondarySourceUrl} target="_blank" rel="noopener noreferrer">{route.secondarySourceLabel} ↗</a>
          )}
          <small>Informations vérifiées le 19 juillet 2026.</small>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <span class="section-label">Calendrier conseillé</span>
        <h2>Préparer les deux adresses, pas seulement la route</h2>
        <div class="route-timeline">
          {route.planning.map(item => (
            <article><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section route-price">
      <div class="container">
        <div class="route-price__heading">
          <div><span class="section-label">Comprendre le devis</span><h2>Pourquoi le kilométrage ne suffit pas</h2></div>
          <p>Une estimation sérieuse combine le trajet et le travail nécessaire aux deux logements. Aucun tarif de cette page ne remplace un devis établi à partir d’informations complètes.</p>
        </div>
        <div class="route-price__grid">
          {route.pricingFactors.map((factor, index) => (
            <article><span>0{index + 1}</span><h3>{factor.title}</h3><p>{factor.text}</p></article>
          ))}
        </div>
        <div class="route-price__links">
          <a href="/blog/calcul-volume-demenagement-m3/">Calculer son volume en m³ →</a>
          <a href="/blog/prix-demenagement-carcassonne-scenarios/">Voir les scénarios de prix →</a>
          <a href="/tarifs/">Consulter les tarifs indicatifs →</a>
        </div>
      </div>
    </section>

    <section class="section route-faq">
      <div class="container route-faq__layout">
        <div><span class="section-label">Questions fréquentes</span><h2>Carcassonne–{route.destination}</h2></div>
        <div>{route.faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
      </div>
    </section>

    <section class="section route-related">
      <div class="container">
        <span class="section-label">Autres itinéraires</span>
        <h2>Préparer un départ depuis Carcassonne</h2>
        <div>
          {MOVING_ROUTES.filter(item => item.slug !== route.slug).map(item => (
            <a href={`/demenagement-carcassonne-${item.slug}/`}><strong>Carcassonne → {item.destination}</strong><span>{item.distance}</span></a>
          ))}
          <a href="/services/demenagement-longue-distance/"><strong>Service longue distance</strong><span>Organisation générale</span></a>
        </div>
      </div>
    </section>
  </main>

  <CTA title={`Vous préparez un départ vers ${route.destination} ?`} subtitle="Envoyez les deux adresses, le volume, les étages et la date souhaitée pour établir un devis correspondant au projet réel." btnHref={quoteHref} />
  <Footer />
</BaseLayout>

<style>
  .route-hero { background: var(--color-navy); color: white; padding: 76px 0; }
  .route-hero h1 { color: white; margin: 14px 0 18px; max-width: 900px; }
  .route-hero > .container > p:not(.route-disclaimer) { color: rgba(255,255,255,.78); max-width: 760px; font-size: 1.08rem; line-height: 1.7; }
  .route-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 34px; max-width: 970px; }
  .route-facts div { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.13); border-radius: var(--radius); padding: 18px; }
  .route-facts span { display: block; color: rgba(255,255,255,.58); font-size: .74rem; text-transform: uppercase; letter-spacing: .07em; margin-bottom: 7px; }
  .route-facts strong { color: white; font-size: .96rem; }
  .route-disclaimer { color: rgba(255,255,255,.55); font-size: .75rem; margin-top: 10px; }
  .route-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 28px; }
  .route-actions > a:last-child { color: white; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .route-overview { display: grid; grid-template-columns: .75fr 1.25fr; gap: 72px; }
  .route-overview h2 { margin-top: 12px; }
  .route-copy p { line-height: 1.78; margin-bottom: 18px; }
  .route-access { background: var(--color-bg-alt); }
  .route-access__layout { display: grid; grid-template-columns: 1fr 390px; gap: 72px; align-items: start; }
  .route-access h2 { margin: 12px 0 24px; }
  .route-access ul { display: grid; gap: 12px; list-style: none; }
  .route-access li { background: white; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 15px 18px 15px 46px; position: relative; }
  .route-access li::before { content: '✓'; position: absolute; left: 18px; color: var(--color-accent-deep); font-weight: 800; }
  .route-access aside { background: var(--color-navy); color: white; border-radius: var(--radius-lg); padding: 30px; }
  .route-access aside > span { color: var(--color-accent); text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; font-weight: 800; }
  .route-access aside h3 { color: white; margin: 12px 0; font-size: 1.35rem; }
  .route-access aside p { color: rgba(255,255,255,.74); line-height: 1.68; }
  .route-access aside a { display: block; color: white; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; margin-top: 20px; }
  .route-access aside small { display: block; color: rgba(255,255,255,.5); margin-top: 14px; }
  .route-timeline { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 34px; }
  .route-timeline article { border-top: 3px solid var(--color-accent); background: var(--color-bg-alt); padding: 24px; }
  .route-timeline article > span { color: var(--color-accent-deep); font-size: .75rem; font-weight: 800; letter-spacing: .08em; }
  .route-timeline h3 { margin: 12px 0 8px; font-size: 1.08rem; }
  .route-timeline p { color: var(--color-text-light); font-size: .9rem; line-height: 1.65; }
  .route-price { background: var(--color-navy); color: white; }
  .route-price h2 { color: white; margin-top: 12px; }
  .route-price__heading { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: end; }
  .route-price__heading > p { color: rgba(255,255,255,.7); line-height: 1.7; }
  .route-price__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 34px; }
  .route-price__grid article { border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius); padding: 23px; }
  .route-price__grid article > span { color: var(--color-accent); font-size: .72rem; font-weight: 800; }
  .route-price__grid h3 { color: white; margin: 12px 0 8px; font-size: 1.05rem; }
  .route-price__grid p { color: rgba(255,255,255,.66); line-height: 1.6; font-size: .9rem; }
  .route-price__links { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 26px; }
  .route-price__links a { color: white; text-decoration: underline; text-underline-offset: 4px; font-weight: 700; font-size: .9rem; }
  .route-faq__layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: 72px; }
  .route-faq h2 { margin-top: 12px; }
  .route-faq details { border: 1px solid var(--color-border); border-radius: var(--radius); margin-bottom: 10px; }
  .route-faq summary { cursor: pointer; padding: 18px 22px; font-weight: 700; color: var(--color-navy); }
  .route-faq details p { color: var(--color-text-light); line-height: 1.65; padding: 0 22px 20px; }
  .route-related { background: var(--color-bg-alt); }
  .route-related h2 { margin: 12px 0 26px; }
  .route-related .container > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .route-related a { display: flex; justify-content: space-between; gap: 12px; background: white; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 20px; }
  .route-related a strong { color: var(--color-navy); }
  .route-related a span { color: var(--color-text-light); font-size: .85rem; }
  @media (max-width: 900px) {
    .route-overview, .route-access__layout, .route-price__heading, .route-faq__layout { grid-template-columns: 1fr; gap: 36px; }
    .route-timeline, .route-price__grid { grid-template-columns: repeat(2, 1fr); }
    .route-related .container > div { grid-template-columns: 1fr; }
  }
  @media (max-width: 660px) {
    .route-facts, .route-timeline, .route-price__grid { grid-template-columns: 1fr; }
  }
</style>
