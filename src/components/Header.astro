---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
import { getLanguageSwitchPath } from '../data/i18n';

interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';
const home = isEnglish ? '/en/' : '/';
const quote = isEnglish ? '/en/quote/' : '/devis/';
const languageSwitch = getLanguageSwitchPath(Astro.url.pathname);

const desktopLinks = isEnglish
  ? [
      { href: '/en/removals-carcassonne/', label: 'Removals' },
      { href: '/en/small-removals-carcassonne/', label: 'Small moves' },
      { href: '/en/urgent-transport-carcassonne/', label: 'Urgent 24–48h', urgent: true },
      { href: '/en/removal-prices-carcassonne/', label: 'Prices' },
      { href: '/en/moving-to-carcassonne/', label: 'Moving guide' },
    ]
  : [
      { href: '/services/demenagement-local/', label: 'Déménagement' },
      { href: '/petit-demenagement/', label: 'Petit déménagement' },
      { href: '/transport-urgent-carcassonne/', label: 'Express 24–48 h', urgent: true },
      { href: '/tarifs/', label: 'Tarifs' },
      { href: '/outils-demenagement/', label: 'Outils' },
      { href: '/blog/', label: 'Conseils' },
    ];

const englishServices = [
  ['removals-carcassonne', 'Local removals'],
  ['small-removals-carcassonne', 'Small removals'],
  ['furniture-delivery-carcassonne', 'Furniture delivery'],
  ['long-distance-removals-france', 'Long-distance removals'],
  ['international-removals-carcassonne', 'International removals'],
  ['piano-moving-carcassonne', 'Piano and heavy items'],
] as const;
---

<nav class="site-nav">
  <div class="container nav-inner">

    <a href={home} class="logo">
      <img
        class="logo-mark"
        src="/brand/logo-mark.svg"
        width="46"
        height="46"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">
        <strong>Transport Carcassonne</strong>
        <small>{isEnglish ? 'Removals & transport' : 'Déménagement & transport'}</small>
      </span>
    </a>

    <ul class="nav-links">
      {desktopLinks.map(item => (
        <li><a href={item.href} class:list={[item.urgent && 'nav-urgent']}>{item.label}</a></li>
      ))}
    </ul>

    <div class="nav-cta">
      <a href={`tel:${SITE.phone}`} class="nav-phone">{SITE.phoneDisplay}</a>
      <a class="lang-switch" href={languageSwitch} hreflang={isEnglish ? 'fr' : 'en'} lang={isEnglish ? 'fr' : 'en'}>{isEnglish ? 'FR' : 'EN'}</a>
      <a href={`${quote}?source=navigation`} class="btn btn-primary">{isEnglish ? 'Free quote' : 'Devis gratuit'}</a>
    </div>

    <button
      class="burger"
      id="burger-btn"
      aria-label={isEnglish ? 'Open menu' : 'Ouvrir le menu'}
      data-open-label={isEnglish ? 'Open menu' : 'Ouvrir le menu'}
      data-close-label={isEnglish ? 'Close menu' : 'Fermer le menu'}
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner">

    <nav class="mobile-section">
      <p class="mobile-section-title">{isEnglish ? 'Navigation' : 'Navigation'}</p>
      <ul>
        {isEnglish ? (
          <>
            <li><a href="/en/" class="mobile-menu-link">Home</a></li>
            <li><a href="/en/urgent-transport-carcassonne/" class="mobile-menu-link">Urgent transport 24–48h</a></li>
            <li><a href="/en/furniture-delivery-carcassonne/" class="mobile-menu-link">Furniture delivery</a></li>
            <li><a href="/en/removal-prices-carcassonne/" class="mobile-menu-link">Prices</a></li>
            <li><a href="/en/how-it-works/" class="mobile-menu-link">How it works</a></li>
            <li><a href="/en/why-choose-us/" class="mobile-menu-link">Why choose us</a></li>
            <li><a href="/en/moving-to-carcassonne/" class="mobile-menu-link">Moving guide</a></li>
            <li><a href="/en/about-transport-carcassonne/" class="mobile-menu-link">About</a></li>
            <li><a href="/en/contact/" class="mobile-menu-link">Contact</a></li>
            <li><a href={languageSwitch} class="mobile-menu-link" lang="fr">Version française</a></li>
          </>
        ) : (
          <>
            <li><a href="/" class="mobile-menu-link">Accueil</a></li>
            <li><a href="/transport-urgent-carcassonne/" class="mobile-menu-link">Transport express 24–48 h</a></li>
            <li><a href="/livraison-meubles-magasins-carcassonne/" class="mobile-menu-link">Livraison depuis un magasin</a></li>
            <li><a href="/tarifs/" class="mobile-menu-link">Tarifs</a></li>
            <li><a href="/formules/" class="mobile-menu-link">Formules</a></li>
            <li><a href="/comment-ca-marche/" class="mobile-menu-link">Méthode</a></li>
            <li><a href="/realisations/" class="mobile-menu-link">Réalisations</a></li>
            <li><a href="/nos-garanties/" class="mobile-menu-link">Nos garanties</a></li>
            <li><a href="/outils-demenagement/" class="mobile-menu-link">Outils gratuits</a></li>
            <li><a href="/calculateur-volume-demenagement/" class="mobile-menu-link">Calculateur de volume</a></li>
            <li><a href="/blog/" class="mobile-menu-link">Conseils</a></li>
            <li><a href="/a-propos/" class="mobile-menu-link">À propos</a></li>
            <li><a href="/contact/" class="mobile-menu-link">Contact</a></li>
            <li><a href={languageSwitch} class="mobile-menu-link" lang="en">English version</a></li>
          </>
        )}
      </ul>
    </nav>

    <nav class="mobile-section">
      <p class="mobile-section-title">{isEnglish ? 'Our services' : 'Nos services'}</p>
      <ul>
        {isEnglish ? englishServices.map(([slug, label]) => (
          <li><a href={`/en/${slug}/`} class="mobile-menu-link">{label}</a></li>
        )) : (
          <>
            <li><a href="/petit-demenagement/" class="mobile-menu-link">Petit déménagement</a></li>
            {SERVICES.map(s => (
              <li><a href={`/services/${s.slug}/`} class="mobile-menu-link">{s.name}</a></li>
            ))}
          </>
        )}
      </ul>
    </nav>

    <nav class="mobile-section">
      <p class="mobile-section-title">{isEnglish ? 'Service area' : 'Notre zone'}</p>
      <ul>
        {CITIES.slice(0, 5).map(c => (
          <li><a href={isEnglish ? `/en/removals-${c.slug}/` : `/demenagement-${c.slug}/`} class="mobile-menu-link">{c.name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-cta">
      <a href={`tel:${SITE.phone}`} class="btn btn-primary btn-large mobile-menu-link">
        📞 {SITE.phoneDisplay}
      </a>
      <a href={`${quote}?source=menu-mobile`} class="btn btn-outline-light btn-large mobile-menu-link">
        {isEnglish ? 'Free quote' : 'Devis gratuit'}
      </a>
    </div>

  </div>
</div>

<style>
  /* ── Nav base ─────────────────────────────── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border-bottom: 1px solid var(--line-dark);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1320px;
    padding: 16px 28px;
    gap: clamp(16px, 1.8vw, 24px);
  }

  /* ── Logo ─────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-on-dark);
    flex-shrink: 0;
  }

  .logo-mark {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: block;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-text strong {
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.01em;
  }

  .logo-text small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 3px;
    font-weight: 400;
  }

  /* ── Desktop nav links ────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(13px, 1.45vw, 22px);
    flex: 1 1 auto;
    min-width: 0;
    list-style: none;
  }

  .nav-links li {
    flex: 0 0 auto;
  }

  .nav-links a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.2;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent);
  }
  .nav-links .nav-urgent { color: var(--accent); font-weight: 700; }

  /* ── Desktop CTA ──────────────────────────── */
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-phone {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-phone:hover {
    color: var(--accent);
  }
  .lang-switch {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    border: 1px solid var(--line-dark);
    border-radius: 5px;
    transition: color .2s, border-color .2s, background .2s;
  }
  .lang-switch:hover { color: var(--text-on-dark); border-color: var(--accent); background: rgba(168, 112, 63, .1); }

  /* ── Buttons (locally scoped — премиум-стиль ─ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-dark);
    border-color: var(--accent);
  }
  .btn-primary:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: var(--text-on-dark);
  }

  .btn-outline-light {
    background: transparent;
    color: var(--text-on-dark);
    border-color: var(--text-on-dark);
  }
  .btn-outline-light:hover {
    background: var(--text-on-dark);
    color: var(--bg-dark);
  }

  .btn-large {
    padding: 14px 22px;
    font-size: 15px;
  }

  /* ── Burger button ────────────────────────── */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--line-dark);
    border-radius: 4px;
    cursor: pointer;
    padding: 0;
  }

  .burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text-on-dark);
    border-radius: 2px;
    transition: transform 0.28s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .burger.is-active span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .burger.is-active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .burger.is-active span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ── Mobile menu overlay ──────────────────── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-dark);
    z-index: 99;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu-inner {
    padding-top: 32px;
    padding-bottom: 48px;
    padding-left: max(24px, env(safe-area-inset-left));
    padding-right: max(24px, env(safe-area-inset-right));
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* ── Mobile sections ──────────────────────── */
  .mobile-section-title {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 14px;
  }

  .mobile-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .mobile-section ul a {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    font-weight: 400;
    padding: 12px 0;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
    transition: color 0.2s;
  }

  .mobile-section ul a:hover,
  .mobile-section ul a:active {
    color: var(--accent);
  }

  /* ── Mobile CTA ───────────────────────────── */
  .mobile-cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding-top: 8px;
  }

  .mobile-cta .btn {
    justify-content: center;
    text-align: center;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 1180px) {
    .nav-links {
      display: none;
    }

    .nav-cta {
      margin-left: auto;
    }

    .logo-text small {
      display: none;
    }

    .burger {
      display: flex;
    }

    .mobile-menu {
      display: block;
      top: 64px;
    }

    .nav-inner {
      padding-top: 14px;
      padding-bottom: 14px;
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
      gap: 12px;
    }

    .logo-mark {
      width: 34px;
      height: 34px;
    }

    .logo-text strong {
      font-size: 14px;
    }
  }

  @media (max-width: 600px) {
    .nav-cta .btn {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-phone {
      display: none;
    }

    .nav-inner {
      padding-left: max(16px, env(safe-area-inset-left));
      padding-right: max(16px, env(safe-area-inset-right));
    }
  }
</style>

<script>
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    mobileMenu?.classList.add('is-open');
    burgerBtn?.classList.add('is-active');
    burgerBtn?.setAttribute('aria-expanded', 'true');
    burgerBtn?.setAttribute('aria-label', burgerBtn?.dataset.closeLabel || 'Fermer le menu');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.remove('is-open');
    burgerBtn?.classList.remove('is-active');
    burgerBtn?.setAttribute('aria-expanded', 'false');
    burgerBtn?.setAttribute('aria-label', burgerBtn?.dataset.openLabel || 'Ouvrir le menu');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  burgerBtn?.addEventListener('click', () => {
    mobileMenu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  document.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
