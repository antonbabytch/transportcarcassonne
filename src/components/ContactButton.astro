---
import { SITE } from '../data/site.config';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const en = lang === 'en';
---

<details class="contact-fab" data-contact-fab>
  <summary class="contact-fab__toggle" aria-label={en ? 'Contact options' : 'Choisir un moyen de contact'} aria-controls="contact-fab-options">
    <svg class="contact-fab__phone" viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1z" />
    </svg>
    <svg class="contact-fab__close" viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
  </summary>
  <div class="contact-fab__panel" id="contact-fab-options">
    <p class="contact-fab__title">{en ? 'How can we help?' : 'Comment nous contacter ?'}</p>
    <a href={`tel:${SITE.phone}`} class="contact-fab__option" data-source="contact-menu-phone">
      <span class="contact-fab__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a14 14 0 0 1-6-6l2-2z"/></svg></span>
      <span><strong>{en ? 'Call by phone' : 'Appeler par téléphone'}</strong><small>{SITE.phoneDisplay}</small></span>
    </a>
    <a href={`https://wa.me/${SITE.phoneWhatsapp}`} class="contact-fab__option" data-source="contact-menu-whatsapp" target="_blank" rel="noopener noreferrer">
      <span class="contact-fab__icon contact-fab__icon--wa" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 21l2-5.5a8.5 8.5 0 1 1 16-4z"/><path d="M8.5 8.5c.4 3.3 3.1 6 6.5 6.5l1-2-2-1-1 1-2-2 1-1-1-2z"/></svg>
      </span>
      <span><strong>WhatsApp</strong><small>{en ? 'Open WhatsApp' : 'Ouvrir WhatsApp'}</small></span>
    </a>
    <p class="contact-fab__note">{en ? 'By appointment · 7 days a week' : 'Sur rendez-vous · 7j/7'}</p>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-contact-fab]').forEach((contact) => {
    const toggle = contact.querySelector<HTMLElement>('summary');
    document.addEventListener('pointerdown', (event) => {
      if (contact.open && event.target instanceof Node && !contact.contains(event.target)) contact.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !contact.open) return;
      contact.open = false;
      toggle?.focus();
    });
    contact.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !contact.contains(event.relatedTarget)) contact.open = false;
    });
    contact.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { contact.open = false; }));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) contact.open = false;
    });
  });
</script>

<style>
  .contact-fab { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: calc(24px + env(safe-area-inset-bottom, 0px)); z-index: 960; }
  .contact-fab__toggle { width: 58px; height: 58px; display: grid; place-items: center; cursor: pointer; list-style: none; border-radius: 50%; background: var(--accent); color: #15100a; border: 1px solid rgba(21, 25, 28, .12); box-shadow: 0 8px 28px rgba(21, 25, 28, .25); -webkit-tap-highlight-color: transparent; transition: background .2s, transform .2s; }
  .contact-fab__toggle::-webkit-details-marker { display: none; }
  .contact-fab__toggle::marker { content: ''; }
  .contact-fab__toggle:hover { background: #c58d59; }
  .contact-fab__toggle:focus-visible { outline: 3px solid var(--text); outline-offset: 4px; }
  .contact-fab__close { display: none; }
  .contact-fab[open] .contact-fab__phone { display: none; }
  .contact-fab[open] .contact-fab__close { display: block; }
  .contact-fab__panel { position: absolute; bottom: 72px; right: 0; width: min(290px, calc(100vw - 40px)); padding: 18px; border-radius: 16px; background: var(--bg-card); color: var(--text); border: 1px solid var(--line); box-shadow: 0 16px 48px rgba(21, 25, 28, .22); }
  .contact-fab__title { font-size: .92rem; font-weight: 600; margin: 0 0 12px; }
  .contact-fab__option { display: flex; align-items: center; gap: 12px; padding: 12px 8px; border-radius: 8px; min-height: 66px; }
  .contact-fab__option + .contact-fab__option { border-top: 1px solid var(--line); }
  .contact-fab__option:hover, .contact-fab__option:focus-visible { background: var(--bg-soft); }
  .contact-fab__option:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 2px; }
  .contact-fab__option strong, .contact-fab__option small { display: block; }
  .contact-fab__option strong { font-size: .87rem; font-weight: 600; }
  .contact-fab__option small { color: var(--text-muted); font-size: .78rem; margin-top: 2px; }
  .contact-fab__icon { width: 36px; height: 36px; flex: 0 0 36px; display: grid; place-items: center; border-radius: 50%; color: var(--accent-deep); background: var(--bg-soft); }
  .contact-fab__icon--wa { color: #146638; background: #e8f5ec; }
  .contact-fab__note { color: var(--text-muted); font-size: .7rem; margin: 12px 0 0; }
  @media (max-width: 1023px) { :global(body:has(.contact-fab[open]) .urgent-prompt) { visibility: hidden; } }
  @media (min-width: 1024px) { .contact-fab { display: none; } }
</style>
