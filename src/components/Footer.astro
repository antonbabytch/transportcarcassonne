---
import { SITE } from '../data/site.config';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand reveal" data-i="0">
        <a href="/" class="logo">
          <span class="logo-mark"></span>
          <span class="logo-text">
            <strong>Transport Carcassonne</strong>
            <small>Déménagement &amp; transport</small>
          </span>
        </a>
        <p>
          Spécialiste du déménagement et du transport à Carcassonne et dans
          l'Aude. SIRET {SITE.siret}. Entreprise déclarée et assurée.
        </p>
        <p class="sister-site">
          Besoin d'un débarras ou d'un vide maison&nbsp;? Voir notre activité
          <a href="https://debarras-carcassonne.fr/" rel="noopener">
            Débarras Carcassonne
          </a>
          — un artisan local, deux expertises.
        </p>
      </div>

      <div class="reveal" data-i="1">
        <h4>Services</h4>
        <ul>
          <li><a href="/petit-demenagement">Petit déménagement</a></li>
          {SERVICES.map(s => (
            <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
          ))}
          <li><a href="/tarifs">Nos tarifs</a></li>
        </ul>
      </div>

      <div class="reveal" data-i="2">
        <h4>Zone</h4>
        <ul>
          {CITIES.slice(0, 6).map(c => (
            <li><a href={`/demenagement-${c.slug}`}>{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="reveal" data-i="3">
        <h4>Contact</h4>
        <ul>
          <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li>
            <a
              href={`https://wa.me/${SITE.phoneWhatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
            >WhatsApp</a>
          </li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>{SITE.hours}</li>
          <li>{SITE.hq.city}, {SITE.hq.region} ({SITE.hq.postalCode})</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© {new Date().getFullYear()} {SITE.name} · SIRET {SITE.siret}</div>
      <div class="footer-legal">
        <a href="/mentions-legales">Mentions légales</a>
        <span>·</span>
        <a href="/politique-confidentialite">Politique de confidentialité</a>
        <span>·</span>
        <button type="button" class="footer-cookie" onclick="window.__ccManage&&window.__ccManage()">Gérer les cookies</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    padding: 64px 0 32px;
    border-top: 1px solid var(--line-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .footer-brand .logo-mark {
    width: 38px;
    height: 38px;
    background: var(--accent);
    border-radius: 4px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Instrument Serif', serif;
    color: var(--bg-dark);
    font-size: 22px;
    font-weight: 400;
  }

  .footer-brand .logo-mark::after {
    content: 'AB';
  }

  .footer-brand .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-brand .logo-text strong {
    font-weight: 500;
    font-size: 16px;
  }

  .footer-brand .logo-text small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .footer-brand p {
    color: var(--text-on-dark-muted);
    font-size: 14px;
    line-height: 1.65;
    max-width: 340px;
  }

  .footer-brand .sister-site {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
  }

  .footer-brand .sister-site a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-brand .sister-site a:hover {
    color: var(--text-on-dark);
  }

  h4 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 22px;
    font-weight: 500;
  }

  ul {
    list-style: none;
  }

  li {
    margin-bottom: 11px;
  }

  a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--line-dark);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--text-on-dark-muted);
    font-size: 13px;
  }

  .footer-bottom a {
    color: var(--text-on-dark-muted);
  }

  .footer-legal {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-cookie {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 13px;
    color: var(--text-on-dark-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-cookie:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
